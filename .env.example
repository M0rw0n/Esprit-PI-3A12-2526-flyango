# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox  # or 'live'

# SendGrid API Key
SENDGRID_API_KEY=your_sendgrid_api_key

# QR Code Monkey API Key
QRCODE_MONKEY_API_KEY=your_qrcode_monkey_api_key

# PDF Monkey API Key (optional - uses HTML fallback)
PDF_MONKEY_API_KEY=your_pdfmonkey_api_key