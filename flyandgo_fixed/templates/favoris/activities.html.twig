{% extends 'base/base.html.twig' %}

{% block title %}Activités favorites — Fly&Go{% endblock %}

{% block body %}
<div style="max-width:1280px;margin:0 auto;padding:2rem">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem">
        <div>
            <h1 style="font-size:1.8rem;font-weight:900"><i class="fa fa-heart" style="color:var(--red)"></i> Activités favorites</h1>
            <p style="color:var(--muted)">Activités sauvegardées</p>
        </div>
        <div style="display:flex;gap:.75rem">
            <a href="{{ path('user_dashboard') }}" class="btn btn-outline"><i class="fa fa-home"></i> Mon espace</a>
            <a href="{{ path('activity_index') }}" class="btn btn-gold"><i class="fa fa-search"></i> Explorer</a>
        </div>
    </div>

    <div class="favorites-tabs" style="margin-bottom:1.5rem;display:flex;gap:.5rem;flex-wrap:wrap">
        <a href="{{ path('favoris_hebergements') }}" class="tab"><i class="fa fa-hotel"></i> Hébergements</a>
        <a href="{{ path('favoris_circuits') }}" class="tab"><i class="fa fa-route"></i> Circuits</a>
        <a href="{{ path('favoris_activities') }}" class="tab active"><i class="fa fa-hiking"></i> Activités</a>
        <a href="{{ path('favoris_transports') }}" class="tab"><i class="fa fa-plane"></i> Transport</a>
        <a href="{{ path('favoris_posts') }}" class="tab"><i class="fa fa-comments"></i> Posts</a>
    </div>

    {% if favorites is empty %}
        <div class="empty-state" style="padding:4rem 2rem;text-align:center;background:var(--card-bg);border-radius:16px">
            <i class="fa fa-heart-broken" style="font-size:3rem;color:var(--muted)"></i>
            <h3 style="margin:1rem 0 .5rem">Aucune activité favorite</h3>
            <p style="color:var(--muted);margin-bottom:1.5rem">Ajoutez des activités à vos favoris pour les retrouver ici.</p>
            <a href="{{ path('activity_index') }}" class="btn btn-gold"><i class="fa fa-search"></i> Explorer les activités</a>
        </div>
    {% else %}
        <div class="acard-wrap">
            <div class="acard-wrap__head">
                <span class="acard-wrap__title"><i class="fa fa-hiking"></i> Activités ({{ favorites.totalItemCount }})</span>
            </div>
            <div class="bookings-list">
                {% for fav in favorites %}
                    {% set a = fav.activity %}
                    <div class="booking-card">
                        <div class="booking-card__av" style="background:linear-gradient(135deg,#4facfe,#00f2fe)">
                            <i class="fa fa-hiking"></i>
                        </div>
                        <div class="booking-card__info">
                            <div class="booking-card__name">{{ a.title }}</div>
                            <div class="booking-card__meta">
                                <span><i class="fa fa-map-marker-alt"></i> {{ a.lieu }}</span>
                                {% if a.duration %}<span><i class="fa fa-clock"></i> {{ a.duration }}</span>{% endif %}
                            </div>
                            <div style="font-size:1.1rem;font-weight:700;color:var(--navy);margin-top:.5rem">
                                {{ a.price|number_format(3) }} <small>TND</small> <small style="font-weight:400;color:var(--muted)">/personne</small>
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:.5rem">
                            <a href="{{ path('activity_show', {id: a.id}) }}" class="btn btn-navy btn-sm"><i class="fa fa-eye"></i> Voir</a>
                            <button class="btn btn-red btn-sm" onclick="toggleFavorite({{ a.id }}, 'activity', this)" title="Retirer des favoris">
                                <i class="fa fa-heart"></i> Retirer
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% if favorites.pageCount|default(1) > 1 %}
            <div style="padding:1rem;text-align:center">
                {% for page in 1..favorites.pageCount %}
                    <a href="{{ path('favoris_activities', {page: page}) }}" class="btn {{ page == favorites.currentPageNumber ? 'btn-navy' : 'btn-outline' }} btn-sm" style="margin:0 .2rem">{{ page }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}