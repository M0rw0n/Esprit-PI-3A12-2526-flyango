{% extends 'base/base.html.twig' %}
{% block title %}Classement - AI Travel Puzzle{% endblock %}

{% block body %}
<style>
    :root {
        --navy: #1B3A6B;
        --gold: #FFD700;
        --primary: #00B4D8;
        --success: #10B981;
        --bg: #F8FAFC;
        --text: #1E293B;
        --text-secondary: #64748B;
    }

    * { box-sizing: border-box; }

    body {
        font-family: 'Outfit', system-ui, sans-serif;
        background: linear-gradient(135deg, var(--bg) 0%, #E2E8F0 100%);
        min-height: 100vh;
        margin: 0;
        padding: 2rem 1rem;
        color: var(--text);
    }

    .leaderboard {
        max-width: 500px;
        margin: 0 auto;
    }

    .header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .header h1 {
        font-size: 2.5rem;
        margin: 0 0 0.5rem;
    }

    .header h1 span {
        background: linear-gradient(135deg, var(--gold), #FFA500);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .podium {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .podium-item {
        text-align: center;
        padding: 1rem;
        border-radius: 16px;
        width: 120px;
        background: white;
        box-shadow: 0 4px 15px rgba(27,58,107,0.1);
    }

    .podium-item.first {
        padding: 1.5rem 1rem;
        background: linear-gradient(135deg, var(--gold), #FFA500);
        color: var(--navy);
    }

    .podium-item.second {
        background: linear-gradient(135deg, #94a3b8, #cbd5e1);
        color: var(--navy);
    }

    .podium-item.third {
        background: linear-gradient(135deg, #cd7f32, #b87333);
        color: white;
    }

    .podium-rank {
        font-size: 2rem;
        font-weight: 800;
    }

    .podium-avatar {
        font-size: 3rem;
        margin: 0.5rem 0;
    }

    .podium-name {
        font-weight: 700;
        font-size: 0.9rem;
    }

    .podium-score {
        font-size: 1.2rem;
        font-weight: 800;
    }

    .players-list {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(27,58,107,0.1);
    }

    .player-row {
        display: flex;
        align-items: center;
        padding: 1rem;
        border-bottom: 1px solid #E2E8F0;
        gap: 1rem;
    }

    .player-row:last-child {
        border-bottom: none;
    }

    .player-rank {
        font-size: 1.2rem;
        font-weight: 700;
        width: 40px;
        text-align: center;
        color: var(--navy);
    }

    .player-rank.gold { color: #f59e0b; }
    .player-rank.silver { color: #94a3b8; }
    .player-rank.bronze { color: #cd7f32; }

    .player-avatar {
        font-size: 2rem;
    }

    .player-info {
        flex: 1;
    }

    .player-name {
        font-weight: 600;
    }

    .player-country {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .player-score {
        font-weight: 700;
        color: var(--gold);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--navy);
        text-decoration: none;
        margin-top: 2rem;
        font-weight: 600;
    }

    .back-link:hover {
        color: var(--gold);
    }
</style>

<div class="leaderboard">
    <a href="{{ path('ai_puzzle_index') }}" class="back-link">← Retour au jeu</a>
    
    <div class="header">
        <h1>🏆 Classement</h1>
    </div>

    <div class="podium">
        <div class="podium-item second">
            <div class="podium-rank">2</div>
            <div class="podium-avatar">🥈</div>
            <div class="podium-name">Marie</div>
            <div class="podium-score">2,450 pts</div>
        </div>
        <div class="podium-item first">
            <div class="podium-rank">1</div>
            <div class="podium-avatar">👑</div>
            <div class="podium-name">Pierre</div>
            <div class="podium-score">3,120 pts</div>
        </div>
        <div class="podium-item third">
            <div class="podium-rank">3</div>
            <div class="podium-avatar">🥉</div>
            <div class="podium-name">Lucas</div>
            <div class="podium-score">2,180 pts</div>
        </div>
    </div>

    <div class="players-list">
        <div class="player-row">
            <div class="player-rank">4</div>
            <div class="player-avatar">🎮</div>
            <div class="player-info">
                <div class="player-name">Sophie</div>
                <div class="player-country">France</div>
            </div>
            <div class="player-score">1,950 pts</div>
        </div>
        <div class="player-row">
            <div class="player-rank">5</div>
            <div class="player-avatar">🌟</div>
            <div class="player-info">
                <div class="player-name">Ahmed</div>
                <div class="player-country">Maroc</div>
            </div>
            <div class="player-score">1,820 pts</div>
        </div>
        <div class="player-row">
            <div class="player-rank">6</div>
            <div class="player-avatar">🎯</div>
            <div class="player-info">
                <div class="player-name">Yuki</div>
                <div class="player-country">Japon</div>
            </div>
            <div class="player-score">1,650 pts</div>
        </div>
        <div class="player-row">
            <div class="player-rank">7</div>
            <div class="player-avatar">🏅</div>
            <div class="player-info">
                <div class="player-name">Carlos</div>
                <div class="player-country">Brésil</div>
            </div>
            <div class="player-score">1,520 pts</div>
        </div>
        <div class="player-row">
            <div class="player-rank">8</div>
            <div class="player-avatar">🚀</div>
            <div class="player-info">
                <div class="player-name">Emma</div>
                <div class="player-country">USA</div>
            </div>
            <div class="player-score">1,410 pts</div>
        </div>
    </div>
</div>
{% endblock %}