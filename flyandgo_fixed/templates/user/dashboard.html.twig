{% extends 'base/base.html.twig' %}
{% block title %}Mon espace — Fly&Go{% endblock %}
{% block body %}
<div style="max-width:1280px;margin:0 auto;padding:2rem">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem">
        <div>
            <h1 style="font-size:1.8rem;font-weight:900">Bonjour {{ app.user.prenom }} 👋</h1>
            <p style="color:var(--muted)">Retrouvez vos réservations, vos avis et vos circuits personnalisés.</p>
        </div>
        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
            <a href="{{ path('user_profile') }}" class="btn btn-outline"><i class="fa fa-user"></i> Mon profil</a>
            <a href="{{ path('user_reservations') }}" class="btn btn-outline">Mes réservations</a>
            <a href="{{ path('user_avis') }}" class="btn btn-outline">Mes avis</a>
            <a href="{{ path('user_profil_voyageur') }}" class="btn btn-outline"><i class="fa fa-suitcase-rolling"></i> Profil voyageur</a>
            <button type="button" onclick="document.getElementById('travelAdviceModal').style.display='flex'" class="btn btn-outline" style="border-color:var(--gold);color:var(--gold)"><i class="fa fa-suitcase"></i> Conseils voyage</button>
            <a href="{{ path('user_circuits') }}" class="btn btn-gold">Mes circuits</a>
        </div>
    </div>
    <div class="kpis" style="margin-bottom:2rem">
        <div class="kpi kpi--navy"><div class="kpi__label">Réservations</div><div class="kpi__val">{{ reservationsCount }}</div></div>
        <div class="kpi kpi--gold"><div class="kpi__label">Avis publiés</div><div class="kpi__val">{{ avisCount }}</div></div>
        <div class="kpi kpi--green"><div class="kpi__label">Circuits personnalisés</div><div class="kpi__val">{{ circuitsCount }}</div></div>
    </div>
    <div class="admin-grid">
        <div class="acard-wrap">
            <div class="acard-wrap__head"><span class="acard-wrap__title"><i class="fa fa-calendar-check"></i> Dernières réservations</span></div>
            <div class="bookings-list">
                {% for item in latestReservations %}
                    <div class="booking-card">
                        <div class="booking-card__av">{{ loop.index }}</div>
                        <div class="booking-card__info">
                            <div class="booking-card__name">
                                {% if attribute(item, 'hebergement') is defined %}{{ item.hebergement.nom }}{% elseif attribute(item, 'activity') is defined %}{{ item.activity.title }}{% else %}{{ item.circuit.titre }}{% endif %}
                            </div>
                            <div class="booking-card__meta">
                                <span>{{ attribute(item, 'createdAt')|date('d/m/Y H:i') }}</span>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="empty" style="padding:2rem"><i class="fa fa-calendar"></i><p>Aucune réservation.</p></div>
                {% endfor %}
            </div>
        </div>
        <div class="acard-wrap">
            <div class="acard-wrap__head"><span class="acard-wrap__title"><i class="fa fa-star"></i> Derniers avis</span></div>
            <div class="bookings-list">
                {% for item in latestAvis %}
                    <div class="booking-card">
                        <div class="booking-card__av">★</div>
                        <div class="booking-card__info">
                            <div class="booking-card__name">{{ attribute(item, 'author') is defined ? attribute(item, 'author') : attribute(item, 'auteur') }}</div>
                            <div class="booking-card__meta"><span>{{ attribute(item, 'createdAt')|date('d/m/Y') }}</span></div>
                        </div>
                    </div>
                {% else %}
                    <div class="empty" style="padding:2rem"><i class="fa fa-star"></i><p>Aucun avis.</p></div>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="acard-wrap" style="margin-top:2rem">
        <div class="acard-wrap__head"><span class="acard-wrap__title"><i class="fa fa-route"></i> Mes derniers circuits</span></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;padding:1rem 1.25rem 1.5rem">
            {% for c in circuits %}
                <a href="{{ path('circuit_show', {id: c.id}) }}" style="text-decoration:none;color:inherit;border:1px solid var(--border);border-radius:16px;padding:1rem;background:#fff">
                    <div style="display:flex;justify-content:space-between;gap:.5rem;align-items:center;margin-bottom:.6rem"><strong>{{ c.titre }}</strong><span class="tag">{{ c.duree }}</span></div>
                    <div style="font-size:.85rem;color:var(--muted)">{{ c.depart }} → {{ c.destination }}</div>
                </a>
            {% else %}
                <div class="empty" style="grid-column:1/-1;padding:2rem"><i class="fa fa-brain"></i><p>Pas encore de circuit personnalisé.</p><a href="{{ path('circuit_ai_create') }}" class="btn btn-navy">Créer</a></div>
            {% endfor %}
        </div>
    </div>
</div>

{# Travel Advice Modal #}
<div id="travelAdviceModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:16px;padding:2rem;max-width:500px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.3);max-height:90vh;overflow-y:auto">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
            <h3 style="margin:0;font-size:1.2rem;color:var(--navy)"><i class="fa fa-suitcase"></i> Conseils pour votre séjour</h3>
            <button type="button" onclick="closeTravelAdviceModal()" style="background:none;border:none;font-size:1.5rem;cursor:pointer;color:var(--muted)">&times;</button>
        </div>
        <div style="margin-bottom:1rem">
            <label style="display:block;font-size:.85rem;font-weight:600;margin-bottom:.5rem;color:var(--text)">Hébergement</label>
            <input type="text" id="adviceHotel" placeholder="Nom de l'hôtel ou hébergement" style="width:100%;padding:.75rem;border:1px solid var(--border);border-radius:8px;font-size:.95rem">
        </div>
        <div style="display:flex;gap:1rem;margin-bottom:1rem">
            <div style="flex:1">
                <label style="display:block;font-size:.85rem;font-weight:600;margin-bottom:.5rem;color:var(--text)">Ville</label>
                <input type="text" id="adviceCity" placeholder="Ex. Hammamet" style="width:100%;padding:.75rem;border:1px solid var(--border);border-radius:8px;font-size:.95rem">
            </div>
            <div style="flex:1">
                <label style="display:block;font-size:.85rem;font-weight:600;margin-bottom:.5rem;color:var(--text)">Pays</label>
                <select id="adviceCountry" style="width:100%;padding:.75rem;border:1px solid var(--border);border-radius:8px;font-size:.95rem;background:#fff">
                    <option value="Tunisie">Tunisie</option>
                    <option value="France">France</option>
                    <option value="Maroc">Maroc</option>
                    <option value="Égypte">Égypte</option>
                    <option value="Espagne">Espagne</option>
                    <option value="Italie">Italie</option>
                    <option value="Grèce">Grèce</option>
                    <option value="Portugal">Portugal</option>
                </select>
            </div>
        </div>
        <button type="button" id="adviceSubmitBtn" onclick="getTravelAdvice()" style="width:100%;padding:.85rem;background:var(--gold-d);color:#fff;border:none;border-radius:8px;font-size:1rem;font-weight:600;cursor:pointer">
            <i class="fa fa-paper-plane"></i> Obtenir les conseils
        </button>
        <div id="adviceResult" style="margin-top:1.5rem;display:none"></div>
    </div>
</div>

<script>
const adviceModal = document.getElementById('travelAdviceModal');
const adviceResult = document.getElementById('adviceResult');
const submitBtn = document.getElementById('adviceSubmitBtn');

window.openTravelAdviceModal = function() {
    adviceModal.style.display = 'flex';
    document.getElementById('adviceHotel').focus();
};

window.closeTravelAdviceModal = function() {
    adviceModal.style.display = 'none';
    adviceResult.style.display = 'none';
    adviceResult.innerHTML = '';
};

async function getTravelAdvice() {
    const hotel = document.getElementById('adviceHotel').value.trim();
    const ville = document.getElementById('adviceCity').value.trim();
    const pays = document.getElementById('adviceCountry').value;
    
    if (!hotel) {
        alert('Veuillez entrer le nom de l\'hébergement');
        return;
    }
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Chargement...';
    
    try {
        const response = await fetch('{{ path("chatbot_hotel_advice") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
                hotel: hotel,
                ville: ville,
                pays: pays,
                type: 'hôtel'
            }).toString()
        });
        
        const data = await response.json();
        console.log('Response:', data);
        
        const data = await response.json();
        
        if (data.success) {
            let html = '<div style="background:linear-gradient(135deg,#fef3c7,#fde68a);border-radius:12px;padding:1.25rem">';
            html += '<h4 style="margin:0 0 .75rem;font-size:.95rem;color:#92400e"><i class="fa fa-lightbulb"></i> Conseils pour ' + escapeHtml(data.hotel) + (data.city ? ', ' + escapeHtml(data.city) : '') + '</h4>';
            html += '<p style="font-size:.8rem;color:#78350f;margin-bottom:.75rem">Saison: ' + escapeHtml(data.season) + '</p>';
            html += '<ul style="margin:0;padding-left:1.25rem;color:#78350f;font-size:.9rem;line-height:1.6">';
            data.advice.forEach(function(item) {
                html += '<li style="margin-bottom:.5rem">' + escapeHtml(item) + '</li>';
            });
            html += '</ul></div>';
            
            adviceResult.innerHTML = html;
            adviceResult.style.display = 'block';
        } else if (data.retry && retryCount < 3) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fa fa-paper-plane"></i> Réessayer...';
            await new Promise(r => setTimeout(r, 3000 * (retryCount + 1)));
            getTravelAdvice(retryCount + 1);
            return;
        } else if (data.retry) {
            let html = '<div style="background:#fef2f2;border-radius:12px;padding:1.25rem;text-align:center">';
            html += '<p style="color:var(--red);margin-bottom:.5rem">' + escapeHtml(data.message) + '</p>';
            html += '<p style="color:var(--muted);font-size:.85rem">Vous pouvez aussi me donner plus de détails sur l\'hébergement.</p></div>';
            adviceResult.innerHTML = html;
            adviceResult.style.display = 'block';
        } else {
            alert(data.message || 'Erreur lors de la génération des conseils');
        }
    } catch (e) {
        console.error('Error:', e);
        alert('Erreur: ' + e.message);
    }
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<i class="fa fa-paper-plane"></i> Obtenir les conseils';
}

async function testApi() {
    try {
        const response = await fetch('{{ path("chatbot_test_api") }}');
        const data = await response.json();
        console.log('API Test:', data);
        alert('Service existe: ' + data.service_exists + '\nEnabled: ' + data.is_enabled + '\nAPI Key: ' + data.api_key_prefix + '...');
    } catch(e) {
        alert('Erreur test: ' + e.message);
    }
}

function escapeHtml(text) {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

if (adviceModal) {
    adviceModal.addEventListener('click', function(e) {
        if (e.target === adviceModal) closeTravelAdviceModal();
    });
}
</script>
{% endblock %}
