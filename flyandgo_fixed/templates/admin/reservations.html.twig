{% extends 'admin/layout.html.twig' %}
{% block title %}Réservations hébergements — Admin{% endblock %}
{% block breadcrumb %}Réservations hébergements{% endblock %}
{% block admin_body %}
{% set q = app.request.query.get('q', '') %}
{% set statut = app.request.query.get('statut', '') %}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
    <div>
        <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:.2rem">Réservations hébergements</h2>
        <p style="color:var(--muted);font-size:.85rem">{{ reservations.totalItemCount }} réservations</p>
    </div>
</div>

<div class="admin-toolbar">
    <form method="GET" action="{{ path('admin_reservations') }}" id="filterForm">
        <div class="admin-toolbar__row">
            <div class="admin-toolbar__search">
                <i class="fa fa-search"></i>
                <input type="text" name="q" value="{{ q }}" placeholder="Client, hébergement..." data-auto-submit>
            </div>
            <div class="admin-toolbar__select">
                <select name="statut" data-auto-submit>
                    <option value="">Tous statuts</option>
                    <option value="EN_ATTENTE" {{ statut == 'EN_ATTENTE' ? 'selected' : '' }}>En attente</option>
                    <option value="CONFIRMEE" {{ statut == 'CONFIRMEE' ? 'selected' : '' }}>Confirmées</option>
                    <option value="ANNULEE" {{ statut == 'ANNULEE' ? 'selected' : '' }}>Annulées</option>
                </select>
            </div>
            <select name="tri" class="admin-toolbar__sort" data-auto-submit>
                <option value="recent" {{ tri|default('recent') == 'recent' ? 'selected' : '' }}>Plus récentes</option>
                <option value="oldest" {{ tri|default('recent') == 'oldest' ? 'selected' : '' }}>Plus anciennes</option>
            </select>
            {% if q or statut %}
            <a href="{{ path('admin_reservations') }}" class="btn btn-outline btn-sm"><i class="fa fa-times"></i></a>
            {% endif %}
        </div>
    </form>
</div>

<div class="acard-wrap">
    <div class="bookings-list">
        {% for r in reservations %}
        <div class="booking-card">
            <div class="booking-card__av">{{ r.nomClient|slice(0,1)|upper }}</div>
            <div class="booking-card__info">
                <div class="booking-card__name">{{ r.nomClient }}</div>
                <div class="booking-card__meta">
                    <span><i class="fa fa-hotel fa-xs"></i> {{ r.hebergement.nom }}</span>
                    <span><i class="fa fa-calendar fa-xs"></i> {{ r.dateDebut|date('d/m') }} → {{ r.dateFin|date('d/m/Y') }}</span>
                    <span><i class="fa fa-users fa-xs"></i> {{ r.nombrePersonnes }} pers.</span>
                    <span><i class="fa fa-envelope fa-xs"></i> {{ r.emailClient }}</span>
                </div>
            </div>
            <div class="booking-card__price">
                <strong>{{ r.montantTotal|number_format(3, ',', ' ') }}</strong><span>TND</span>
            </div>
            <span class="status status--{{ r.statut == 'CONFIRMEE' ? 'confirmed' : (r.statut == 'EN_ATTENTE' ? 'pending' : 'cancelled') }}">
                {{ r.statut == 'CONFIRMEE' ? 'Confirmée' : (r.statut == 'EN_ATTENTE' ? 'En attente' : 'Annulée') }}
            </span>
            <div class="booking-card__actions">
                {% if r.statut == 'EN_ATTENTE' %}
                <button onclick="changeStatut({{ r.id }}, 'CONFIRMEE')" class="btn btn-green btn-sm" title="Confirmer"><i class="fa fa-check"></i></button>
                <button onclick="changeStatut({{ r.id }}, 'ANNULEE')" class="btn btn-red btn-sm" title="Annuler"><i class="fa fa-times"></i></button>
                {% endif %}
                <form action="{{ path('admin_reservation_delete', {id: r.id}) }}" method="POST" onsubmit="return confirm('Supprimer ?')">
                    <button type="submit" class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button>
                </form>
            </div>
        </div>
        {% else %}
        <div class="empty" style="padding:3rem"><i class="fa fa-calendar"></i><h3>Aucune réservation</h3></div>
        {% endfor %}
    </div>
</div>

{% if reservations.totalItemCount > reservations.itemNumberPerPage %}
<div class="admin-pagination">
    <div class="admin-pagination__info">
        {{ (reservations.currentPageNumber - 1) * reservations.itemNumberPerPage + 1 }} - {{ min(reservations.currentPageNumber * reservations.itemNumberPerPage, reservations.totalItemCount) }} sur {{ reservations.totalItemCount }}
    </div>
    <div class="admin-pagination__pages">
        {% if reservations.currentPageNumber > 1 %}
        <a href="{{ path('admin_reservations', {page: reservations.currentPageNumber - 1, q: q, statut: statut, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-left"></i></a>
        {% endif %}
        {% for page in reservations.paginationData.pagesInRange %}
            {% if page == reservations.currentPageNumber %}
                <span class="admin-pagination__current">{{ page }}</span>
            {% else %}
                <a href="{{ path('admin_reservations', {page: page, q: q, statut: statut, tri: tri|default('recent')}) }}" class="admin-pagination__btn">{{ page }}</a>
            {% endif %}
        {% endfor %}
        {% if reservations.currentPageNumber < reservations.pageCount %}
        <a href="{{ path('admin_reservations', {page: reservations.currentPageNumber + 1, q: q, statut: statut, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-right"></i></a>
        {% endif %}
    </div>
</div>
{% endif %}
{% endblock %}
{% block javascripts %}
<script>
function changeStatut(id, statut) {
    if(!confirm('Changer le statut ?')) return;
    $.post('{{ path("admin_reservation_statut", {"id": "__ID__"}) }}'.replace('__ID__', id), {statut})
     .done(()=>{ showToast('✅ Statut mis à jour !'); setTimeout(()=>location.reload(),900); })
     .fail(()=>showToast('Erreur','error'));
}
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
        filterForm.querySelectorAll('[data-auto-submit]').forEach(el => {
            let timeout;
            el.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => filterForm.submit(), 600);
            });
            el.addEventListener('change', () => filterForm.submit());
        });
    }
});
</script>
{% endblock %}
