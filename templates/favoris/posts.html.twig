{% extends 'base/base.html.twig' %}

{% block title %}Posts favoris — Fly&Go{% endblock %}

{% block body %}
<div style="max-width:1280px;margin:0 auto;padding:2rem">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem">
        <div>
            <h1 style="font-size:1.8rem;font-weight:900"><i class="fa fa-heart" style="color:var(--red)"></i> Posts favoris</h1>
            <p style="color:var(--muted)">Posts de forum sauvegardés</p>
        </div>
        <div style="display:flex;gap:.75rem">
            <a href="{{ path('user_dashboard') }}" class="btn btn-outline"><i class="fa fa-home"></i> Mon espace</a>
            <a href="{{ path('forum_index') }}" class="btn btn-gold"><i class="fa fa-comments"></i> Forum</a>
        </div>
    </div>

    <div class="favorites-tabs" style="margin-bottom:1.5rem;display:flex;gap:.5rem;flex-wrap:wrap">
        <a href="{{ path('favoris_hebergements') }}" class="tab"><i class="fa fa-hotel"></i> Hébergements</a>
        <a href="{{ path('favoris_circuits') }}" class="tab"><i class="fa fa-route"></i> Circuits</a>
        <a href="{{ path('favoris_activities') }}" class="tab"><i class="fa fa-hiking"></i> Activités</a>
        <a href="{{ path('favoris_transports') }}" class="tab"><i class="fa fa-plane"></i> Transport</a>
        <a href="{{ path('favoris_posts') }}" class="tab active"><i class="fa fa-comments"></i> Posts</a>
    </div>

    {% if favorites is empty %}
        <div class="empty-state" style="padding:4rem 2rem;text-align:center;background:var(--card-bg);border-radius:16px">
            <i class="fa fa-comments" style="font-size:3rem;color:var(--muted)"></i>
            <h3 style="margin:1rem 0 .5rem">Aucun post favori</h3>
            <p style="color:var(--muted);margin-bottom:1.5rem">Ajoutez des posts du forum à vos favoris pour les retrouver ici.</p>
            <a href="{{ path('forum_index') }}" class="btn btn-gold"><i class="fa fa-comments"></i> Explorer le forum</a>
        </div>
    {% else %}
        <div class="acard-wrap">
            <div class="acard-wrap__head">
                <span class="acard-wrap__title"><i class="fa fa-comments"></i> Posts ({{ favorites.totalItemCount }})</span>
            </div>
            <div class="bookings-list">
                {% for fav in favorites %}
                    {% set p = fav.post %}
                    <div class="booking-card">
                        <div class="booking-card__av" style="background:linear-gradient(135deg,#a8edea,#fed6e3)">
                            <i class="fa fa-comments"></i>
                        </div>
                        <div class="booking-card__info">
                            <div class="booking-card__name"><a href="{{ path('forum_show', {id: p.id}) }}" style="color:inherit;text-decoration:none">{{ p.title }}</a></div>
                            <div class="booking-card__meta">
                                <span><i class="fa fa-user"></i> {{ p.author }}</span>
                                <span><i class="fa fa-clock"></i> {{ p.createdAt|date('d/m/Y') }}</span>
                            </div>
                            <div style="font-size:.85rem;color:var(--muted);margin-top:.5rem">{{ p.content|length > 100 ? p.content[:100] ~ '...' : p.content }}</div>
                            <div style="margin-top:.5rem">
                                <span style="background:var(--primary);color:#fff;padding:.2rem .5rem;border-radius:4px;font-size:.75rem">{{ p.categorie|default('Discussion') }}</span>
                                <span style="margin-left:.5rem;color:var(--muted)"><i class="fa fa-eye"></i> {{ p.vues }}</span>
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:.5rem">
                            <a href="{{ path('forum_show', {id: p.id}) }}" class="btn btn-navy btn-sm"><i class="fa fa-eye"></i> Voir</a>
                            <button class="btn btn-red btn-sm" onclick="togglePostFavorite({{ p.id }}, this)" title="Retirer des favoris">
                                <i class="fa fa-heart"></i> Retirer
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% if favorites.pageCount|default(1) > 1 %}
            <div style="padding:1rem;text-align:center">
                {% for page in 1..favorites.pageCount %}
                    <a href="{{ path('favoris_posts', {page: page}) }}" class="btn {{ page == favorites.currentPageNumber ? 'btn-navy' : 'btn-outline' }} btn-sm" style="margin:0 .2rem">{{ page }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}