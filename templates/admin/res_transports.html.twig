{% extends 'admin/layout.html.twig' %}
{% block title %}Réservations transports — Admin{% endblock %}
{% block breadcrumb %}Réservations transports{% endblock %}
{% block admin_body %}
{% set q = app.request.query.get('q', '') %}
{% set statut = app.request.query.get('statut', '') %}
{% set tri = app.request.query.get('tri', 'recent') %}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
    <div>
        <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:.2rem">Réservations transports</h2>
        <p style="color:var(--muted);font-size:.85rem">{{ reservations.totalItemCount }} réservations</p>
    </div>
</div>

<div class="admin-toolbar">
    <form method="GET" action="{{ path('admin_res_transports') }}" id="filterForm">
        <div class="admin-toolbar__row">
            <div class="admin-toolbar__search">
                <i class="fa fa-search"></i>
                <input type="text" name="q" value="{{ q }}" placeholder="Client, transport..." data-auto-submit>
            </div>
            <div class="admin-toolbar__select">
                <select name="statut" data-auto-submit>
                    <option value="">Tous statuts</option>
                    <option value="PENDING" {{ statut == 'PENDING' ? 'selected' : '' }}>En attente</option>
                    <option value="CONFIRMED" {{ statut == 'CONFIRMED' ? 'selected' : '' }}>Confirmé</option>
                    <option value="CANCELLED" {{ statut == 'CANCELLED' ? 'selected' : '' }}>Annulé</option>
                    <option value="COMPLETED" {{ statut == 'COMPLETED' ? 'selected' : '' }}>Terminé</option>
                </select>
            </div>
            <select name="tri" class="admin-toolbar__sort" data-auto-submit>
                <option value="recent" {{ tri == 'recent' ? 'selected' : '' }}>Plus récentes</option>
                <option value="oldest" {{ tri == 'oldest' ? 'selected' : '' }}>Plus anciennes</option>
                <option value="price_asc" {{ tri == 'price_asc' ? 'selected' : '' }}>Prix ↑</option>
                <option value="price_desc" {{ tri == 'price_desc' ? 'selected' : '' }}>Prix ↓</option>
            </select>
            {% if q or statut %}
            <a href="{{ path('admin_res_transports') }}" class="btn btn-outline btn-sm"><i class="fa fa-times"></i></a>
            {% endif %}
        </div>
    </form>
</div>

<div class="acard-wrap">
    <div class="bookings-list">
        {% for r in reservations %}
        <div class="booking-card">
            <div class="booking-card__av">{{ (r.customerName ?: 'R')|slice(0,1)|upper }}</div>
            <div class="booking-card__info">
                <div class="booking-card__name">{{ r.customerName ?: 'N/A' }}</div>
                <div class="booking-card__meta">
                    <span><i class="fa fa-plane fa-xs"></i> {{ r.transportOffer ? r.transportOffer.companyName : '-' }}</span>
                    <span><i class="fa fa-calendar fa-xs"></i> {{ r.bookingDate|date('d/m/Y H:i') }}</span>
                    <span><i class="fa fa-users fa-xs"></i> {{ r.passengers }} pers.</span>
                    <span><i class="fa fa-envelope fa-xs"></i> {{ r.customerEmail ?: '' }}</span>
                </div>
            </div>
            <div class="booking-card__price">
                <strong>{{ r.totalPrice|number_format(3, ',', ' ') }}</strong><span>TND</span>
            </div>
            <span class="status status--{{ r.status == 'CONFIRMED' ? 'confirmed' : (r.status == 'PENDING' ? 'pending' : (r.status == 'CANCELLED' ? 'cancelled' : 'completed')) }}">
                {{ r.status == 'CONFIRMED' ? 'Confirmé' : (r.status == 'PENDING' ? 'En attente' : (r.status == 'CANCELLED' ? 'Annulé' : 'Terminé')) }}
            </span>
            <div class="booking-card__actions">
                <select class="form-control form-control-sm" onchange="updateTransportResStatus(this, {{ r.id }})" style="width:auto">
                    <option value="PENDING" {{ r.status == 'PENDING' ? 'selected' : '' }}>En attente</option>
                    <option value="CONFIRMED" {{ r.status == 'CONFIRMED' ? 'selected' : '' }}>Confirmé</option>
                    <option value="CANCELLED" {{ r.status == 'CANCELLED' ? 'selected' : '' }}>Annulé</option>
                    <option value="COMPLETED" {{ r.status == 'COMPLETED' ? 'selected' : '' }}>Terminé</option>
                </select>
                <form action="{{ path('admin_res_transport_delete', {id: r.id}) }}" method="POST" onsubmit="return confirm('Supprimer ?')">
                    <button type="submit" class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button>
                </form>
            </div>
        </div>
        {% else %}
        <div class="empty" style="padding:3rem"><i class="fa fa-ticket"></i><h3>Aucune réservation</h3></div>
        {% endfor %}
    </div>
</div>

{% if reservations.totalItemCount > reservations.itemNumberPerPage %}
<div class="admin-pagination">
    <div class="admin-pagination__info">
        {{ (reservations.currentPageNumber - 1) * reservations.itemNumberPerPage + 1 }} - {{ min(reservations.currentPageNumber * reservations.itemNumberPerPage, reservations.totalItemCount) }} sur {{ reservations.totalItemCount }}
    </div>
    <div class="admin-pagination__pages">
        {% if reservations.currentPageNumber > 1 %}
        <a href="{{ path('admin_res_transports', {page: reservations.currentPageNumber - 1, q: q, statut: statut, tri: tri}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-left"></i></a>
        {% endif %}
        {% for page in reservations.paginationData.pagesInRange %}
            {% if page == reservations.currentPageNumber %}
                <span class="admin-pagination__current">{{ page }}</span>
            {% else %}
                <a href="{{ path('admin_res_transports', {page: page, q: q, statut: statut, tri: tri}) }}" class="admin-pagination__btn">{{ page }}</a>
            {% endif %}
        {% endfor %}
        {% if reservations.currentPageNumber < reservations.pageCount %}
        <a href="{{ path('admin_res_transports', {page: reservations.currentPageNumber + 1, q: q, statut: statut, tri: tri}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-right"></i></a>
        {% endif %}
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
function updateTransportResStatus(select, id) {
    const status = select.value;
    if(!confirm('Changer le statut ?')) { select.value = select.dataset.prev; return; }
    fetch('{{ path('admin_res_transport_statut', {id: '__ID__'}) }}'.replace('__ID__', id), {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: 'status=' + status
    }).then(r => r.json()).then(data => {
        if (data.success) { showToast('✅ Statut mis à jour !'); }
        else showToast('Erreur','error');
    }).catch(() => showToast('Erreur','error'));
}
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
        filterForm.querySelectorAll('[data-auto-submit]').forEach(el => {
            let timeout;
            el.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => filterForm.submit(), 600);
            });
            el.addEventListener('change', () => filterForm.submit());
        });
    }
});
</script>
{% endblock %}
