{% extends 'admin/layout.html.twig' %}
{% block title %}Utilisateurs — Admin{% endblock %}
{% block breadcrumb %}Utilisateurs{% endblock %}
{% block admin_body %}
{% set q = app.request.query.get('q', '') %}
{% set role = app.request.query.get('role', '') %}
<div style="margin-bottom:1.5rem">
    <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:.2rem">Gestion des utilisateurs</h2>
    <p style="color:var(--muted);font-size:.85rem">{{ users.totalItemCount }} utilisateurs inscrits</p>
</div>

<div class="admin-toolbar">
    <form method="GET" action="{{ path('admin_users') }}" id="filterForm">
        <div class="admin-toolbar__row">
            <div class="admin-toolbar__search">
                <i class="fa fa-search"></i>
                <input type="text" name="q" value="{{ q }}" placeholder="Nom, email..." data-auto-submit>
            </div>
            <div class="admin-toolbar__select">
                <select name="role" data-auto-submit>
                    <option value="">Tous rôles</option>
                    <option value="ROLE_ADMIN" {{ role == 'ROLE_ADMIN' ? 'selected' : '' }}>Administrateurs</option>
                    <option value="ROLE_USER" {{ role == 'ROLE_USER' ? 'selected' : '' }}>Utilisateurs</option>
                </select>
            </div>
            <div class="admin-toolbar__select">
                <select name="active" data-auto-submit>
                    <option value="">Tous statuts</option>
                    <option value="1" {{ app.request.query.get('active') == '1' ? 'selected' : '' }}>Actifs</option>
                    <option value="0" {{ app.request.query.get('active') == '0' ? 'selected' : '' }}>Inactifs</option>
                </select>
            </div>
            <select name="tri" class="admin-toolbar__sort" data-auto-submit>
                <option value="recent" {{ tri|default('recent') == 'recent' ? 'selected' : '' }}>Plus récents</option>
                <option value="oldest" {{ tri|default('recent') == 'oldest' ? 'selected' : '' }}>Plus anciens</option>
            </select>
            {% if q or role or app.request.query.get('active') %}
            <a href="{{ path('admin_users') }}" class="btn btn-outline btn-sm"><i class="fa fa-times"></i></a>
            {% endif %}
        </div>
    </form>
</div>

<div class="acard-wrap">
    <div class="bookings-list">
        {% for u in users %}
        <div class="booking-card">
            <div class="booking-card__av" style="background:{{ 'ROLE_ADMIN' in u.roles ? 'linear-gradient(135deg,var(--gold),#FF9500)' : 'linear-gradient(135deg,var(--navy),var(--cyan))' }}">
                {{ u.prenom|slice(0,1)|upper }}
            </div>
            <div class="booking-card__info">
