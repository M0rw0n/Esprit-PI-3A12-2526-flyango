                </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:.2rem;align-items:flex-end">
                {% for r in u.roles %}
                <span class="tag {{ r == 'ROLE_ADMIN' ? 'tag--gold' : 'tag--navy' }}">{{ r }}</span>
                {% endfor %}
            </div>
