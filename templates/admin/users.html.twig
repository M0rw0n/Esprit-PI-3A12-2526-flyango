{% if users.totalItemCount > users.itemNumberPerPage %}
<div class="admin-pagination">
    <div class="admin-pagination__info">
        {{ (users.currentPageNumber - 1) * users.itemNumberPerPage + 1 }} - {{ min(users.currentPageNumber * users.itemNumberPerPage, users.totalItemCount) }} sur {{ users.totalItemCount }}
    </div>
    <div class="admin-pagination__pages">
        {% if users.currentPageNumber > 1 %}
        <a href="{{ path('admin_users', {page: users.currentPageNumber - 1, q: q, role: role, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-left"></i></a>
        {% endif %}
        {% for page in users.paginationData.pagesInRange %}
            {% if page == users.currentPageNumber %}
                <span class="admin-pagination__current">{{ page }}</span>
            {% else %}
                <a href="{{ path('admin_users', {page: page, q: q, role: role, tri: tri|default('recent')}) }}" class="admin-pagination__btn">{{ page }}</a>
            {% endif %}
        {% endfor %}
        {% if users.currentPageNumber < users.pageCount %}
        <a href="{{ path('admin_users', {page: users.currentPageNumber + 1, q: q, role: role, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-right"></i></a>
        {% endif %}
    </div>
</div>
{% endif %}
{% endblock %}
{% block javascripts %}
<script>
function toggleUser(id) {
    $.post('{{ path("admin_user_toggle", {"id": "__ID__"}) }}'.replace('__ID__', id))
     .done(()=>{ showToast('✅ Statut mis à jour !'); setTimeout(()=>location.reload(),900); })
     .fail(()=>showToast('Erreur','error'));
}
function toggleRole(id) {
    if(!confirm('Changer le rôle ?')) return;
    $.post('{{ path("admin_user_role", {"id": "__ID__"}) }}'.replace('__ID__', id))
     .done(()=>{ showToast('✅ Rôle mis à jour !'); setTimeout(()=>location.reload(),900); })
     .fail(()=>showToast('Erreur','error'));
}
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
        filterForm.querySelectorAll('[data-auto-submit]').forEach(el => {
            let timeout;
            el.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => filterForm.submit(), 600);
            });
            el.addEventListener('change', () => filterForm.submit());
        });
    }
});
</script>
{% endblock %}
