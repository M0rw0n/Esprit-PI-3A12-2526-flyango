{% extends 'admin/layout.html.twig' %}

{% block title %}Profil {{ profil.user.fullName }} - Administration{% endblock %}
{% block breadcrumb %}Profil Voyageur{% endblock %}

{% block admin_body %}
<div class="admin-page-header">
    <div class="admin-page-header__left">
        <a href="{{ path('admin_profils') }}" class="admin-back-btn">
            <i class="fa fa-arrow-left"></i>
        </a>
        <h1 class="admin-page-title">
            <i class="fa fa-suitcase-rolling"></i> Profil Voyageur
        </h1>
    </div>
</div>

<div class="admin-grid" style="margin-bottom:2rem">
    {# Info utilisateur #}
    <div class="admin-card" style="padding:0;overflow:hidden">
        <div class="admin-card-header">
            <i class="fa fa-user"></i> Utilisateur
        </div>
        <div class="admin-card-body text-center">
            <div class="admin-avatar-lg">
                {{ profil.user.prenom|first|upper }}{{ profil.user.nom|first|upper }}
            </div>
            <h3 class="mt-3 mb-1">{{ profil.user.fullName }}</h3>
            <p class="text-muted mb-1">{{ profil.user.email }}</p>
            {% if profil.user.telephone %}
            <p class="text-muted mb-0"><i class="fa fa-phone me-1"></i>{{ profil.user.telephone }}</p>
            {% endif %}
        </div>
    </div>

    {# Détails profil #}
    <div class="admin-card" style="padding:0;overflow:hidden;grid-column: span 2">
        <div class="admin-card-header">
            <i class="fa fa-info-circle"></i> Détails du profil
        </div>
        <div class="admin-card-body">
            <div class="admin-detail-grid">
                <div class="admin-detail-item">
                    <label><i class="fa fa-map-marker-alt text-danger"></i> Destination</label>
                    <h4>{{ profil.destinationPreferee }}</h4>
                </div>
                <div class="admin-detail-item">
                    <label><i class="fa fa-tag text-info"></i> Type de voyage</label>
                    <h4>
                        <span class="admin-tag admin-tag--cyan">
                            <i class="{{ profil.typeVoyageIcon }}"></i>
                            {{ typeLabels[profil.typeVoyage] ?? profil.typeVoyage }}
                        </span>
                    </h4>
                </div>
                <div class="admin-detail-item">
                    <label><i class="fa fa-coins text-warning"></i> Budget moyen</label>
                    <h3 class="text-success mb-0">{{ profil.budget|number_format(2, ',', ' ') }} TND</h3>
                </div>
                <div class="admin-detail-item">
                    <label><i class="fa fa-calendar text-muted"></i> Créé le</label>
                    <p class="mb-0">{{ profil.createdAt|date('d/m/Y à H:i') }}</p>
                </div>
                <div class="admin-detail-item" style="grid-column: 1 / -1">
                    <label><i class="fa fa-clock text-muted"></i> Dernière modification</label>
                    <p class="mb-0">{{ profil.updatedAt|date('d/m/Y à H:i') }}</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.admin-page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}
.admin-page-header__left { display: flex; align-items: center; gap: 1rem; }
.admin-page-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.admin-page-title i { color: var(--cyan); }
.admin-back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-sm);
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    transition: all var(--t);
    text-decoration: none;
}
.admin-back-btn:hover { background: var(--navy); color: #fff; border-color: var(--navy); }
.admin-card {
    background: var(--card);
    border-radius: var(--r);
    border: 1px solid var(--border);
    box-shadow: var(--s1);
}
.admin-card-header {
    padding: 1rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    font-weight: 700;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.admin-card-header i { color: var(--navy); }
.admin-card-body { padding: 1.5rem; }
.admin-avatar-lg {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--navy), var(--cyan));
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 800;
}
.admin-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}
.admin-detail-item label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 0.5rem;
}
.admin-detail-item h4, .admin-detail-item h3 { margin: 0; }
.admin-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--r-sm);
    font-size: 0.85rem;
    font-weight: 600;
}
.admin-tag--cyan { background: rgba(0,180,216,0.1); color: var(--cyan-d); }
</style>
{% endblock %}
