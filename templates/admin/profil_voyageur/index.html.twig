{% extends 'admin/layout.html.twig' %}

{% block title %}Profils Voyageur - Administration{% endblock %}
{% block breadcrumb %}Profils Voyageur{% endblock %}

{% block admin_body %}
<div class="admin-page-header">
    <div class="admin-page-header__left">
        <h1 class="admin-page-title">
            <i class="fa fa-suitcase-rolling"></i> Profils Voyageur
        </h1>
        <span class="admin-page-count">{{ profils.totalItemCount|default(profils|length) }} profils</span>
    </div>
</div>

{# Filtres #}
<div class="admin-toolbar">
    <form method="get" class="admin-toolbar__form">
        <div class="admin-toolbar__row">
            <div class="admin-toolbar__search">
                <i class="fa fa-search"></i>
                <input type="text" name="q" placeholder="Destination, nom..." value="{{ filters.q }}">
            </div>
            <div class="admin-toolbar__select">
                <select name="type">
                    <option value="">Tous types</option>
                    {% for t in types %}
                        <option value="{{ t }}" {{ filters.type == t ? 'selected' }}>{{ typeLabels[t] }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="admin-toolbar__select">
                <input type="number" name="budget_min" placeholder="Budget min" value="{{ filters.budget_min }}" style="padding:.6rem 1rem;border:1.5px solid var(--border);border-radius:var(--r-sm);width:100%">
            </div>
            <div class="admin-toolbar__select">
                <input type="number" name="budget_max" placeholder="Budget max" value="{{ filters.budget_max }}" style="padding:.6rem 1rem;border:1.5px solid var(--border);border-radius:var(--r-sm);width:100%">
            </div>
            <div class="admin-toolbar__select">
                <select name="tri">
                    <option value="recent" {{ filters.tri == 'recent' ? 'selected' }}>Plus récents</option>
                    <option value="budget_asc" {{ filters.tri == 'budget_asc' ? 'selected' }}>Budget ↑</option>
                    <option value="budget_desc" {{ filters.tri == 'budget_desc' ? 'selected' }}>Budget ↓</option>
                    <option value="destination" {{ filters.tri == 'destination' ? 'selected' }}>Destination</option>
                    <option value="type" {{ filters.tri == 'type' ? 'selected' }}>Type</option>
                </select>
            </div>
            <button type="submit" class="btn btn-navy">
                <i class="fa fa-filter"></i> Filtrer
            </button>
            {% if filters.q or filters.type or filters.budget_min or filters.budget_max %}
            <a href="{{ path('admin_profils') }}" class="btn btn-outline">
                <i class="fa fa-times"></i>
            </a>
            {% endif %}
        </div>
    </form>
</div>

{# Tableau #}
<div class="admin-card">
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th><i class="fa fa-user"></i> Utilisateur</th>
                    <th><i class="fa fa-map-marker-alt"></i> Destination</th>
                    <th><i class="fa fa-tag"></i> Type</th>
                    <th><i class="fa fa-coins"></i> Budget</th>
                    <th><i class="fa fa-calendar"></i> Créé le</th>
                    <th><i class="fa fa-cog"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for profil in profils %}
                <tr>
                    <td>
                        <div class="admin-user-cell">
                            <div class="admin-avatar">{{ profil.user.prenom|first|upper }}{{ profil.user.nom|first|upper }}</div>
                            <div class="admin-user-info">
                                <strong>{{ profil.user.prenom }} {{ profil.user.nom }}</strong>
                                <small>{{ profil.user.email }}</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="admin-tag admin-tag--danger">
                            <i class="fa fa-map-marker-alt"></i> {{ profil.destinationPreferee }}
                        </span>
                    </td>
                    <td>
                        <span class="admin-tag admin-tag--cyan">
                            <i class="{{ profil.typeVoyageIcon }}"></i> {{ typeLabels[profil.typeVoyage] ?? profil.typeVoyage }}
                        </span>
                    </td>
                    <td>
                        <strong class="admin-money">{{ profil.budget|number_format(2, ',', ' ') }} TND</strong>
                    </td>
                    <td>
                        <small class="admin-date">{{ profil.createdAt|date('d/m/Y') }}</small>
                    </td>
                    <td>
                        <a href="{{ path('admin_profils_show', {id: profil.id}) }}" class="admin-btn admin-btn--navy">
                            <i class="fa fa-eye"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="admin-empty">
                        <i class="fa fa-inbox"></i>
                        <p>Aucun profil trouvé</p>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    {% if profils.pageCount|default(1) > 1 %}
    <div class="admin-pagination">
        <div class="admin-pagination__info">
            Page {{ profils.currentPageNumber|default(1) }} sur {{ profils.pageCount|default(1) }}
        </div>
        <div class="admin-pagination__pages">
            {% if profils.currentPageNumber|default(1) > 1 %}
            <a href="{{ path('admin_profils', {page: profils.currentPageNumber|default(1) - 1}|merge(filters)) }}" class="admin-pagination__btn">
                <i class="fa fa-chevron-left"></i>
            </a>
            {% endif %}

            {% for page in 1..(profils.pageCount|default(1)) %}
                {% if page >= (profils.currentPageNumber|default(1) - 2) and page <= (profils.currentPageNumber|default(1) + 2) %}
                <a href="{{ path('admin_profils', {page: page}|merge(filters)) }}" 
                   class="admin-pagination__btn {{ page == profils.currentPageNumber|default(1) ? 'admin-pagination__current' }}">
                    {{ page }}
                </a>
                {% endif %}
            {% endfor %}

            {% if profils.currentPageNumber|default(1) < profils.pageCount|default(1) %}
            <a href="{{ path('admin_profils', {page: profils.currentPageNumber|default(1) + 1}|merge(filters)) }}" class="admin-pagination__btn">
                <i class="fa fa-chevron-right"></i>
            </a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>

<style>
.admin-page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}
.admin-page-header__left { display: flex; align-items: center; gap: 1rem; }
.admin-page-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.admin-page-title i { color: var(--cyan); }
.admin-page-count {
    background: var(--cyan);
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
}
.admin-card {
    background: var(--card);
    border-radius: var(--r);
    border: 1px solid var(--border);
    box-shadow: var(--s1);
    overflow: hidden;
}
.admin-table-wrap { overflow-x: auto; }
.admin-table {
    width: 100%;
    border-collapse: collapse;
}
.admin-table th {
    background: var(--bg);
    padding: 1rem 1.25rem;
    text-align: left;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
}
.admin-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
}
.admin-table tr:last-child td { border-bottom: none; }
.admin-table tr:hover td { background: var(--bg); }
.admin-user-cell { display: flex; align-items: center; gap: 0.75rem; }
.admin-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--navy), var(--cyan));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
}
.admin-user-info strong { display: block; font-size: 0.9rem; }
.admin-user-info small { color: var(--muted); font-size: 0.8rem; }
.admin-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-sm);
    font-size: 0.8rem;
    font-weight: 600;
}
.admin-tag--danger { background: rgba(239,68,68,0.1); color: #ef4444; }
.admin-tag--cyan { background: rgba(0,180,216,0.1); color: var(--cyan-d); }
.admin-tag--gold { background: rgba(255,183,0,0.1); color: #d97706; }
.admin-money { color: var(--green); font-size: 0.95rem; }
.admin-date { color: var(--muted); }
.admin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-sm);
    border: 1px solid var(--border);
    color: var(--text);
    transition: all var(--t);
    text-decoration: none;
}
.admin-btn:hover { transform: translateY(-2px); }
.admin-btn--navy { background: rgba(27,58,107,0.1); color: var(--navy); }
.admin-btn--navy:hover { background: var(--navy); color: #fff; }
.admin-empty {
    text-align: center;
    padding: 3rem !important;
    color: var(--muted);
}
.admin-empty i { font-size: 2.5rem; margin-bottom: 0.5rem; display: block; }
.admin-empty p { margin: 0; font-size: 0.95rem; }
</style>
{% endblock %}
