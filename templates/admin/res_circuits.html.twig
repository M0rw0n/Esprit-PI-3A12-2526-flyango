{% extends 'admin/layout.html.twig' %}
{% block title %}Réservations circuits — Admin{% endblock %}
{% block breadcrumb %}Réservations circuits{% endblock %}
{% block admin_body %}
<div style="margin-bottom:1.5rem">
    <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:.2rem">Réservations circuits</h2>
    <p style="color:var(--muted);font-size:.85rem">{{ reservations|length }} au total</p>
</div>
<div class="acard-wrap">
    <div class="bookings-list">
        {% for r in reservations %}
        <div class="booking-card">
            <div class="booking-card__av">{{ r.nomClient|slice(0,1)|upper }}</div>
            <div class="booking-card__info">
                <div class="booking-card__name">{{ r.nomClient }}</div>
                <div class="booking-card__meta">
                    <span><i class="fa fa-route fa-xs"></i> {{ r.circuit.titre }}</span>
                    <span><i class="fa fa-calendar fa-xs"></i> {{ r.dateReservation|date('d/m/Y') }}</span>
                    <span><i class="fa fa-users fa-xs"></i> {{ r.nbPersonnes }} pers.</span>
                </div>
            </div>
            <div class="booking-card__price">
                <strong>{{ r.montantTotal|number_format(3, ',', ' ') }}</strong><span>TND</span>
            </div>
            <span class="status status--{{ r.statut == 'CONFIRMEE' ? 'confirmed' : (r.statut == 'EN_ATTENTE' ? 'pending' : 'cancelled') }}">
                {{ r.statut == 'CONFIRMEE' ? 'Confirmée' : (r.statut == 'EN_ATTENTE' ? 'En attente' : 'Annulée') }}
            </span>
            <div class="booking-card__actions">
                {% if r.statut == 'EN_ATTENTE' %}
                <button onclick="changeRC({{ r.id }}, 'CONFIRMEE')" class="btn btn-green btn-sm"><i class="fa fa-check"></i></button>
                <button onclick="changeRC({{ r.id }}, 'ANNULEE')" class="btn btn-red btn-sm"><i class="fa fa-times"></i></button>
                {% endif %}
                <form action="{{ path('admin_res_circuit_delete', {id: r.id}) }}" method="POST" onsubmit="return confirm('Supprimer ?')">
                    <button type="submit" class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button>
                </form>
            </div>
        </div>
        {% else %}
        <div class="empty" style="padding:3rem"><i class="fa fa-route"></i><h3>Aucune réservation circuit</h3></div>
        {% endfor %}
    </div>
</div>
{% endblock %}
{% block javascripts %}
<script>
function changeRC(id, statut) {
    if(!confirm('Changer le statut ?')) return;
    $.post('{{ path("admin_res_circuit_statut", {"id": "__ID__"}) }}'.replace('__ID__', id), {statut})
     .done(()=>{ showToast('✅ Statut mis à jour !'); setTimeout(()=>location.reload(),900); })
     .fail(()=>showToast('Erreur','error'));
}
</script>
{% endblock %}
