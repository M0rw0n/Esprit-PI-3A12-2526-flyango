<script>
function showImportModal() {
    document.getElementById('importModal').style.display = 'flex';
    document.getElementById('importCity').value = '';
    document.getElementById('importStatus').style.display = 'none';
}

function closeImportModal() {
    document.getElementById('importModal').style.display = 'none';
}

function searchAndImport() {
    var city = document.getElementById('importCity').value.trim();
    if (!city) {
        document.getElementById('importCity').style.borderColor = 'var(--red)';
        document.getElementById('importCity').focus();
        return;
    }
    document.getElementById('importCity').style.borderColor = 'var(--border)';
    
    var btn = document.getElementById('searchBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa fa-spin fa-spinner"></i> Recherche & Import en cours...';
    
    var statusDiv = document.getElementById('importStatus');
    statusDiv.style.display = 'block';
    document.getElementById('statusText').textContent = 'Recherche des hôtels à ' + city + '...';
    document.getElementById('statusCount').textContent = '';
    
    var checkin = new Date(Date.now() + 86400000).toISOString().split('T')[0];
    var checkout = new Date(Date.now() + 259200000).toISOString().split('T')[0];
    
    var url = '/admin/hebergements/search-rapidapi?ville=' + encodeURIComponent(city) + '&checkin=' + checkin + '&checkout=' + checkout;
    
    fetch(url)
    .then(r => r.json())
    .then(data => {
        if (!data.success || !data.hotels || data.hotels.length === 0) {
            document.getElementById('statusText').textContent = 'Aucun hôtel trouvé pour ' + city;
            document.getElementById('statusCount').innerHTML = '<span style="color:var(--muted)">Essayez une autre ville</span>';
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-search"></i> Réessayer';
            return;
        }
        
        var count = data.hotels.length;
        document.getElementById('statusText').textContent = count + ' hôtels trouvés !';
        document.getElementById('statusCount').textContent = 'Importation en cours...';
        
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/admin/hebergement/import-rapidapi';
        
        var hotelIds = data.hotels.map(function(h) { return h.hotel_id; }).join(',');
        
        form.innerHTML = '<input type="hidden" name="ville" value="' + city + '">' +
            '<input type="hidden" name="hotels" value="' + hotelIds + '">';
        
        document.body.appendChild(form);
        form.submit();
    })
    .catch(e => {
        document.getElementById('statusText').textContent = 'Erreur de connexion';
        document.getElementById('statusCount').textContent = 'Veuillez réessayer';
        btn.disabled = false;
        btn.innerHTML = '<i class="fa fa-search"></i> Réessayer';
    });
}
</script>

