{% extends 'admin/layout.html.twig' %}
{% block title %}Hébergements — Admin{% endblock %}
{% block breadcrumb %}Hébergements{% endblock %}
{% block admin_body %}
{% set q = app.request.query.get('q', '') %}
{% set ville = app.request.query.get('ville', '') %}
{% set type = app.request.query.get('type', '') %}
{% set disponible = app.request.query.get('disponible', '') %}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
    <div>
        <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:.2rem">Gestion des hébergements</h2>
        <p style="color:var(--muted);font-size:.85rem">{{ hebergements.totalItemCount }} hébergements</p>
    </div>
    <a href="{{ path('admin_hebergement_new') }}" class="btn btn-navy"><i class="fa fa-plus"></i> Nouvel hébergement</a>
</div>

<div class="admin-toolbar">
    <form method="GET" action="{{ path('admin_hebergements') }}" id="filterForm">
        <div class="admin-toolbar__row">
            <div class="admin-toolbar__search">
                <i class="fa fa-search"></i>
                <input type="text" name="q" value="{{ q }}" placeholder="Rechercher un hébergement..." data-auto-submit>
            </div>
            <div class="admin-toolbar__select">
                <select name="ville" data-auto-submit>
                    <option value="">Toutes villes</option>
                    {% for v in ['Tunis','Sousse','Sfax','Djerba','Hammamet','Tozeur','Kairouan','Mahdia','Tabarka'] %}
                    <option value="{{ v }}" {{ ville == v ? 'selected' : '' }}>{{ v }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="admin-toolbar__select">
                <select name="type" data-auto-submit>
                    <option value="">Tous types</option>
                    {% for t in ['Hôtel','Appartement','Villa','Riad','Resort','Maison d\'hôtes','Auberge'] %}
                    <option value="{{ t }}" {{ type == t ? 'selected' : '' }}>{{ t }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="admin-toolbar__select">
                <select name="disponible" data-auto-submit>
                    <option value="">Tous statuts</option>
                    <option value="1" {{ disponible == '1' ? 'selected' : '' }}>Disponibles</option>
                    <option value="0" {{ disponible == '0' ? 'selected' : '' }}>Indisponibles</option>
                </select>
            </div>
            <select name="tri" class="admin-toolbar__sort" data-auto-submit>
                <option value="recent" {{ tri|default('recent') == 'recent' ? 'selected' : '' }}>Plus récents</option>
                <option value="oldest" {{ tri|default('recent') == 'oldest' ? 'selected' : '' }}>Plus anciens</option>
                <option value="price_asc" {{ tri|default('recent') == 'price_asc' ? 'selected' : '' }}>Prix ↑</option>
                <option value="price_desc" {{ tri|default('recent') == 'price_desc' ? 'selected' : '' }}>Prix ↓</option>
            </select>
            {% if q or ville or type or disponible %}
            <a href="{{ path('admin_hebergements') }}" class="btn btn-outline btn-sm"><i class="fa fa-times"></i></a>
            {% endif %}
        </div>
    </form>
</div>

<div class="admin-acts">
    {% for h in hebergements %}
    <div class="adm-act">
        <div class="adm-act__img">
            {% if h.image %}
            <img src="{{ asset(h.image) }}" alt="{{ h.nom }}" onerror="this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?w=300&q=70'">
            {% else %}
            <div style="height:130px;background:var(--bg2);display:flex;align-items:center;justify-content:center"><i class="fa fa-hotel" style="font-size:2rem;color:var(--border)"></i></div>
            {% endif %}
            <div style="position:absolute;top:.5rem;right:.5rem">
                <span class="status status--{{ h.disponible ? 'confirmed' : 'cancelled' }}">{{ h.disponible ? 'Disponible' : 'Indisponible' }}</span>
            </div>
        </div>
        <div class="adm-act__body">
            <div class="adm-act__title">{{ h.nom }}</div>
            <div class="adm-act__meta">
                <span><i class="fa fa-map-marker-alt" style="color:var(--cyan)"></i> {{ h.ville }}</span>
                <span><i class="fa fa-tag" style="color:var(--muted)"></i> {{ h.type }}</span>
                {% if h.capacite %}<span><i class="fa fa-users" style="color:var(--muted)"></i> {{ h.capacite }} pers.</span>{% endif %}
            </div>
            <div class="adm-act__foot">
                <div class="price price--sm">
                    <span class="price__val">{{ h.prixParNuit|number_format(3, ',', ' ') }}</span>
                    <span class="price__cur">TND</span>
                    <span class="price__per">/nuit</span>
                </div>
                <div class="adm-act__actions">
                    <a href="{{ path('hebergement_show', {id: h.id}) }}" class="btn btn-outline btn-sm" target="_blank"><i class="fa fa-eye"></i></a>
                    <a href="{{ path('admin_hebergement_edit', {id: h.id}) }}" class="btn btn-navy btn-sm"><i class="fa fa-edit"></i></a>
                    <form action="{{ path('admin_hebergement_delete', {id: h.id}) }}" method="POST" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_heb_'~h.id) }}">
                        <button type="submit" class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="empty" style="grid-column:1/-1"><i class="fa fa-hotel"></i><h3>Aucun hébergement</h3>
        <a href="{{ path('admin_hebergement_new') }}" class="btn btn-navy"><i class="fa fa-plus"></i> Ajouter</a>
    </div>
    {% endfor %}
</div>

{% if hebergements.totalItemCount > hebergements.itemNumberPerPage %}
<div class="admin-pagination">
    <div class="admin-pagination__info">
        {{ (hebergements.currentPageNumber - 1) * hebergements.itemNumberPerPage + 1 }} - {{ min(hebergements.currentPageNumber * hebergements.itemNumberPerPage, hebergements.totalItemCount) }} sur {{ hebergements.totalItemCount }}
    </div>
    <div class="admin-pagination__pages">
        {% if hebergements.currentPageNumber > 1 %}
        <a href="{{ path('admin_hebergements', {page: hebergements.currentPageNumber - 1, q: q, ville: ville, type: type, disponible: disponible, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-left"></i></a>
        {% endif %}
        {% for page in hebergements.paginationData.pagesInRange %}
            {% if page == hebergements.currentPageNumber %}
                <span class="admin-pagination__current">{{ page }}</span>
            {% else %}
                <a href="{{ path('admin_hebergements', {page: page, q: q, ville: ville, type: type, disponible: disponible, tri: tri|default('recent')}) }}" class="admin-pagination__btn">{{ page }}</a>
            {% endif %}
        {% endfor %}
        {% if hebergements.currentPageNumber < hebergements.pageCount %}
        <a href="{{ path('admin_hebergements', {page: hebergements.currentPageNumber + 1, q: q, ville: ville, type: type, disponible: disponible, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-right"></i></a>
        {% endif %}
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
        filterForm.querySelectorAll('[data-auto-submit]').forEach(el => {
            let timeout;
            el.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => filterForm.submit(), 600);
            });
            el.addEventListener('change', () => filterForm.submit());
        });
    }
});
</script>
{% endblock %}
