<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Statistiques — Fly&Go</title>
<style>
body{font-family:DejaVu Sans,Arial,sans-serif;color:#0F1E35;margin:0;padding:20px;font-size:12px}
h1{color:#1B3A6B;font-size:22px;border-bottom:3px solid #FFB700;padding-bottom:10px;margin-bottom:20px}
.kpi-row{display:flex;gap:15px;margin-bottom:20px}
.kpi{flex:1;background:#F0F4F8;border-radius:8px;padding:15px;text-align:center;border-left:4px solid #1B3A6B}
.kpi h3{margin:0 0 5px;font-size:10px;color:#64748B;text-transform:uppercase}
.kpi p{margin:0;font-size:20px;font-weight:900;color:#1B3A6B}
table{width:100%;border-collapse:collapse;margin-top:15px}
th{background:#1B3A6B;color:#fff;padding:8px 10px;text-align:left;font-size:11px}
td{padding:7px 10px;border-bottom:1px solid #DDE5EF;font-size:11px}
tr:nth-child(even) td{background:#F0F4F8}
.status-conf{color:#065f46;font-weight:700}
.status-att{color:#92400e;font-weight:700}
.status-ann{color:#991b1b;font-weight:700}
.footer{margin-top:30px;text-align:center;color:#64748B;font-size:10px;border-top:1px solid #DDE5EF;padding-top:15px}
</style>
</head>
<body>
<h1>✈ Fly&Go — Rapport de statistiques</h1>
<p style="color:#64748B;margin-bottom:20px">Généré le {{ date|date('d/m/Y à H:i') }}</p>

<div class="kpi-row">
    <div class="kpi"><h3>Hébergements</h3><p>{{ totalHebergements }}</p></div>
    <div class="kpi"><h3>Réservations</h3><p>{{ totalReservations }}</p></div>
    <div class="kpi" style="border-left-color:#10B981"><h3>Revenus totaux</h3><p>{{ revenus|number_format(3, ',', ' ') }} TND</p></div>
    <div class="kpi" style="border-left-color:#FFB700"><h3>Note moyenne</h3><p>{{ moyenneAvis > 0 ? moyenneAvis : 'N/A' }} ★</p></div>
</div>

<h2 style="font-size:15px;color:#1B3A6B">20 dernières réservations</h2>
<table>
    <thead><tr><th>#</th><th>Client</th><th>Hébergement</th><th>Dates</th><th>Montant</th><th>Statut</th></tr></thead>
    <tbody>
    {% for r in reservations %}
    <tr>
        <td>{{ r.id }}</td>
        <td>{{ r.nomClient }}</td>
        <td>{{ r.hebergement.nom }}</td>
        <td>{{ r.dateDebut|date('d/m/Y') }} → {{ r.dateFin|date('d/m/Y') }}</td>
        <td><strong>{{ r.montantTotal|number_format(3, ',', ' ') }} TND</strong></td>
        <td class="status-{{ r.statut == 'CONFIRMEE' ? 'conf' : (r.statut == 'EN_ATTENTE' ? 'att' : 'ann') }}">
            {{ r.statut }}
        </td>
    </tr>
    {% endfor %}
    </tbody>
</table>

<div class="footer">Fly&Go · Rapport confidentiel · {{ date|date('Y') }}</div>
</body>
</html>
