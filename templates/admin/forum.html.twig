{% extends 'admin/layout.html.twig' %}
{% block title %}Forum — Admin{% endblock %}
{% block breadcrumb %}Forum{% endblock %}
{% block admin_body %}
{% set q = app.request.query.get('q', '') %}
{% set status = app.request.query.get('status', '') %}
<div style="margin-bottom:1.5rem">
    <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:.2rem">Modération du forum</h2>
    <p style="color:var(--muted);font-size:.85rem">{{ posts.totalItemCount }} posts</p>
</div>

<div class="admin-toolbar">
    <form method="GET" action="{{ path('admin_forum') }}" id="filterForm">
        <div class="admin-toolbar__row">
            <div class="admin-toolbar__search">
                <i class="fa fa-search"></i>
                <input type="text" name="q" value="{{ q }}" placeholder="Titre, auteur..." data-auto-submit>
            </div>
            <div class="admin-toolbar__select">
                <select name="status" data-auto-submit>
                    <option value="">Tous statuts</option>
                    <option value="PENDING" {{ status == 'PENDING' ? 'selected' : '' }}>En attente</option>
                    <option value="APPROVED" {{ status == 'APPROVED' ? 'selected' : '' }}>Approuvés</option>
                    <option value="REJECTED" {{ status == 'REJECTED' ? 'selected' : '' }}>Rejetés</option>
                </select>
            </div>
            <select name="tri" class="admin-toolbar__sort" data-auto-submit>
                <option value="recent" {{ tri|default('recent') == 'recent' ? 'selected' : '' }}>Plus récents</option>
                <option value="oldest" {{ tri|default('recent') == 'oldest' ? 'selected' : '' }}>Plus anciens</option>
            </select>
            {% if q or status %}
            <a href="{{ path('admin_forum') }}" class="btn btn-outline btn-sm"><i class="fa fa-times"></i></a>
            {% endif %}
        </div>
    </form>
</div>

<div class="acard-wrap">
    <div class="bookings-list">
        {% for p in posts %}
        <div class="booking-card">
            <div class="booking-card__av" style="background:linear-gradient(135deg,#7C3AED,#4F46E5)">{{ p.author|slice(0,1)|upper }}</div>
            <div class="booking-card__info">
                <div class="booking-card__name">{{ p.title }}</div>
                <div class="booking-card__meta">
                    <span><i class="fa fa-user fa-xs"></i> {{ p.author }}</span>
                    <span><i class="fa fa-calendar fa-xs"></i> {{ p.createdAt|date('d/m/Y') }}</span>
                    <span><i class="fa fa-comment fa-xs"></i> {{ p.comments|length }} commentaires</span>
                    {% if p.categorie %}<span class="tag tag--navy">{{ p.categorie }}</span>{% endif %}
                </div>
            </div>
            <span class="status status--{{ p.status == 'APPROVED' ? 'confirmed' : (p.status == 'PENDING' ? 'pending' : 'cancelled') }}">
                {{ p.status == 'APPROVED' ? 'Approuvé' : (p.status == 'PENDING' ? 'En attente' : 'Rejeté') }}
            </span>
            <div class="booking-card__actions">
                <a href="{{ path('forum_show', {id: p.id}) }}" class="btn btn-outline btn-sm" target="_blank"><i class="fa fa-eye"></i></a>
                {% if p.status != 'APPROVED' %}
                <button onclick="moderate({{ p.id }}, 'APPROVED')" class="btn btn-green btn-sm"><i class="fa fa-check"></i></button>
                {% endif %}
                {% if p.status != 'REJECTED' %}
                <button onclick="moderate({{ p.id }}, 'REJECTED')" class="btn btn-red btn-sm"><i class="fa fa-ban"></i></button>
                {% endif %}
                <form action="{{ path('admin_forum_delete', {id: p.id}) }}" method="POST" onsubmit="return confirm('Supprimer ?')">
                    <button type="submit" class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button>
                </form>
            </div>
        </div>
        {% else %}
        <div class="empty" style="padding:3rem"><i class="fa fa-comments"></i><h3>Aucun post</h3></div>
        {% endfor %}
    </div>
</div>

{% if posts.totalItemCount > posts.itemNumberPerPage %}
<div class="admin-pagination">
    <div class="admin-pagination__info">
        {{ (posts.currentPageNumber - 1) * posts.itemNumberPerPage + 1 }} - {{ min(posts.currentPageNumber * posts.itemNumberPerPage, posts.totalItemCount) }} sur {{ posts.totalItemCount }}
    </div>
    <div class="admin-pagination__pages">
        {% if posts.currentPageNumber > 1 %}
        <a href="{{ path('admin_forum', {page: posts.currentPageNumber - 1, q: q, status: status, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-left"></i></a>
        {% endif %}
        {% for page in posts.paginationData.pagesInRange %}
            {% if page == posts.currentPageNumber %}
                <span class="admin-pagination__current">{{ page }}</span>
            {% else %}
                <a href="{{ path('admin_forum', {page: page, q: q, status: status, tri: tri|default('recent')}) }}" class="admin-pagination__btn">{{ page }}</a>
            {% endif %}
        {% endfor %}
        {% if posts.currentPageNumber < posts.pageCount %}
        <a href="{{ path('admin_forum', {page: posts.currentPageNumber + 1, q: q, status: status, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-right"></i></a>
        {% endif %}
    </div>
</div>
{% endif %}
{% endblock %}
{% block javascripts %}
<script>
function moderate(id, status) {
    $.post('{{ path("admin_forum_moderate", {"id": "__ID__"}) }}'.replace('__ID__', id), {status})
     .done(()=>{ showToast('✅ Post modéré !'); setTimeout(()=>location.reload(),900); })
     .fail(()=>showToast('Erreur','error'));
}
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
        filterForm.querySelectorAll('[data-auto-submit]').forEach(el => {
            let timeout;
            el.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => filterForm.submit(), 600);
            });
            el.addEventListener('change', () => filterForm.submit());
        });
    }
});
</script>
{% endblock %}
