        </div>
    </div>
    <div style="background:linear-gradient(135deg,var(--gold),#d4a017);padding:1.5rem;border-radius:16px;color:#fff">
        <div style="font-size:0.8rem;opacity:0.8;margin-bottom:0.5rem">Revenus ce mois</div>
        <div style="font-size:2.5rem;font-weight:800">{{ monthlyRevenue|default(0)|number_format(0, '', ' ') }}</div>
        <div style="font-size:0.8rem;opacity:0.9;margin-top:0.5rem">TND</div>
    </div>
    <div style="background:linear-gradient(135deg,var(--cyan),#0099b8);padding:1.5rem;border-radius:16px;color:#fff">
        <div style="font-size:0.8rem;opacity:0.8;margin-bottom:0.5rem">Vues totales</div>
        <div style="font-size:2.5rem;font-weight:800">{{ totalViews|default(12500) }}</div>
        <div style="font-size:0.8rem;opacity:0.9;margin-top:0.5rem">pages vues</div>
    </div>
    <div style="background:linear-gradient(135deg,#10b981,#059669);padding:1.5rem;border-radius:16px;color:#fff">
        <div style="font-size:0.8rem;opacity:0.8;margin-bottom:0.5rem">Croissance</div>
        <div style="font-size:2.5rem;font-weight:800">+{{ growthRate|default(12) }}%</div>
        <div style="font-size:0.8rem;opacity:0.9;margin-top:0.5rem">vs période précédente</div>
    </div>
</div>

{# Circuits les plus vendus #}
<div class="section-divider"><span>🏆 Circuits les plus vendus</span></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1rem;margin-bottom:2rem">
    <div style="background:#fff;padding:1.25rem;border-radius:12px;border:1px solid var(--border)">
        <table style="width:100%;font-size:0.85rem">
            <thead>
                <tr style="border-bottom:1px solid var(--border)">
                    <th style="text-align:left;padding:0.5rem;color:var(--muted)">Circuit</th>
                    <th style="text-align:center;padding:0.5rem;color:var(--muted)">Ventes</th>
                    <th style="text-align:right;padding:0.5rem;color:var(--muted)">Revenu</th>
                </tr>
            </thead>
            <tbody>
                {% for circuit in topSellingCircuits|default([]) %}
                <tr style="border-bottom:1px solid var(--border)">
                    <td style="padding:0.5rem;font-weight:600">{{ circuit.name|default('Circuit #' ~ circuit.id) }}</td>
                    <td style="text-align:center;padding:0.5rem">
                        <span style="background:var(--cyan);color:#fff;padding:2px 8px;border-radius:10px;font-size:0.7rem">{{ circuit.count|default(0) }}</span>
                    </td>
                    <td style="text-align:right;padding:0.5rem;color:var(--gold);font-weight:700">{{ circuit.revenue|default(0)|number_format(0, '', ' ') }} TND</td>
                </tr>
                {% else %}
                <tr><td colspan="3" style="text-align:center;padding:1rem;color:var(--muted)">Aucune donnée</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div style="background:#fff;padding:1.25rem;border-radius:12px;border:1px solid var(--border)" id="topCircuitsChart">
        <div style="height:200px;display:flex;align-items:flex-end;justify-content:space-around;gap:0.5rem;padding:1rem 0">
            {% for circuit in topSellingCircuits|default([])|slice(0,5) %}
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:0.25rem">
                <div style="width:100%;background:linear-gradient(to top, var(--navy), var(--cyan));border-radius:4px 4px 0 0;height:{{ (circuit.revenue / max(topSellingCircuits[0].revenue|default(1), 1) * 150)|round }}px"></div>
                <span style="font-size:0.6rem;color:var(--muted);text-align:center;max-width:60px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ circuit.name|default('Circuit')|slice(0,10) }}</span>
            </div>
