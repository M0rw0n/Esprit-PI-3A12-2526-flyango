{# Destinations tendances #}
<div class="section-divider"><span>🗺️ Destinations tendances</span></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:2rem">
    {% for dest in trendingDestinations|default([]) %}
    <div style="background:#fff;padding:1rem;border-radius:12px;border:1px solid var(--border);display:flex;align-items:center;gap:1rem">
        <div style="width:40px;height:40px;background:linear-gradient(135deg,var(--navy),var(--cyan));border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:1rem">
            <i class="fa fa-map-marker"></i>
        </div>
        <div style="flex:1">
            <div style="font-weight:700;color:var(--text)">{{ dest.city }}</div>
            <div style="font-size:0.75rem;color:var(--muted)">{{ dest.count }} réservations</div>
        </div>
        <div style="background:var(--gold);color:#fff;padding:2px 8px;border-radius:10px;font-size:0.7rem;font-weight:700">{{ dest.percentage }}%</div>
    </div>
    {% else %}
    <div style="grid-column:1/-1;background:#fff;padding:2rem;border-radius:12px;text-align:center;color:var(--muted)">
        <i class="fa fa-map" style="font-size:2rem;margin-bottom:1rem"></i>
        <p>Aucune destination trendante</p>
    </div>
    {% endfor %}
</div>

{# Revenue Forecasting #}
<div class="section-divider"><span>📈 Prévision revenus (6 mois)</span></div>
<div style="background:#fff;padding:1.5rem;border-radius:12px;border:1px solid var(--border);margin-bottom:2rem">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
        <div>
            <span style="font-weight:700;color:var(--text)">Prochaine période</span>
            <span style="background:var(--green);color:#fff;padding:2px 8px;border-radius:8px;font-size:0.7rem;margin-left:0.5rem">+{{ forecastGrowth|default(8) }}% prévu</span>
        </div>
        <div style="display:flex;gap:1rem;font-size:0.75rem">
            <span style="display:flex;align-items:center;gap:0.25rem"><span style="width:12px;height:12px;background:var(--navy);border-radius:2px"></span> Historique</span>
            <span style="display:flex;align-items:center;gap:0.25rem"><span style="width:12px;height:12px;background:var(--gold);border-radius:2px"></span> Prévision</span>
        </div>
    </div>
    <div style="height:150px;display:flex;align-items:flex-end;gap:0.5rem;padding:0 1rem">
        {% for month in revenueForecast|default([]) %}
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:0.25rem">
            <div style="width:100%;background:{{ month.historical ? 'var(--navy)' : 'var(--gold)' }};border-radius:4px 4px 0 0;height:{{ (month.predicted / max(revenueForecast[0].predicted|default(1), 1) * 120)|round }}px;opacity:{{ month.historical ? 1 : 0.7 }}"></div>
            <span style="font-size:0.6rem;color:var(--muted)">{{ month.label }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
// Charts data from backend
const revenusData = {
    labels: [{% for r in revenusParMois %}'{{ ["Jan","Fév","Mar","Avr","Mai","Jun","Jul","Aoû","Sep","Oct","Nov","Déc"][r.mois - 1] }} {{ r.annee }}'{{ not loop.last ? ',' }}{% endfor %}],
    values: [{% for r in revenusParMois %}{{ r.total|default(0) }}{{ not loop.last ? ',' }}{% endfor %}]
};
const villesData = {
    labels: [{% for v in occParVille %}'{{ v.ville }}'{{ not loop.last ? ',' }}{% endfor %}],
    values: [{% for v in occParVille %}{{ v.total }}{{ not loop.last ? ',' }}{% endfor %}]
};
document.addEventListener('DOMContentLoaded', () => initDashboardCharts(revenusData, villesData));

function changeStatutRes(id, statut) {
    if (!confirm('Changer le statut ?')) return;
    $.post('{{ path("admin_reservation_statut", {"id": "__ID__"}) }}'.replace('__ID__', id), {statut: statut})
     .done(() => { showToast('✅ Statut mis à jour !'); setTimeout(() => location.reload(), 1000); })
     .fail(() => showToast('Erreur', 'error'));
}
function moderatePost(id, status) {
    if (!confirm('Modérer ce post ?')) return;
    $.post('{{ path("admin_forum_moderate", {"id": "__ID__"}) }}'.replace('__ID__', id), {status: status})
     .done(() => { showToast('✅ Post modéré !'); setTimeout(() => location.reload(), 1000); })
     .fail(() => showToast('Erreur', 'error'));
}
</script>
{% endblock %}
