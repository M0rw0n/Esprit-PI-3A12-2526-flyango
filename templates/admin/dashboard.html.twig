{% extends 'admin/layout.html.twig' %}
{% block title %}Tableau de bord — Fly&Go Admin{% endblock %}
{% block breadcrumb %}Tableau de bord{% endblock %}

{% block admin_body %}
<style>
.dash-header {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-dd) 100%);
    border-radius: var(--r-lg);
    padding: 2rem 2.5rem;
    margin-bottom: 2rem;
    color: #fff;
    position: relative;
    overflow: hidden;
}
.dash-header::before {
    content: '';
    position: absolute;
    right: -50px;
    top: -50px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255,183,0,0.15) 0%, transparent 70%);
    border-radius: 50%;
}
.dash-header h1 {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
}
.dash-header p {
    opacity: 0.75;
    font-size: 0.95rem;
}
.dash-header__meta {
    display: flex;
    gap: 2rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
}
.dash-header__meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    opacity: 0.85;
}
.dash-header__meta-item i {
    color: var(--gold);
}
.stat-highlight {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255,183,0,0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--gold);
}
.kpi-card {
    background: var(--card);
    border-radius: var(--r);
    padding: 1.5rem;
    border: 1px solid var(--border);
    box-shadow: var(--s1);
    transition: all var(--t);
    position: relative;
    overflow: hidden;
}
.kpi-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--s3);
}
.kpi-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
}
.kpi-card__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--r-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}
.kpi-card__icon--navy { background: rgba(27,58,107,0.1); color: var(--navy); }
.kpi-card__icon--gold { background: rgba(255,183,0,0.12); color: var(--gold-d); }
.kpi-card__icon--cyan { background: rgba(0,180,216,0.1); color: var(--cyan-d); }
.kpi-card__icon--green { background: rgba(16,185,129,0.1); color: var(--green); }
.kpi-card__icon--red { background: rgba(239,68,68,0.1); color: var(--red); }
.kpi-card__value {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1;
    margin-bottom: 0.5rem;
}
.kpi-card__label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.75rem;
}
.kpi-card__trend {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
}
.kpi-card__trend--up { color: var(--green); }
.kpi-card__trend--down { color: var(--red); }
.kpi-card__bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--bg);
}
.kpi-card__bar-fill {
    height: 100%;
    border-radius: 0 4px 4px 0;
    transition: width 1s ease;
}
.admin-chart-card {
    background: var(--card);
    border-radius: var(--r);
    border: 1px solid var(--border);
    box-shadow: var(--s1);
    overflow: hidden;
}
.admin-chart-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
}
.admin-chart-card__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.admin-chart-card__title i { color: var(--navy); }
.admin-chart-card__body { padding: 1.5rem; }
.activity-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
}
.activity-item:hover { background: var(--bg); }
.activity-item:last-child { border-bottom: none; }
.activity-item__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: #fff;
    font-size: 0.95rem;
    flex-shrink: 0;
}
.activity-item__content { flex: 1; min-width: 0; }
.activity-item__title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.activity-item__meta {
    font-size: 0.78rem;
    color: var(--muted);
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}
.activity-item__meta span { display: flex; align-items: center; gap: 0.3rem; }
.quick-action-btn {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--text);
    transition: all var(--t);
    margin-bottom: 0.75rem;
}
.quick-action-btn:hover {
    border-color: var(--navy);
    background: #fff;
    transform: translateX(4px);
    box-shadow: var(--s2);
}
.quick-action-btn__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--r-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
}
.quick-action-btn__text { flex: 1; }
.quick-action-btn__title {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.15rem;
}
.quick-action-btn__desc { font-size: 0.75rem; color: var(--muted); }
.quick-action-btn__arrow { color: var(--border); }
.alert-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0 0.4rem;
}
.alert-badge--warning { background: #fef3c7; color: #92400e; }
.alert-badge--danger { background: #fee2e2; color: #991b1b; }
.alert-badge--success { background: #d1fae5; color: #065f46; }
.section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 1.5rem;
}
.section-divider::before,
.section-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
}
.section-divider span {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
}
</style>

