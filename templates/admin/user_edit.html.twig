{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier l'utilisateur - Fly&Go Admin{% endblock %}
{% block breadcrumb %}Modifier{% endblock %}

{% block admin_body %}
<div style="max-width:600px;margin:0 auto;padding:2rem 0">
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem">
        <a href="{{ path('admin_users') }}" style="color:var(--navy);font-size:1.5rem">
            <i class="fa fa-arrow-left"></i>
        </a>
        <h1 style="font-size:1.5rem;font-weight:800;margin:0">Modifier l'utilisateur</h1>
    </div>

    {% for flash in app.flashes('success') %}
        <div style="background:#d4edda;color:#155724;padding:1rem;border-radius:8px;margin-bottom:1rem">
            {{ flash }}
        </div>
    {% endfor %}

    <form method="POST" action="{{ path('admin_user_edit', {id: user.id}) }}" style="background:var(--card-bg);border-radius:12px;padding:2rem;box-shadow:0 2px 8px rgba(0,0,0,0.08)" onsubmit="return validateAdminUserForm()">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem">
            <div>
                <label style="display:block;font-weight:600;margin-bottom:.5rem;color:var(--text)">Prénom *</label>
                <input type="text" name="prenom" id="prenom" value="{{ user.prenom }}" required minlength="2" maxlength="50" pattern="[A-Za-zÀ-ÿ\s\-]+"
                    style="width:100%;padding:.75rem;border:1px solid #ddd;border-radius:8px;font-size:1rem">
            </div>
            <div>
                <label style="display:block;font-weight:600;margin-bottom:.5rem;color:var(--text)">Nom *</label>
                <input type="text" name="nom" id="nom" value="{{ user.nom }}" required minlength="2" maxlength="50" pattern="[A-Za-zÀ-ÿ\s\-]+"
                    style="width:100%;padding:.75rem;border:1px solid #ddd;border-radius:8px;font-size:1rem">
            </div>
        </div>

        <div style="margin-bottom:1.5rem">
            <label style="display:block;font-weight:600;margin-bottom:.5rem;color:var(--text)">Email *</label>
            <input type="email" name="email" id="email" value="{{ user.email }}" required
                style="width:100%;padding:.75rem;border:1px solid #ddd;border-radius:8px;font-size:1rem">
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem">
            <div>
                <label style="display:block;font-weight:600;margin-bottom:.5rem;color:var(--text)">Téléphone</label>
                <input type="tel" name="telephone" id="telephone" value="{{ user.telephone|default('') }}" placeholder="+216 XX XXX XXX" pattern="[+]?[0-9\s]{8,15}"
                    style="width:100%;padding:.75rem;border:1px solid #ddd;border-radius:8px;font-size:1rem">
            </div>
            <div>
                <label style="display:block;font-weight:600;margin-bottom:.5rem;color:var(--text)">Rôle *</label>
                <select name="role" required style="width:100%;padding:.75rem;border:1px solid #ddd;border-radius:8px;font-size:1rem">
                    <option value="ROLE_USER" {{ user.role == 'ROLE_USER' ? 'selected' : '' }}>Utilisateur</option>
                    <option value="ROLE_ADMIN" {{ user.role == 'ROLE_ADMIN' ? 'selected' : '' }}>Administrateur</option>
                </select>
            </div>
        </div>

        <div style="display:flex;gap:1rem;justify-content:flex-end">
            <a href="{{ path('admin_users') }}" class="btn" style="background:#e9ecef;color:#495057;padding:.75rem 1.5rem;border-radius:8px;text-decoration:none">
                Annuler
            </a>
            <button type="submit" class="btn btn-navy" style="padding:.75rem 1.5rem;border:none;border-radius:8px;color:#fff;cursor:pointer">
                <i class="fa fa-save"></i> Enregistrer
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
<script>
function validateAdminUserForm() {
    let valid = true;
    const errors = [];
    
    const prenom = document.getElementById('prenom').value.trim();
    const nom = document.getElementById('nom').value.trim();
    const email = document.getElementById('email').value.trim();
    const telephone = document.getElementById('telephone').value.trim();
    
    if (prenom.length < 2) {
        errors.push('Le prénom doit contenir au moins 2 caractères');
        valid = false;
    }
    
    if (nom.length < 2) {
        errors.push('Le nom doit contenir au moins 2 caractères');
        valid = false;
    }
    
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        errors.push('Veuillez entrer une adresse email valide');
        valid = false;
    }
    
    if (telephone && !/^[+]?[0-9\s]{8,15}$/.test(telephone)) {
        errors.push('Le numéro de téléphone n\'est pas valide');
        valid = false;
    }
    
    if (!valid) {
        alert(errors.join('\n'));
    }
    
    return valid;
}

document.getElementById('prenom')?.addEventListener('input', function() {
    this.value = this.value.replace(/[^A-Za-zÀ-ÿ\s\-]/g, '');
});

document.getElementById('nom')?.addEventListener('input', function() {
    this.value = this.value.replace(/[^A-Za-zÀ-ÿ\s\-]/g, '');
});
</script>
{% endblock %}
