        <a href="{{ path('admin_transports') }}" style="font-size:.85rem;color:var(--muted)"><i class="fa fa-arrow-left"></i> Retour</a>
    </div>
    <form action="{{ transport ? path('admin_transport_edit', {id: transport.id}) : path('admin_transport_new') }}" method="POST" enctype="multipart/form-data" onsubmit="return validateTransportForm()">
        <div class="form-sec">
            <div class="form-sec__title"><i class="fa fa-info-circle"></i> Informations du transport</div>
            <div class="fgrid">
