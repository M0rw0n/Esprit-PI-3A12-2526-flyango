{% extends 'admin/layout.html.twig' %}
{% block title %}{{ hebergement ? 'Modifier' : 'Nouvel' }} hébergement — Admin{% endblock %}
{% block breadcrumb %}{{ hebergement ? 'Modifier hébergement' : 'Nouvel hébergement' }}{% endblock %}
{% block admin_body %}
<div class="form-wrap">
    <div style="margin-bottom:1.5rem">
        <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:.2rem">
            {{ hebergement ? '✏️ Modifier : ' ~ hebergement.nom : '➕ Nouvel hébergement' }}
        </h2>
        <a href="{{ path('admin_hebergements') }}" style="font-size:.85rem;color:var(--muted)"><i class="fa fa-arrow-left"></i> Retour</a>
    </div>

    <form action="{{ hebergement ? path('admin_hebergement_edit', {id: hebergement.id}) : path('admin_hebergement_new') }}" method="POST" enctype="multipart/form-data">
        <div class="form-sec">
            <div class="form-sec__title"><i class="fa fa-info-circle"></i> Informations générales</div>
            <div class="fgrid">
                <div class="ffield fgrid--full">
                    <label>Nom de l'hébergement <span class="required">*</span></label>
                    <input type="text" name="nom" id="nom" class="ffield input" value="{{ hebergement ? hebergement.nom : '' }}" placeholder="Ex: Hôtel Sidi Bou Said Palace">
                    <span class="fhint" id="nomHint">3-150 caractères</span>
                </div>
                <div class="ffield">
                    <label>Ville <span class="required">*</span></label>
                    <input type="text" name="ville" id="ville" value="{{ hebergement ? hebergement.ville : '' }}" placeholder="Ex: Tunis, Djerba...">
                    <span class="fhint" id="villeHint">2-100 caractères</span>
                </div>
                <div class="ffield">
                    <label>Type <span class="required">*</span></label>
                    <select name="type" id="type">
                        <option value="">-- Choisir --</option>
                        {% for t in ['Hôtel', 'Appartement', 'Villa', 'Riad', 'Resort', 'Maison d\'hôtes', 'Auberge'] %}
                        <option value="{{ t }}" {{ hebergement and hebergement.type == t ? 'selected' : '' }}>{{ t }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="ffield">
                    <label>Prix par nuit (TND) <span class="required">*</span></label>
                    <input type="number" name="prix_par_nuit" id="prixParNuit" step="0.001" value="{{ hebergement ? hebergement.prixParNuit : '' }}" placeholder="150.000">
                    <span class="fhint">Entre 0 et 10 000 TND</span>
                </div>
                <div class="ffield">
                    <label>Capacité (personnes)</label>
                    <input type="number" name="capacite" id="capacite" value="{{ hebergement ? hebergement.capacite : '' }}" placeholder="2">
                    <span class="fhint">Entre 1 et 50 personnes</span>
                </div>
                <div class="ffield fgrid--full">
                    <label>Adresse complète <span class="required">*</span></label>
                    <input type="text" name="adresse" id="adresse" value="{{ hebergement ? hebergement.adresse : '' }}" placeholder="Rue, quartier, ville...">
                    <span class="fhint">5-200 caractères</span>
                </div>
                <div class="ffield fgrid--full">
                    <label>Description</label>
                    <textarea name="description" id="description" rows="5" placeholder="Décrivez cet hébergement...">{{ hebergement ? hebergement.description : '' }}</textarea>
                    <span class="fhint">Maximum 1000 caractères</span>
                </div>
                <div class="ffield">
                    <label>Disponible</label>
                    <select name="disponible">
                        <option value="1" {{ (hebergement and hebergement.disponible) or (not hebergement) ? 'selected' : '' }}>Oui - Disponible</option>
                        <option value="0" {{ hebergement and not hebergement.disponible ? 'selected' : '' }}>Non - Indisponible</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-sec">
            <div class="form-sec__title"><i class="fa fa-image"></i> Image principale</div>
            {% if hebergement and hebergement.image %}
            <div class="img-prev" id="currentImagePreview">
                <img src="{{ asset(hebergement.image) }}?v={{ date().timestamp }}" alt="{{ hebergement.nom }}">
            </div>
            {% endif %}
            <div class="ffield">
                <label>Image actuelle (conserver)</label>
                <select name="existing_image" id="existingImage" onchange="updateImagePreview(this.value)">
                    <option value="">-- Choisir une autre image --</option>
                    {% if hebergement and hebergement.image %}
                    <option value="{{ hebergement.image }}" selected>Image actuelle</option>
                    {% endif %}
                </select>
            </div>
            <div class="ffield">
                <label>Ou glisser-déposer une nouvelle image</label>
                <div class="dropzone" id="mainImageDropzone">
                    <div class="dropzone-content">
                        <i class="fa fa-cloud-upload-alt" style="font-size:2rem;margin-bottom:.5rem;color:var(--muted)"></i>
                        <p style="margin:.25rem 0"><strong>Glissez-déposez</strong> ou cliquez</p>
                        <p style="font-size:.8rem;color:var(--muted)">JPG, PNG, WebP — Max 5MB</p>
                    </div>
                    <input type="file" name="image" id="imageInput" accept="image/jpeg,image/png,image/webp" style="display:none">
                </div>
                <div id="mainImagePreview" class="preview-container" style="display:none">
                    <div class="preview-item">
                        <img src="" alt="Aperçu">
                        <button type="button" class="remove-btn" onclick="removeMainImage()"><i class="fa fa-times"></i></button>
                    </div>
                </div>
                <div id="imageError" class="error-msg" style="display:none"></div>
            </div>
        </div>

        <div class="form-sec">
            <div class="form-sec__title"><i class="fa fa-images"></i> Galerie photos</div>
            <div class="ffield">
                <label>Glisser-déposer jusqu'à 10 photos</label>
                <div class="dropzone dropzone-multiple" id="galerieDropzone" data-max="10">
                    <div class="dropzone-content">
                        <i class="fa fa-cloud-upload-alt" style="font-size:2rem;margin-bottom:.5rem;color:var(--muted)"></i>
                        <p style="margin:.25rem 0"><strong>Glissez-déposez</strong> vos images</p>
                        <p style="font-size:.8rem;color:var(--muted)">JPG, PNG, WebP — Max 5MB par image — Maximum 10 images</p>
                    </div>
                    <input type="file" name="galerie_photos[]" id="galeriePhotos" accept="image/jpeg,image/png,image/webp" multiple style="display:none">
                </div>
                <div id="galeriePreview" class="preview-grid" style="display:none"></div>
                <div id="galerieError" class="error-msg" style="display:none"></div>
            </div>
            {% if hebergement and hebergement.galeriePhotos|length > 0 %}
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem">
                {% for photo in hebergement.galeriePhotos %}
                <div style="position:relative;width:100px;height:100px" class="gallery-item">
                    <img src="{{ asset(photo) }}" style="width:100%;height:100%;object-fit:cover;border-radius:8px">
                    <button type="button" class="delete-gallery-photo" onclick="deleteGaleriePhoto('{{ photo }}', this)"
                            style="position:absolute;top:-5px;right:-5px;background:var(--red);color:#fff;border:none;width:20px;height:20px;border-radius:50%;cursor:pointer;font-size:10px">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                {% endfor %}
            </div>
            <input type="hidden" name="galerie_to_delete" id="galerieToDelete" value="">
            {% endif %}
        </div>

        <div class="form-sec">
            <div class="form-sec__title"><i class="fa fa-vr-cardboard"></i> Photos 360°</div>
            <p style="font-size:.85rem;color:var(--muted);margin-bottom:1rem">Ajoutez des photos 360° pour permettre aux clients de explorer virtuellement les lieux</p>
            
            <label>Glisser-déporter des images 360°</label>
            <div class="dropzone dropzone-360" id="dropzone360" data-max="10">
                <div class="dropzone-content">
                    <i class="fa fa-vr-cardboard" style="font-size:2rem;margin-bottom:.5rem;color:var(--muted)"></i>
                    <p style="margin:.25rem 0"><strong>Glissez-déposez</strong> vos images 360°</p>
                    <p style="font-size:.8rem;color:var(--muted)">JPG, PNG — Max 10 photos</p>
                </div>
                <input type="file" name="photos_360[]" id="photos360Input" accept="image/jpeg,image/png" multiple style="display:none">
            </div>
            
            <div id="photos360Preview" class="preview-grid" style="display:none;margin-top:1rem"></div>
            <div id="photos360Error" class="error-msg" style="display:none"></div>
            
            {% if hebergement and hebergement.photos360|length > 0 %}
            <p style="font-weight:600;margin:1rem 0 .5rem">Photos existantes:</p>
            <div class="preview-grid">
                {% for photo in hebergement.photos360 %}
                <div class="preview-item" data-photo="{{ photo }}">
                    <img src="{{ photo }}" alt="360°">
                    <button type="button" class="remove-btn" onclick="remove360Photo('{{ photo }}', this)"><i class="fa fa-times"></i></button>
                </div>
                {% endfor %}
            </div>
            <input type="hidden" name="photos360_to_delete" id="photos360ToDelete" value="">
            {% endif %}
        </div>

        <div class="form-sec">
            <div class="form-sec__title"><i class="fa fa-map-marker"></i> Localisation</div>
            <div class="fgrid">
                <div class="ffield fgrid--full">
                    <label>Adresse (pour géocodage)</label>
                    <div style="display:flex;gap:.5rem">
                        <input type="text" name="adresse" id="adresse" value="{{ hebergement ? hebergement.adresse : '' }}" required minlength="5" maxlength="200" placeholder="Rue, quartier, ville..." style="flex:1">
                        <button type="button" class="btn btn-cyan" onclick="geocodeAddress()"><i class="fa fa-crosshairs"></i> Localiser</button>
                    </div>
                    <span class="fhint">Cliquez sur "Localiser" pour obtenir automatiquement les coordonnées</span>
                </div>
                <div class="ffield">
                    <label>Latitude</label>
                    <input type="number" step="0.000001" name="latitude" id="latitude" value="{{ hebergement ? hebergement.latitude : '' }}" placeholder="36.806496">
                </div>
                <div class="ffield">
                    <label>Longitude</label>
                    <input type="number" step="0.000001" name="longitude" id="longitude" value="{{ hebergement ? hebergement.longitude : '' }}" placeholder="10.181532">
                </div>
                <div class="ffield">
                    <label>Chambres disponibles</label>
                    <input type="number" name="chambres_disponibles" min="0" value="{{ hebergement ? (hebergement.chambresDisponibles ?: 1) : 1 }}">
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-navy btn-lg"><i class="fa fa-save"></i> {{ hebergement ? 'Mettre à jour' : 'Créer l\'hébergement' }}</button>
            <a href="{{ path('admin_hebergements') }}" class="btn btn-outline">Annuler</a>
        </div>
    </form>
</div>

<script>
function updateImagePreview(imagePath) {
    const preview = document.getElementById('currentImagePreview');
    if (imagePath && preview) {
        preview.querySelector('img').src = '{{ asset('') }}' + imagePath + '?v=' + Date.now();
    }
}

async function geocodeAddress() {
    const address = document.getElementById('adresse')?.value;
    const ville = document.getElementById('ville')?.value;
    const fullAddress = address && ville ? address + ', ' + ville + ', Tunisia' : address;
    
    if (!fullAddress) {
        alert('Veuillez entrer une adresse');
        return;
    }
    
    try {
        const response = await fetch('{{ path("admin_geocode") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'address=' + encodeURIComponent(fullAddress)
        });
        
        const data = await response.json();
        
        if (data.error) {
            alert('Localisation non trouvée: ' + data.error);
        } else {
            document.getElementById('latitude').value = data.latitude;
            document.getElementById('longitude').value = data.longitude;
            alert('Coordonnées trouvées! ' + data.latitude.toFixed(4) + ', ' + data.longitude.toFixed(4));
        }
    } catch (e) {
        alert('Erreur lors de la géolocalisation');
    }
}

function deleteGaleriePhoto(photo, btn) {
    if (!confirm('Supprimer cette photo?')) return;
    
    const input = document.getElementById('galerieToDelete');
    const current = input.value ? input.value.split(',') : [];
    current.push(photo);
    input.value = current.join(',');
    
    btn.closest('.gallery-item').remove();
    
    const remaining = document.querySelectorAll('.gallery-item');
    if (remaining.length === 0) {
        const container = input.closest('div');
        if (container) container.style.display = 'none';
    }
}

function previewGalerieMultiple(input) {
    const preview = document.getElementById('imagePreview');
    if (!input.files || input.files.length === 0) return;
    
    let html = '<div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem">';
    for (let i = 0; i < Math.min(input.files.length, 10); i++) {
        const file = input.files[i];
        if (file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.querySelector('[data-preview-id="' + input.id + '"]');
                if (img) img.src = e.target.result;
            };
            reader.readAsDataURL(file);
            html += '<img data-preview-id="' + input.id + '" src="" style="width:80px;height:80px;object-fit:cover;border-radius:8px;background:var(--bg)">';
        }
    }
    html += '</div>';
    
    if (preview) {
        preview.innerHTML = html;
        preview.style.display = 'block';
    }
}

// Dropzone pour image principale
const mainDropzone = document.getElementById('mainImageDropzone');
const mainInput = document.getElementById('imageInput');
const mainPreview = document.getElementById('mainImagePreview');
const mainError = document.getElementById('imageError');

if (mainDropzone) {
    mainDropzone.addEventListener('click', function() { mainInput.click(); });
    
    mainDropzone.addEventListener('dragover', function(e) {
        e.preventDefault();
        mainDropzone.classList.add('dragover');
    });
    
    mainDropzone.addEventListener('dragleave', function() {
        mainDropzone.classList.remove('dragover');
    });
    
    mainDropzone.addEventListener('drop', function(e) {
        e.preventDefault();
        mainDropzone.classList.remove('dragover');
        const files = e.dataTransfer.files;
        if (files.length > 0) handleMainFile(files[0]);
    });
    
    mainInput.addEventListener('change', function() {
        if (this.files.length > 0) handleMainFile(this.files[0]);
    });
}

function handleMainFile(file) {
    mainError.style.display = 'none';
    
    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
        showError(mainError, 'Format non autorisé. Utilisez JPG, PNG ou WebP.');
        return;
    }
    
    if (file.size > 5 * 1024 * 1024) {
        showError(mainError, 'Fichier trop lourd. Maximum 5MB.');
        return;
    }
    
    const reader = new FileReader();
    reader.onload = function(e) {
        mainPreview.querySelector('img').src = e.target.result;
        mainPreview.style.display = 'block';
        mainDropzone.style.display = 'none';
    };
    reader.readAsDataURL(file);
}

function removeMainImage() {
    mainInput.value = '';
    mainPreview.style.display = 'none';
    mainDropzone.style.display = 'block';
}

// Dropzone pour galerie
const galerieDropzone = document.getElementById('galerieDropzone');
const galerieInput = document.getElementById('galeriePhotos');
const galeriePreview = document.getElementById('galeriePreview');
const galerieError = document.getElementById('galerieError');
let galerieFiles = [];

if (galerieDropzone) {
    const maxFiles = parseInt(galerieDropzone.dataset.max) || 10;
    
    galerieDropzone.addEventListener('click', function() { galerieInput.click(); });
    
    galerieDropzone.addEventListener('dragover', function(e) {
        e.preventDefault();
        galerieDropzone.classList.add('dragover');
    });
    
    galerieDropzone.addEventListener('dragleave', function() {
        galerieDropzone.classList.remove('dragover');
    });
    
    galerieDropzone.addEventListener('drop', function(e) {
        e.preventDefault();
        galerieDropzone.classList.remove('dragover');
        handleGalerieFiles(e.dataTransfer.files);
    });
    
    galerieInput.addEventListener('change', function() {
        handleGalerieFiles(this.files);
    });
}

function handleGalerieFiles(files) {
    const maxFiles = 10;
    const maxSize = 5 * 1024 * 1024;
    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
    
    let error = '';
    
    for (let i = 0; i < files.length; i++) {
        if (galerieFiles.length >= maxFiles) {
            error = 'Maximum ' + maxFiles + ' images autorisées.';
            break;
        }
        
        const file = files[i];
        
        if (!allowedTypes.includes(file.type)) {
            error = 'Format non autorisé: ' + file.name + '. Utilisez JPG, PNG ou WebP.';
            continue;
        }
        
        if (file.size > maxSize) {
            error = 'Fichier trop lourd: ' + file.name + '. Maximum 5MB.';
            continue;
        }
        
        galerieFiles.push(file);
        addGaleriePreview(file, galerieFiles.length - 1);
    }
    
    if (error) {
        showError(galerieError, error);
    } else {
        galerieError.style.display = 'none';
    }
    
    updateGalerieInput();
    galeriePreview.style.display = 'flex';
}

function addGaleriePreview(file, index) {
    const reader = new FileReader();
    reader.onload = function(e) {
        const div = document.createElement('div');
        div.className = 'preview-item';
        div.dataset.index = index;
        div.innerHTML = '<img src="' + e.target.result + '" alt=""><button type="button" class="remove-btn" onclick="removeGalerieImage(' + index + ', this)"><i class="fa fa-times"></i></button>';
        galeriePreview.appendChild(div);
    };
    reader.readAsDataURL(file);
}

function removeGalerieImage(index, btn) {
    galerieFiles.splice(index, 1);
    
    Array.from(galeriePreview.children).forEach(function(child, i) {
        child.dataset.index = i;
        child.querySelector('.remove-btn').setAttribute('onclick', 'removeGalerieImage(' + i + ', this)');
    });
    
    btn.closest('.preview-item').remove();
    
    if (galerieFiles.length === 0) {
        galeriePreview.style.display = 'none';
    }
    
    updateGalerieInput();
}

function updateGalerieInput() {
    const dt = new DataTransfer();
    galerieFiles.forEach(function(file) { dt.items.add(file); });
    galerieInput.files = dt.files;
}

function showError(el, msg) {
    el.textContent = msg;
    el.style.display = 'block';
}

// Dropzone pour photos 360°
const dropzone360 = document.getElementById('dropzone360');
const photos360Input = document.getElementById('photos360Input');
const photos360Preview = document.getElementById('photos360Preview');
const photos360Error = document.getElementById('photos360Error');
let photos360Files = [];

if (dropzone360) {
    dropzone360.addEventListener('click', function() { photos360Input.click(); });
    
    dropzone360.addEventListener('dragover', function(e) {
        e.preventDefault();
        dropzone360.classList.add('dragover');
    });
    
    dropzone360.addEventListener('dragleave', function() {
        dropzone360.classList.remove('dragover');
    });
    
    dropzone360.addEventListener('drop', function(e) {
        e.preventDefault();
        dropzone360.classList.remove('dragover');
        handle360Files(e.dataTransfer.files);
    });
    
    photos360Input.addEventListener('change', function() {
        handle360Files(this.files);
    });
}

function handle360Files(files) {
    const maxFiles = 10;
    const allowedTypes = ['image/jpeg', 'image/png'];
    
    for (let i = 0; i < files.length; i++) {
        if (photos360Files.length >= maxFiles) {
            showError(photos360Error, 'Maximum ' + maxFiles + ' photos.');
            break;
        }
        
        const file = files[i];
        if (!allowedTypes.includes(file.type)) {
            showError(photos360Error, 'Format NON autorisés. Utilisez JPG ou PNG.');
            continue;
        }
        
        photos360Files.push(file);
        add360Preview(file, photos360Files.length - 1);
    }
    
    photos360Error.style.display = 'none';
    photos360Preview.style.display = 'flex';
    update360Input();
}

function add360Preview(file, index) {
    const reader = new FileReader();
    reader.onload = function(e) {
        const div = document.createElement('div');
        div.className = 'preview-item';
        div.dataset.index = index;
        div.innerHTML = '<img src="' + e.target.result + '" alt="360°"><button type="button" class="remove-btn" onclick="remove360PhotoFile(' + index + ', this)"><i class="fa fa-times"></i></button>';
        photos360Preview.appendChild(div);
    };
    reader.readAsDataURL(file);
}

function remove360PhotoFile(index, btn) {
    photos360Files.splice(index, 1);
    Array.from(photos360Preview.children).forEach(function(child, i) {
        child.dataset.index = i;
        child.querySelector('.remove-btn').setAttribute('onclick', 'remove360PhotoFile(' + i + ', this)');
    });
    btn.closest('.preview-item').remove();
    
    if (photos360Files.length === 0) {
        photos360Preview.style.display = 'none';
    }
    update360Input();
}

function remove360Photo(photo, btn) {
    const input = document.getElementById('photos360ToDelete');
    if (input) {
        input.value = input.value ? input.value + ',' + photo : photo;
    }
    btn.closest('.preview-item').remove();
}

function update360Input() {
    const dt = new DataTransfer();
    photos360Files.forEach(function(file) { dt.items.add(file); });
    photos360Input.files = dt.files;
}
</script>

<style>
