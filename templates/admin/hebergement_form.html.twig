    border: 2px dashed var(--border);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    background: var(--bg);
}
.dropzone:hover, .dropzone.dragover {
    border-color: var(--primary);
    background: rgba(0,0,0,0.02);
}
.dropzone-content {
    pointer-events: none;
}
.preview-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
}
.preview-container {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
}
.preview-item {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg);
}
.preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.preview-item .remove-btn {
    position: absolute;
    top: 4px;
    right: 4px;
    background: #EF4444;
    color: white;
    border: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.error-msg {
    color: #EF4444;
    font-size: 0.85rem;
    margin-top: 0.5rem;
}

.dropzone-360 {
    border: 2px dashed var(--border);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    background: var(--bg);
}
.dropzone-360:hover, .dropzone-360.dragover {
    border-color: var(--primary);
    background: rgba(0,0,0,0.02);
}
.preview-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}
.preview-grid .preview-item {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg);
}
.preview-grid .preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.preview-grid .preview-item .remove-btn {
    position: absolute;
    top: 4px;
    right: 4px;
    background: #EF4444;
    color: white;
    border: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
