{% extends 'admin/layout.html.twig' %}
{% block title %}Circuits — Admin{% endblock %}
{% block breadcrumb %}Circuits{% endblock %}
{% block admin_body %}
{% set q = app.request.query.get('q', '') %}
{% set difficulte = app.request.query.get('difficulte', '') %}
{% set source = app.request.query.get('source', '') %}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
    <div>
        <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:.2rem">Gestion des circuits</h2>
        <p style="color:var(--muted);font-size:.85rem">{{ circuits.totalItemCount }} circuits</p>
    </div>
    <a href="{{ path('admin_circuit_new') }}" class="btn btn-navy"><i class="fa fa-plus"></i> Nouveau circuit</a>
</div>

<div class="admin-toolbar">
    <form method="GET" action="{{ path('admin_circuits') }}" id="filterForm">
        <div class="admin-toolbar__row">
            <div class="admin-toolbar__search">
                <i class="fa fa-search"></i>
                <input type="text" name="q" value="{{ q }}" placeholder="Rechercher un circuit..." data-auto-submit>
            </div>
            <div class="admin-toolbar__select">
                <select name="difficulte" data-auto-submit>
                    <option value="">Toutes difficultés</option>
                    <option value="Facile" {{ difficulte == 'Facile' ? 'selected' : '' }}>Facile</option>
                    <option value="Modéré" {{ difficulte == 'Modéré' ? 'selected' : '' }}>Modéré</option>
                    <option value="Difficile" {{ difficulte == 'Difficile' ? 'selected' : '' }}>Difficile</option>
                    <option value="Extrême" {{ difficulte == 'Extrême' ? 'selected' : '' }}>Extrême</option>
                </select>
            </div>
            <div class="admin-toolbar__select">
                <select name="source" data-auto-submit>
                    <option value="">Tous types</option>
                    <option value="admin" {{ source == 'admin' ? 'selected' : '' }}>Admin</option>
                    <option value="custom" {{ source == 'custom' ? 'selected' : '' }}>Personnalisé</option>
                </select>
            </div>
            <select name="tri" class="admin-toolbar__sort" data-auto-submit>
                <option value="recent" {{ tri|default('recent') == 'recent' ? 'selected' : '' }}>Plus récents</option>
                <option value="oldest" {{ tri|default('recent') == 'oldest' ? 'selected' : '' }}>Plus anciens</option>
                <option value="price_asc" {{ tri|default('recent') == 'price_asc' ? 'selected' : '' }}>Prix ↑</option>
                <option value="price_desc" {{ tri|default('recent') == 'price_desc' ? 'selected' : '' }}>Prix ↓</option>
            </select>
            {% if q or difficulte or source %}
            <a href="{{ path('admin_circuits') }}" class="btn btn-outline btn-sm"><i class="fa fa-times"></i></a>
            {% endif %}
        </div>
    </form>
</div>

<div class="admin-acts">
    {% for c in circuits %}
    <div class="adm-act">
        <div class="adm-act__img">
            {% if c.image %}<img src="{{ asset(c.image) }}" alt="{{ c.titre }}" onerror="this.src='https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=300&q=70'">
            {% else %}<div style="height:130px;background:var(--bg2);display:flex;align-items:center;justify-content:center"><i class="fa fa-route" style="font-size:2rem;color:var(--border)"></i></div>{% endif %}
            {% if c.isAiGenerated %}
            <span style="position:absolute;top:.5rem;left:.5rem;background:var(--gold);color:var(--navy-dd);font-size:.65rem;font-weight:800;padding:.2rem .5rem;border-radius:4px"><i class="fa fa-brain"></i> Personnalisé</span>
            {% endif %}
        </div>
        <div class="adm-act__body">
            <div class="adm-act__title">{{ c.titre }}</div>
            <div class="adm-act__meta">
                {% if c.destination %}<span><i class="fa fa-map-marker-alt" style="color:var(--cyan)"></i> {{ c.destination }}</span>{% endif %}
                {% if c.duree %}<span><i class="fa fa-clock"></i> {{ c.duree }}j</span>{% endif %}
                {% if c.difficulte %}
                <span class="diff-badge diff-badge--{{ c.difficulte|lower }}">{{ c.difficulte }}</span>
                {% endif %}
            </div>
            <div class="adm-act__foot">
                <div class="price price--sm">
                    <span class="price__val">{{ c.prix|number_format(3, ',', ' ') }}</span>
                    <span class="price__cur">TND</span>
                    <span class="price__per">/pers.</span>
                </div>
                <div class="adm-act__actions">
                    <a href="{{ path('circuit_show', {id: c.id}) }}" class="btn btn-outline btn-sm" target="_blank"><i class="fa fa-eye"></i></a>
                    <a href="{{ path('admin_circuit_edit', {id: c.id}) }}" class="btn btn-navy btn-sm"><i class="fa fa-edit"></i></a>
                    <form action="{{ path('admin_circuit_delete', {id: c.id}) }}" method="POST" onsubmit="return confirm('Supprimer ce circuit ?')">
                        <button type="submit" class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="empty" style="grid-column:1/-1"><i class="fa fa-route"></i><h3>Aucun circuit</h3>
        <a href="{{ path('admin_circuit_new') }}" class="btn btn-navy"><i class="fa fa-plus"></i> Créer</a>
    </div>
    {% endfor %}
</div>

{% if circuits.totalItemCount > circuits.itemNumberPerPage %}
<div class="admin-pagination">
    <div class="admin-pagination__info">
        {{ (circuits.currentPageNumber - 1) * circuits.itemNumberPerPage + 1 }} - {{ min(circuits.currentPageNumber * circuits.itemNumberPerPage, circuits.totalItemCount) }} sur {{ circuits.totalItemCount }}
    </div>
    <div class="admin-pagination__pages">
        {% if circuits.currentPageNumber > 1 %}
        <a href="{{ path('admin_circuits', {page: circuits.currentPageNumber - 1, q: q, difficulte: difficulte, source: source, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-left"></i></a>
        {% endif %}
        {% for page in circuits.paginationData.pagesInRange %}
            {% if page == circuits.currentPageNumber %}
                <span class="admin-pagination__current">{{ page }}</span>
            {% else %}
                <a href="{{ path('admin_circuits', {page: page, q: q, difficulte: difficulte, source: source, tri: tri|default('recent')}) }}" class="admin-pagination__btn">{{ page }}</a>
            {% endif %}
        {% endfor %}
        {% if circuits.currentPageNumber < circuits.pageCount %}
        <a href="{{ path('admin_circuits', {page: circuits.currentPageNumber + 1, q: q, difficulte: difficulte, source: source, tri: tri|default('recent')}) }}" class="admin-pagination__btn"><i class="fa fa-chevron-right"></i></a>
        {% endif %}
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    if (filterForm) {
        filterForm.querySelectorAll('[data-auto-submit]').forEach(el => {
            let timeout;
            el.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => filterForm.submit(), 600);
            });
            el.addEventListener('change', () => filterForm.submit());
        });
    }
});
</script>
{% endblock %}
