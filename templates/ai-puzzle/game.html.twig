        font-size: 0.84rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .pq-answer-box {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .pq-input {
        width: 100%;
        padding: 0.9rem 1rem;
        border-radius: 14px;
        border: 1px solid #cddcf1;
        background: #fff;
        color: var(--pq-text);
        font-size: 0.95rem;
        font-weight: 600;
        transition: border-color .18s ease, box-shadow .18s ease;
    }

    .pq-input:focus {
        outline: none;
        border-color: #5a8dff;
        box-shadow: 0 0 0 4px rgba(90, 141, 255, 0.14);
    }

    .pq-input:disabled {
        background: #f4f7fc;
        color: #9caec9;
        cursor: not-allowed;
    }

    .pq-message {
        display: none;
        border-radius: 14px;
        padding: 0.85rem 0.95rem;
        font-size: 0.88rem;
        font-weight: 700;
    }

    .pq-message.show { display: block; }
    .pq-message.success { background: #eafaf4; color: #0f7f58; border: 1px solid #b9efd5; }
    .pq-message.error { background: #fff0f0; color: #b42318; border: 1px solid #ffd0d0; }
    .pq-message.info { background: #eff6ff; color: #2350a3; border: 1px solid #cfe0ff; }

    .pq-footer-link {
        width: 100%;
    }

    .pq-overlay,
    .pq-modal {
        position: fixed;
        inset: 0;
