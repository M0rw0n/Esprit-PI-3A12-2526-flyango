        font-weight: 800;
    }

    .pq-tray-shell {
        position: relative;
        border-radius: 22px;
        padding: 0.9rem;
        background: linear-gradient(180deg, #f8fbff 0%, #eef5ff 100%);
        border: 1px solid #d8e6fb;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.92);
