<script>
const GAME_CONFIG = {
    destination: {{ destination|json_encode|raw }},
    grid: {{ gridSize|json_encode|raw }},
    timeLimit: {{ timeLimit }},
    difficulty: {{ difficulty|json_encode|raw }},
    baseScore: {{ difficulty == 'easy' ? 100 : difficulty == 'medium' ? 150 : 220 }}
};

class PassportQuestGame {
    constructor(config) {
        this.destination = config.destination;
        this.rows = config.grid.rows;
        this.cols = config.grid.cols;
        this.totalPieces = config.grid.total;
        this.timeLimit = config.timeLimit;
        this.baseScore = config.baseScore;
        this.difficulty = config.difficulty;

        this.board = document.getElementById('board-grid');
        this.tray = document.getElementById('pieces-tray');
        this.answerInput = document.getElementById('answer-input');
        this.answerBtn = document.getElementById('answer-btn');
        this.toast = document.getElementById('game-toast');
        this.timerBox = document.getElementById('timer-box');
        this.resultMsg = document.getElementById('result-msg');
        this.selectionHint = document.getElementById('selection-hint');

        this.image = new Image();
        this.image.crossOrigin = 'anonymous';
        this.pieces = [];
        this.slotElements = [];
        this.draggedPieceId = null;
        this.selectedPieceId = null;
        this.placedCount = 0;
        this.moves = 0;
        this.score = 0;
        this.timeLeft = this.timeLimit;
        this.gameCompleted = false;
        this.answerUnlocked = false;
        this.previewInterval = null;
        this.timerInterval = null;
        this.lockedPieceId = 0;
        this.toastTimeout = null;
        this.trayMode = 'mix';
        this.trayPositions = new Map();
        this.resizeTimer = null;
    }

    async init() {
        this.bindStaticEvents();
        await this.loadImage();
        this.createBoard();
        this.createPieces();
        this.renderTray();
        this.renderBoard();
        this.updateSelectedState();
        this.updateUI();
        this.startTimer();
        this.showMessage('Astuce : commencez par la pièce déjà placée puis reconstituez les bords.', 'info');
    }

    bindStaticEvents() {
        document.getElementById('hint-btn').addEventListener('click', () => this.openPreview());
        document.getElementById('shuffle-btn').addEventListener('click', () => this.shuffleTrayPieces());
        document.getElementById('reset-btn').addEventListener('click', () => this.restart());
        document.getElementById('close-preview-btn').addEventListener('click', () => this.closePreview());
        document.getElementById('preview-overlay').addEventListener('click', (event) => {
            if (event.target.id === 'preview-overlay') this.closePreview();
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') this.closePreview();
        });
        document.getElementById('play-again-btn').addEventListener('click', () => {
            document.getElementById('completion-modal').classList.remove('show');
            this.restart();
        });
        this.answerBtn.addEventListener('click', () => this.submitAnswer());
        this.answerInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') this.submitAnswer();
        });

        const remixBtn = document.getElementById('remix-btn');
        const tidyBtn = document.getElementById('tidy-btn');
        remixBtn?.addEventListener('click', () => this.setTrayMode('mix', true));
        tidyBtn?.addEventListener('click', () => {
            const nextMode = this.trayMode === 'tidy' ? 'mix' : 'tidy';
            this.setTrayMode(nextMode, true);
        });

        window.addEventListener('resize', () => {
            if (this.resizeTimer) window.clearTimeout(this.resizeTimer);
            this.resizeTimer = window.setTimeout(() => {
                this.renderTray();
                this.updateSelectedState();
            }, 120);
        });
    }

    loadImage() {
        return new Promise((resolve) => {
            const fallbackUrl = 'https://picsum.photos/900/900';
            const finalize = () => resolve();

            this.image.crossOrigin = 'anonymous';
            this.image.onload = finalize;
            this.image.onerror = () => {
                if (this.image.src !== fallbackUrl) {
                    this.image.src = fallbackUrl;
                } else {
                    finalize();
                }
            };
            this.image.src = this.destination.image || fallbackUrl;
        });
    }

    createBoard() {
        this.board.innerHTML = '';
        this.slotElements = [];

        for (let index = 0; index < this.totalPieces; index++) {
            const slot = document.createElement('div');
            slot.className = 'pq-slot';
            slot.dataset.slotId = String(index);
            slot.dataset.slotNumber = String(index + 1);
            slot.dataset.correctPiece = String(index);

            slot.addEventListener('dragover', (e) => {
                e.preventDefault();
                if (this.gameCompleted) return;
                slot.classList.add('is-active');
            });

            slot.addEventListener('dragleave', () => slot.classList.remove('is-active'));
            slot.addEventListener('drop', (e) => {
                e.preventDefault();
                slot.classList.remove('is-active');
                if (this.gameCompleted) return;
                const pieceId = Number(e.dataTransfer.getData('text/plain'));
                this.handleDrop(pieceId, index);
            });

            slot.addEventListener('click', () => {
                if (this.gameCompleted || this.selectedPieceId === null) return;
                this.handleDrop(this.selectedPieceId, index);
            });

            this.board.appendChild(slot);
            this.slotElements.push(slot);
        }
    }

    createPieces() {
        this.pieces = [];
        const lockedId = this.lockedPieceId;

        for (let index = 0; index < this.totalPieces; index++) {
            const row = Math.floor(index / this.cols);
            const col = index % this.cols;
            const edges = {
                t: row === 0 ? 0 : -this.pieces[index - this.cols].edges.b,
                l: col === 0 ? 0 : -this.pieces[index - 1].edges.r,
                r: col === this.cols - 1 ? 0 : (Math.random() > 0.5 ? 1 : -1),
                b: row === this.rows - 1 ? 0 : (Math.random() > 0.5 ? 1 : -1)
            };

            this.pieces.push({
                id: index,
                row,
                col,
                edges,
                placed: index === lockedId,
                locked: index === lockedId,
                inTray: index !== lockedId,
                element: null,
                slotElement: null
            });
        }

        this.placedCount = this.pieces.filter(piece => piece.placed).length;
    }

    renderBoard() {
        this.pieces.forEach((piece) => {
            const slot = this.slotElements[piece.id];
            slot.classList.toggle('is-correct', piece.placed);
            slot.classList.toggle('is-locked', piece.locked);
            slot.innerHTML = '';

            if (piece.placed) {
                const pieceEl = this.buildPieceElement(piece, false);
                pieceEl.classList.add('is-placed');
                if (piece.locked) pieceEl.classList.add('is-locked');
                slot.appendChild(pieceEl);
                piece.slotElement = pieceEl;
            } else {
                piece.slotElement = null;
            }
        });
    }

    renderTray(forceRemix = false) {
        this.tray.innerHTML = '';
        const trayPieces = this.pieces.filter(piece => !piece.placed);

        if (this.trayMode === 'tidy') {
            this.applyTidyLayout(trayPieces);
        } else {
            this.applyMixedLayout(trayPieces, forceRemix);
        }

        trayPieces.forEach((piece) => {
            const shell = document.createElement('div');
            const position = this.trayPositions.get(piece.id) || { x: 10, y: 40, rotation: 0, size: 112 };
            shell.className = 'pq-piece-cloud' + (this.selectedPieceId === piece.id ? ' is-selected' : '');
            if (this.trayMode === 'tidy') shell.classList.add('is-tidy');
            shell.dataset.pieceId = String(piece.id);
            shell.style.width = `${position.size}px`;
            shell.style.left = `${position.x}px`;
            shell.style.top = `${position.y}px`;
            shell.style.transform = `rotate(${position.rotation}deg)`;

            const pieceEl = this.buildPieceElement(piece, true);
            shell.appendChild(pieceEl);
            this.tray.appendChild(shell);
            piece.element = pieceEl;
        });

        document.getElementById('tray-empty').style.display = trayPieces.length === 0 ? 'block' : 'none';
        document.getElementById('tray-subtitle').textContent = trayPieces.length === 0
            ? 'Terminé'
            : (this.trayMode === 'mix' ? `${trayPieces.length} pièces dans la zone mélangée` : `${trayPieces.length} pièces alignées`);
        this.updateTrayActionState();
        this.updateSelectedState();
    }

    getTrayMetrics(pieceCount) {
        const trayWidth = this.tray.clientWidth || 320;
        const size = Math.max(86, Math.min(132, Math.floor(trayWidth / (trayWidth < 420 ? 2.85 : 3.15))));
        const columns = Math.max(2, Math.min(4, Math.floor(trayWidth / Math.max(90, size * 0.9))));
        const rows = Math.max(1, Math.ceil(Math.max(pieceCount, 1) / columns));
        const height = Math.max(320, rows * Math.max(76, Math.round(size * 0.72)) + size + 42);
        this.tray.style.minHeight = `${height}px`;
        return { width: trayWidth, height, size, columns };
    }

    applyMixedLayout(pieces, forceRemix = false) {
        const { width, height, size, columns } = this.getTrayMetrics(pieces.length);
        const stepX = columns > 1 ? (width - size - 28) / (columns - 1) : 0;
        const stepY = Math.max(54, Math.round(size * 0.58));

        pieces.forEach((piece, index) => {
            if (!forceRemix && this.trayPositions.has(piece.id)) {
                const previous = this.trayPositions.get(piece.id);
                this.trayPositions.set(piece.id, { ...previous, size });
                return;
            }

            const col = index % columns;
            const row = Math.floor(index / columns);
            const baseX = 14 + (col * stepX);
            const baseY = 46 + (row * stepY);
            const jitterX = Math.round((Math.random() - 0.5) * Math.min(30, size * 0.34));
            const jitterY = Math.round((Math.random() - 0.5) * Math.min(26, size * 0.28));
            const x = this.clamp(baseX + jitterX, 10, Math.max(10, width - size - 10));
            const y = this.clamp(baseY + jitterY, 38, Math.max(38, height - size - 10));
            const rotation = Math.round((Math.random() - 0.5) * 18);
            this.trayPositions.set(piece.id, { x, y, rotation, size });
        });
    }

    applyTidyLayout(pieces) {
        const { width, size } = this.getTrayMetrics(pieces.length);
        const gap = 12;
        const columns = Math.max(2, Math.floor((width - 24) / (size + gap)));
        const rows = Math.max(1, Math.ceil(Math.max(pieces.length, 1) / columns));
        const height = Math.max(280, rows * (size + gap) + 44);
        this.tray.style.minHeight = `${height}px`;

        pieces.forEach((piece, index) => {
            const col = index % columns;
            const row = Math.floor(index / columns);
            const x = 12 + col * (size + gap);
            const y = 42 + row * (size + gap);
            this.trayPositions.set(piece.id, { x, y, rotation: 0, size });
        });
    }

    updateTrayActionState() {
        const remixBtn = document.getElementById('remix-btn');
        const tidyBtn = document.getElementById('tidy-btn');
        remixBtn?.classList.toggle('is-active', this.trayMode === 'mix');
        tidyBtn?.classList.toggle('is-active', this.trayMode === 'tidy');
        if (tidyBtn) {
            tidyBtn.textContent = this.trayMode === 'tidy' ? '🌪️ Éparpiller' : '🧩 Aligner';
        }
    }

    setTrayMode(mode = 'mix', forceRemix = false) {
        this.trayMode = mode;
        if (forceRemix || mode === 'mix') {
            this.trayPositions.clear();
        }
        this.renderTray(forceRemix);
        this.showToast(
            mode === 'mix'
                ? 'Les pièces sont maintenant éparpillées dans la zone de mélange.'
                : 'Les pièces ont été alignées pour vous aider à progresser.',
            'info'
        );
    }

    clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
    }

    buildPieceElement(piece, draggable = true) {
        const wrapper = document.createElement('div');
        wrapper.className = 'pq-piece' + (draggable ? ' is-in-tray' : '') + (this.selectedPieceId === piece.id ? ' is-selected' : '');
        wrapper.dataset.pieceId = String(piece.id);
        wrapper.draggable = draggable && !this.gameCompleted;
        if (draggable) {
            wrapper.setAttribute('title', 'Cliquez ou glissez cette pièce');
        }

        if (draggable && !piece.locked) {
            wrapper.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                this.selectPiece(piece.id);
            });

            wrapper.addEventListener('dragstart', (e) => {
                this.selectPiece(piece.id, false);
                this.draggedPieceId = piece.id;
                e.dataTransfer.setData('text/plain', String(piece.id));
                e.dataTransfer.effectAllowed = 'move';
                wrapper.style.opacity = '0.5';
            });

            wrapper.addEventListener('dragend', () => {
                this.draggedPieceId = null;
                wrapper.style.opacity = '1';
                this.clearSlotStates();
                this.updateSelectedState();
            });
        }

        const view = 100;
        const extra = 22;
        const total = view + extra * 2;
        const tab = 18;
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', `${-extra} ${-extra} ${total} ${total}`);
        svg.setAttribute('class', 'pq-piece-svg');
        svg.setAttribute('preserveAspectRatio', 'none');

        const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
        const clipPath = document.createElementNS('http://www.w3.org/2000/svg', 'clipPath');
        const clipId = `pq-clip-${piece.id}-${piece.placed ? 'board' : 'tray'}`;
        clipPath.setAttribute('id', clipId);

        const clipShape = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        clipShape.setAttribute('d', this.getPiecePath(piece.edges, view, tab));
        clipPath.appendChild(clipShape);
        defs.appendChild(clipPath);
        svg.appendChild(defs);

        const bg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        bg.setAttribute('x', String(-extra));
        bg.setAttribute('y', String(-extra));
        bg.setAttribute('width', String(total));
        bg.setAttribute('height', String(total));
        bg.setAttribute('rx', '10');
        bg.setAttribute('fill', 'rgba(237,244,255,0.65)');
        svg.appendChild(bg);

        const image = document.createElementNS('http://www.w3.org/2000/svg', 'image');
        image.setAttribute('href', this.image.src);
        image.setAttribute('x', String(-(piece.col * view)));
        image.setAttribute('y', String(-(piece.row * view)));
        image.setAttribute('width', String(this.cols * view));
        image.setAttribute('height', String(this.rows * view));
        image.setAttribute('clip-path', `url(#${clipId})`);
        image.setAttribute('preserveAspectRatio', 'xMidYMid slice');
        svg.appendChild(image);

        const whiteStroke = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        whiteStroke.setAttribute('d', this.getPiecePath(piece.edges, view, tab));
        whiteStroke.setAttribute('fill', 'none');
        whiteStroke.setAttribute('stroke', 'rgba(255,255,255,0.92)');
        whiteStroke.setAttribute('stroke-width', '5');
        whiteStroke.setAttribute('stroke-linejoin', 'round');
        svg.appendChild(whiteStroke);

        const darkStroke = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        darkStroke.setAttribute('d', this.getPiecePath(piece.edges, view, tab));
        darkStroke.setAttribute('fill', 'none');
        darkStroke.setAttribute('stroke', piece.locked ? 'rgba(18,185,129,0.7)' : 'rgba(28, 63, 126, 0.24)');
        darkStroke.setAttribute('stroke-width', piece.locked ? '3' : '2');
        darkStroke.setAttribute('stroke-linejoin', 'round');
        svg.appendChild(darkStroke);

        wrapper.appendChild(svg);

        if (!draggable) {
            const badge = document.createElement('span');
            badge.className = 'pq-piece-badge';
            badge.textContent = String(piece.id + 1);
            wrapper.appendChild(badge);
        }

        return wrapper;
    }

    getPiecePath(edges, size = 100, tab = 18) {
        const s = size;
        const mid = s / 2;
        const third = s * 0.28;
        const twoThird = s * 0.72;
        let d = `M 0 0 `;

        d += this.edgePath('top', edges.t, s, mid, third, twoThird, tab);
        d += this.edgePath('right', edges.r, s, mid, third, twoThird, tab);
        d += this.edgePath('bottom', edges.b, s, mid, third, twoThird, tab);
        d += this.edgePath('left', edges.l, s, mid, third, twoThird, tab);

        return `${d} Z`;
    }

    edgePath(side, type, s, mid, third, twoThird, tab) {
        if (side === 'top') {
            if (type === 0) return `L ${s} 0 `;
            const out = type === 1 ? -tab : tab;
            return `L ${third} 0 C ${third + 6} 0 ${mid - 16} ${out} ${mid} ${out} C ${mid + 16} ${out} ${twoThird - 6} 0 ${twoThird} 0 L ${s} 0 `;
        }
        if (side === 'right') {
            if (type === 0) return `L ${s} ${s} `;
            const out = type === 1 ? tab : -tab;
            return `L ${s} ${third} C ${s} ${third + 6} ${s + out} ${mid - 16} ${s + out} ${mid} C ${s + out} ${mid + 16} ${s} ${twoThird - 6} ${s} ${twoThird} L ${s} ${s} `;
        }
        if (side === 'bottom') {
            if (type === 0) return `L 0 ${s} `;
            const out = type === 1 ? tab : -tab;
            return `L ${twoThird} ${s} C ${twoThird - 6} ${s} ${mid + 16} ${s + out} ${mid} ${s + out} C ${mid - 16} ${s + out} ${third + 6} ${s} ${third} ${s} L 0 ${s} `;
        }
        if (side === 'left') {
            if (type === 0) return `L 0 0 `;
            const out = type === 1 ? -tab : tab;
            return `L 0 ${twoThird} C 0 ${twoThird - 6} ${out} ${mid + 16} ${out} ${mid} C ${out} ${mid - 16} 0 ${third + 6} 0 ${third} L 0 0 `;
        }
        return '';
    }

    selectPiece(pieceId, notify = true) {
        if (this.gameCompleted) return;
        const piece = this.pieces.find(item => item.id === pieceId);
        if (!piece || piece.placed) return;

        this.selectedPieceId = this.selectedPieceId === pieceId ? null : pieceId;
        this.updateSelectedState();

        if (!notify) return;
        if (this.selectedPieceId === null) {
            this.showToast('Sélection annulée.', 'info');
            return;
        }

        this.showToast(`Pièce ${pieceId + 1} sélectionnée. Choisissez une case du plateau.`, 'info');
    }

    clearSelection() {
        this.selectedPieceId = null;
        this.updateSelectedState();
    }

    updateSelectedState() {
        this.slotElements.forEach((slot) => {
            const slotId = Number(slot.dataset.slotId);
            const slotPiece = this.pieces[slotId];
            const isTargetable = this.selectedPieceId !== null && !this.gameCompleted && slotPiece && !slotPiece.placed;
            slot.classList.toggle('is-targetable', isTargetable);
        });

        this.tray.querySelectorAll('.pq-piece-cloud').forEach((cloud) => {
            const pieceId = Number(cloud.dataset.pieceId ?? -1);
            cloud.classList.toggle('is-selected', pieceId === this.selectedPieceId);
        });

        this.tray.querySelectorAll('.pq-piece').forEach((pieceNode) => {
            const pieceId = Number(pieceNode.dataset.pieceId ?? -1);
            pieceNode.classList.toggle('is-selected', pieceId === this.selectedPieceId);
        });
    }

    handleDrop(pieceId, slotId) {
        const piece = this.pieces.find(item => item.id === pieceId);
        const slot = this.slotElements[slotId];
        if (!piece || !slot || piece.placed || this.gameCompleted) return;

        this.moves += 1;

        if (piece.id === slotId) {
            piece.placed = true;
            piece.inTray = false;
            this.trayPositions.delete(piece.id);
            this.placedCount += 1;
            if (this.selectedPieceId === piece.id) {
                this.selectedPieceId = null;
            }
            const gain = Math.max(4, Math.floor(this.baseScore / this.totalPieces));
            this.score += gain;
            this.playSnap();
            this.renderTray();
            this.renderBoard();
            this.triggerSnapAnimation(slot);
            this.updateSelectedState();
            this.updateUI();

            if (!this.answerUnlocked && this.placedCount >= Math.ceil(this.totalPieces * 0.35)) {
                this.unlockAnswer();
            }

            if (this.placedCount >= this.totalPieces) {
                this.completeGame();
            } else {
                this.showToast(`Bonne pièce ! +${gain} pts`, 'success');
            }
        } else {
            slot.classList.add('is-incorrect');
            window.setTimeout(() => slot.classList.remove('is-incorrect'), 420);
            this.score = Math.max(0, this.score - 1);
            this.updateSelectedState();
            this.updateUI();
            this.showToast('Cette pièce ne correspond pas à cette case.', 'error');
        }
    }

    shuffleTrayPieces() {
        if (this.gameCompleted) return;
        this.trayMode = 'mix';
        this.trayPositions.clear();
        this.renderTray(true);
        this.showToast('Les pièces ont été remélangées dans la zone libre.', 'info');
    }

    unlockAnswer() {
        this.answerUnlocked = true;
        this.answerInput.disabled = false;
        this.answerBtn.disabled = false;
        this.resultMsg.className = 'pq-message show info';
        this.resultMsg.textContent = 'La réponse est débloquée. Vous pouvez maintenant deviner le pays.';
        this.showToast('Réponse débloquée.', 'success');
    }

    submitAnswer() {
        if (!this.answerUnlocked || this.gameCompleted) return;

        const value = this.normalize(this.answerInput.value);
        const expected = this.normalize(this.destination.country);
        const altExpected = this.normalize(this.destination.capital);

        if (!value) {
            this.resultMsg.className = 'pq-message show error';
            this.resultMsg.textContent = 'Veuillez saisir une réponse.';
            return;
        }

        if (value === expected || value.includes(expected) || value === altExpected) {
            const gain = Math.max(12, Math.floor(this.timeLeft * 0.25));
            this.score += gain;
            this.resultMsg.className = 'pq-message show success';
            this.resultMsg.textContent = `Bonne réponse ! +${gain} pts.`;
            this.updateUI();
            this.completeGame(true);
        } else {
            this.resultMsg.className = 'pq-message show error';
            this.resultMsg.textContent = 'Ce n\'est pas la bonne réponse. Réessayez.';
            this.answerInput.value = '';
        }
    }

    normalize(value) {
        return (value || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-z0-9 ]/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }

    updateUI() {
        const progress = Math.round((this.placedCount / this.totalPieces) * 100);
        document.getElementById('timer').textContent = this.formatTime(this.timeLeft);
        document.getElementById('score').textContent = String(this.score);
        document.getElementById('piece-count').textContent = `${this.placedCount} / ${this.totalPieces}`;
        document.getElementById('board-progress').textContent = `${this.placedCount} / ${this.totalPieces} pièces`;
        document.getElementById('progress-text').textContent = `${progress}%`;
        document.getElementById('progress-fill').style.width = `${progress}%`;
        document.getElementById('moves').textContent = String(this.moves);
        document.getElementById('pieces-left').textContent = String(this.totalPieces - this.placedCount);
        document.getElementById('status-text').textContent = this.gameCompleted
            ? 'Terminé'
            : (this.answerUnlocked ? 'Réponse ouverte' : (progress >= 60 ? 'Presque fini' : 'En cours'));

        if (this.selectionHint) {
            this.selectionHint.textContent = this.selectedPieceId !== null
                ? `Pièce ${this.selectedPieceId + 1} sélectionnée : cliquez maintenant sur sa case correcte.`
                : 'Astuce : glissez une pièce avec la souris, ou touchez une pièce puis une case sur mobile.';
        }

        this.timerBox.classList.toggle('is-warning', this.timeLeft <= 60);
        this.resultMsg.classList.toggle('show', this.answerUnlocked || this.resultMsg.classList.contains('success') || this.resultMsg.classList.contains('error'));
    }

    startTimer() {
        if (this.timerInterval) window.clearInterval(this.timerInterval);
        this.updateUI();

        this.timerInterval = window.setInterval(() => {
            if (this.gameCompleted) {
                window.clearInterval(this.timerInterval);
                return;
            }

            this.timeLeft -= 1;
            if (this.timeLeft <= 0) {
                this.timeLeft = 0;
                this.updateUI();
                window.clearInterval(this.timerInterval);
                this.showToast('Temps écoulé. La partie recommence.', 'error');
                window.setTimeout(() => this.restart(), 700);
                return;
            }

            this.updateUI();
        }, 1000);
    }

    formatTime(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = seconds % 60;
        return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    openPreview() {
        const overlay = document.getElementById('preview-overlay');
        const timer = document.getElementById('preview-timer');
        overlay.classList.add('show');

        let count = 3;
        timer.textContent = `${count}s`;
        if (this.previewInterval) window.clearInterval(this.previewInterval);

        this.previewInterval = window.setInterval(() => {
            count -= 1;
            if (count <= 0) {
                this.closePreview();
            } else {
                timer.textContent = `${count}s`;
            }
        }, 1000);
    }

    closePreview() {
        if (this.previewInterval) {
            window.clearInterval(this.previewInterval);
            this.previewInterval = null;
        }
        document.getElementById('preview-overlay').classList.remove('show');
    }

    clearSlotStates() {
        this.slotElements.forEach(slot => slot.classList.remove('is-active'));
    }

    completeGame(fromAnswer = false) {
        if (this.gameCompleted) return;
        this.gameCompleted = true;
        if (this.timerInterval) window.clearInterval(this.timerInterval);

        const bonusTime = Math.floor(this.timeLeft * 0.4);
        const movePenalty = Math.max(0, Math.floor(this.moves / 10) * 3);
        if (!fromAnswer) {
            this.score += Math.max(0, bonusTime - movePenalty);
        }

        this.updateUI();
        document.getElementById('final-score').textContent = `+${this.score} pts`;
        document.getElementById('completion-modal').classList.add('show');
        this.playComplete();
        this.triggerCompleteAnimation();
        this.launchConfetti();
    }

    triggerCompleteAnimation() {
        this.slotElements.forEach((slot, index) => {
            const pieceEl = slot?.querySelector('.pq-piece');
            if (pieceEl) {
                setTimeout(() => {
                    pieceEl.classList.add('is-complete');
                    setTimeout(() => pieceEl.classList.remove('is-complete'), 650);
                }, index * 18);
            }
        });
    }

    restart() {
        if (this.timerInterval) window.clearInterval(this.timerInterval);
        this.closePreview();
        document.getElementById('completion-modal').classList.remove('show');

        this.draggedPieceId = null;
        this.selectedPieceId = null;
        this.placedCount = 0;
        this.moves = 0;
        this.score = 0;
        this.timeLeft = this.timeLimit;
        this.gameCompleted = false;
        this.answerUnlocked = false;
        this.answerInput.disabled = true;
        this.answerBtn.disabled = true;
        this.answerInput.value = '';
        this.resultMsg.className = 'pq-message info';
        this.resultMsg.textContent = 'Continue encore un peu pour débloquer la réponse.';

        this.createBoard();
        this.createPieces();
        this.renderTray();
        this.renderBoard();
        this.updateSelectedState();
        this.updateUI();
        this.startTimer();
        this.showToast('Nouvelle partie lancée.', 'info');
    }

    showMessage(text, type = 'info') {
        this.resultMsg.className = `pq-message show ${type}`;
        this.resultMsg.textContent = text;
    }

    showToast(text, type = 'info') {
        if (this.toastTimeout) window.clearTimeout(this.toastTimeout);
        this.toast.className = `pq-toast show ${type}`;
        this.toast.textContent = text;
        this.toastTimeout = window.setTimeout(() => {
            this.toast.className = 'pq-toast';
        }, 1800);
    }

    playSnap() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.frequency.setValueAtTime(620, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(420, ctx.currentTime + 0.12);
            gain.gain.setValueAtTime(0.08, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
            osc.start();
            osc.stop(ctx.currentTime + 0.12);
        } catch (e) {}
    }

    triggerSnapAnimation(slotElement) {
        const pieceEl = slotElement?.querySelector('.pq-piece');
        if (pieceEl) {
            pieceEl.classList.remove('is-snapped');
            void pieceEl.offsetWidth;
            pieceEl.classList.add('is-snapped');
            setTimeout(() => pieceEl.classList.remove('is-snapped'), 350);
        }
    }

    playComplete() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const notes = [523.25, 659.25, 783.99];
            notes.forEach((note, index) => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.connect(gain);
                gain.connect(ctx.destination);
                const start = ctx.currentTime + index * 0.12;
                osc.frequency.setValueAtTime(note, start);
                gain.gain.setValueAtTime(0.001, start);
                gain.gain.linearRampToValueAtTime(0.08, start + 0.02);
                gain.gain.exponentialRampToValueAtTime(0.001, start + 0.28);
                osc.start(start);
                osc.stop(start + 0.3);
            });
        } catch (e) {}
    }

    launchConfetti() {
        const colors = ['#1d4ed8', '#38bdf8', '#f59e0b', '#10b981', '#ef4444'];
        for (let i = 0; i < 42; i++) {
            const node = document.createElement('div');
            node.style.position = 'fixed';
            node.style.left = `${Math.random() * 100}vw`;
            node.style.top = '-16px';
            node.style.width = `${8 + Math.random() * 7}px`;
            node.style.height = `${8 + Math.random() * 10}px`;
            node.style.background = colors[i % colors.length];
            node.style.borderRadius = Math.random() > 0.5 ? '50%' : '3px';
            node.style.opacity = '0.95';
            node.style.pointerEvents = 'none';
            node.style.zIndex = '100';
            node.animate([
                { transform: 'translate3d(0,0,0) rotate(0deg)', opacity: 1 },
                { transform: `translate3d(${(Math.random() - 0.5) * 120}px, ${window.innerHeight + 40}px, 0) rotate(${520 + Math.random() * 240}deg)`, opacity: 0 }
            ], {
                duration: 2200 + Math.random() * 900,
                easing: 'cubic-bezier(.2,.8,.3,1)'
            });
            document.body.appendChild(node);
            window.setTimeout(() => node.remove(), 3400);
        }
    }
}

function copyPromoCode() {
    const code = document.getElementById('promo-code').textContent;
    navigator.clipboard.writeText(code).then(() => {
        const btn = document.querySelector('.pq-promo-copy');
        btn.textContent = '✓ Copié!';
        setTimeout(() => btn.textContent = 'Copier', 2000);
    });
}

document.addEventListener('DOMContentLoaded', async () => {
    const game = new PassportQuestGame(GAME_CONFIG);
    window.passportQuestGame = game;
    await game.init();
});
</script>
