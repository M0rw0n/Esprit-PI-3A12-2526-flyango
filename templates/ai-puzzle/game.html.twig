    }

    .pq-promo-copy {
        border: none;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.6rem;
        font-weight: 700;
        cursor: pointer;
        transition: transform .2s ease;
    }

    .pq-promo-copy:hover {
        transform: scale(1.05);
    }

    .pq-modal-actions {
        margin-top: 0.75rem;
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .pq-toast {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 70;
        min-width: 250px;
        max-width: 420px;
        padding: 0.9rem 1rem;
        border-radius: 16px;
        background: #fff;
        border: 1px solid #dbe7fa;
        box-shadow: var(--pq-shadow-md);
        color: var(--pq-text);
        font-weight: 800;
        display: none;
    }

    .pq-toast.show { display: block; animation: pqToastIn .18s ease; }
    .pq-toast.success { border-color: #b6efcf; color: #0d8058; }
    .pq-toast.error { border-color: #ffd1d1; color: #b42318; }
    .pq-toast.info { border-color: #cfe0ff; color: #2350a3; }

    @keyframes pqToastIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes pqShake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-4px); }
        50% { transform: translateX(4px); }
        75% { transform: translateX(-3px); }
    }

    @keyframes pqSnapBounce {
        0% { transform: scale(1); }
        40% { transform: scale(1.12); }
        70% { transform: scale(0.96); }
        100% { transform: scale(1); }
    }

    @keyframes pqCompletePulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(18, 185, 129, 0.4); }
        50% { transform: scale(1.02); box-shadow: 0 0 0 12px rgba(18, 185, 129, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(18, 185, 129, 0); }
    }

    @keyframes float-in {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    @keyframes glow-pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(42, 74, 127, 0); }
        50% { box-shadow: 0 0 20px 4px rgba(42, 74, 127, 0.25); }
    }

    @keyframes confetti-fall {
        0% { transform: translateY(-100%) rotate(0deg); opacity: 1; }
        100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
    }

    .pq-piece.is-snapped {
        animation: pqSnapBounce 0.32s ease-out;
    }

    .pq-piece.is-complete {
        animation: pqCompletePulse 0.6s ease-out;
    }

    @media (max-width: 1220px) {
        .pq-content { flex-direction: row; }
        .pq-game-shell { flex-direction: row; }
    }

    @media (max-width: 900px) {
        .pq-content { flex-direction: column; }
        .pq-game-shell { flex-direction: column; }
        .pq-sidebar {
            order: -1;
            position: static;
        }

        .pq-toolbar,
        .pq-board-meta,
        .pq-topbar-inner {
            flex-direction: column;
            align-items: stretch;
