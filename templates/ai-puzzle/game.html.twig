        align-items: center;
        justify-content: center;
        z-index: 50;
        padding: 1.5rem;
    }

    .pq-overlay.show,
    .pq-modal.show {
        display: flex;
    }

    .pq-overlay {
        background: rgba(13, 39, 86, 0.82);
        backdrop-filter: blur(6px);
    }

    .pq-preview-box {
        width: min(980px, 96vw);
        background: #fff;
        border-radius: 26px;
        overflow: hidden;
