    .pq-tray {
        position: relative;
        min-height: 420px;
        border-radius: 22px;
        overflow: hidden;
        border: 1px dashed #bcd1f2;
        background:
            radial-gradient(circle at 15% 18%, rgba(77,134,255,0.11), transparent 32%),
            radial-gradient(circle at 86% 22%, rgba(56,189,248,0.11), transparent 26%),
            linear-gradient(180deg, #ffffff 0%, #f4f8ff 100%);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.82);
        isolation: isolate;
    }

    .pq-tray::before {
        content: 'Zone de pièces mélangées';
        position: absolute;
        top: 12px;
        left: 14px;
        padding: 0.34rem 0.7rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.92);
        border: 1px solid #d8e6fb;
