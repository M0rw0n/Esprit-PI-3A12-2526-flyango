        font-weight: 900;
        color: var(--pq-text);
    }

    .pq-modal-card p {
        margin: 0.4rem 0 0;
        color: var(--pq-muted);
    }

    .pq-fact {
        margin-top: 0.5rem;
        padding: 0.5rem;
        border-radius: 10px;
        text-align: left;
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        border: 1px solid #ffd98c;
        color: #7a4f00;
    }

    .pq-fact h4 {
        margin: 0 0 0.25rem;
        font-size: 0.75rem;
        font-weight: 900;
    }

    .pq-final-score {
        margin-top: 0.5rem;
        font-size: 1.5rem;
        font-weight: 900;
        color: var(--pq-blue-900);
    }

    .pq-promo-box {
        margin-top: 0.5rem;
        padding: 0.4rem 0.6rem;
        background: linear-gradient(135deg, #fef3c7, #fde68a);
