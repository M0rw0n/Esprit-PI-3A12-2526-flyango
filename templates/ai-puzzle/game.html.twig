        inset: 0;
        pointer-events: none;
        background-image:
            linear-gradient(rgba(120, 153, 209, 0.08) 1px, transparent 1px),
            linear-gradient(90deg, rgba(120, 153, 209, 0.08) 1px, transparent 1px);
