{% extends 'base/base.html.twig' %}
{% block title %}Passport Quest - {{ destination.country }}{% endblock %}

{% block body %}
<style>
    :root {
        --pq-blue-900: #1B3A6B;
        --pq-blue-800: #1B3A6B;
        --pq-blue-700: #2a4a7f;
        --pq-blue-600: #2a4a7f;
        --pq-blue-500: #3d5a8f;
        --pq-blue-100: #e8eff5;
        --pq-surface: #ffffff;
        --pq-bg: #f4f8ff;
        --pq-border: #d7e3f7;
        --pq-border-strong: #b7c9e8;
        --pq-text: #153055;
        --pq-muted: #6f86a7;
        --pq-success: #12b981;
        --pq-warning: #ffb648;
        --pq-danger: #ef4444;
        --pq-shadow-sm: 0 8px 22px rgba(27, 62, 128, 0.08);
        --pq-shadow-md: 0 16px 40px rgba(27, 62, 128, 0.12);
        --pq-shadow-lg: 0 24px 60px rgba(16, 55, 121, 0.18);
        --pq-shadow-glow: 0 0 40px rgba(42, 74, 127, 0.3);
        --pq-radius-xl: 28px;
        --pq-radius-lg: 22px;
        --pq-radius-md: 16px;
        --pq-radius-sm: 12px;
        --glass-bg: rgba(255, 255, 255, 0.72);
        --glass-border: rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 8px 32px rgba(31, 38, 135, 0.12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background:
            radial-gradient(ellipse at 20% 0%, rgba(99, 145, 255, 0.15) 0%, transparent 50%),
            radial-gradient(ellipse at 80% 100%, rgba(139, 92, 246, 0.12) 0%, transparent 50%),
            linear-gradient(180deg, #f0f5ff 0%, #e0e8ff 50%, #f5f0ff 100%);
        color: var(--pq-text);
        font-family: 'Outfit', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        min-height: 60vh;
    }

    .pq-page {
        min-height: 60vh;
        display: flex;
        flex-direction: column;
        background: 
            radial-gradient(circle at 12% 8%, rgba(42, 74, 127, 0.08) 0%, transparent 30%),
            radial-gradient(circle at 88% 12%, rgba(139, 92, 246, 0.06) 0%, transparent 25%),
            linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
    }

    .pq-topbar {
        background: linear-gradient(135deg, rgba(15, 59, 143, 0.95) 0%, rgba(23, 84, 199, 0.92) 50%, rgba(33, 98, 214, 0.9) 100%);
        backdrop-filter: blur(20px);
        box-shadow: 0 4px 30px rgba(15, 59, 143, 0.25);
        color: #fff;
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.5rem 1rem;
    }

    .pq-topbar-inner {
        max-width: 100%;
        margin: 0 auto;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .pq-brand-wrap {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .pq-back {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: #fff;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255, 0.15);
        font-size: 1.1rem;
        transition: all .25s ease;
    }

    .pq-back:hover {
        transform: translateY(-2px) scale(1.05);
        background: rgba(255,255,255, 0.2);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .pq-brand {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .pq-brand-title {
        font-size: 1.25rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #fff 0%, #e0e8ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .pq-brand-subtitle {
        font-size: 0.75rem;
        opacity: 0.8;
        font-weight: 600;
        letter-spacing: 0.02em;
    }

    .pq-header-center {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .pq-chip {
        background: rgba(255,255,255, 0.1);
        border: 1px solid rgba(255,255,255, 0.15);
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
        backdrop-filter: blur(10px);
    }

    .pq-chip-emoji { font-size: 1rem; }

    .pq-header-right {
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .pq-stat {
        min-width: 90px;
        padding: 0.5rem 0.75rem;
        border-radius: 12px;
        background: rgba(255,255,255, 0.1);
        border: 1px solid rgba(255,255,255, 0.12);
        display: flex;
        flex-direction: column;
        gap: 0.05rem;
        text-align: center;
    }

    .pq-stat-label {
        font-size: 0.6rem;
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
    }

    .pq-stat-value {
        font-size: 1rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .pq-stat.timer.is-warning {
        background: linear-gradient(135deg, rgba(255, 182, 72, 0.4), rgba(255, 103, 103, 0.35));
        border-color: rgba(255, 182, 72, 0.3);
        animation: pulse-warning 1s ease infinite;
    }

    @keyframes pulse-warning {
        0%, 100% { box-shadow: 0 0 0 0 rgba(255, 182, 72, 0.4); }
        50% { box-shadow: 0 0 0 8px rgba(255, 182, 72, 0); }
    }

    .pq-content {
        width: 100%;
        max-width: 100%;
        padding: 0.5rem 0.75rem;
        display: flex;
        gap: 0.75rem;
        align-items: start;
    }

    .pq-panel {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
        border-radius: var(--pq-radius-md);
        overflow: hidden;
        backdrop-filter: blur(20px);
    }

    .pq-main-panel {
        padding: 0.5rem 0.75rem;
    }

.pq-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

    .pq-title-group h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--pq-text);
    }

    .pq-title-group p {
        margin: 0.25rem 0 0;
        font-size: 0.82rem;
        color: var(--pq-muted);
    }

    .pq-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .pq-btn {
        border: none;
        border-radius: 10px;
        padding: 0.6rem 0.85rem;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .25s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
    }

    .pq-btn:hover { transform: translateY(-2px); }

    .pq-btn-primary {
        background: linear-gradient(135deg, var(--pq-blue-800), var(--pq-blue-600));
        color: #fff;
        box-shadow: 0 6px 20px rgba(33, 98, 214, 0.28);
    }

    .pq-btn-secondary {
        background: rgba(255,255,255, 0.85);
        color: var(--pq-text);
        border: 1px solid rgba(200, 210, 235, 0.6);
        backdrop-filter: blur(10px);
    }

    .pq-btn-secondary:hover {
        background: #fff;
        box-shadow: 0 8px 20px rgba(21, 48, 85, 0.12);
    }

    .pq-btn-warning {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #78350f;
        box-shadow: 0 6px 20px rgba(245, 158, 11, 0.28);
    }

    .pq-game-shell {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 1rem;
        align-items: start;
    }

    .pq-board-card {
        background: linear-gradient(145deg, rgba(255,255,255, 0.9) 0%, rgba(248,250,255, 0.85) 100%);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 24px;
        padding: 0.75rem;
        box-shadow: 
            0 4px 24px rgba(31, 58, 128, 0.08),
            inset 0 1px 0 rgba(255,255,255, 0.8);
    }

    .pq-board-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.7rem;
        flex-wrap: wrap;
    }

    .pq-board-meta-left {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .pq-board-caption {
        font-weight: 800;
        color: var(--pq-text);
        font-size: 0.88rem;
    }

    .pq-board-note {
        color: var(--pq-muted);
        font-size: 0.75rem;
    }

    .pq-mini-progress {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.38rem 0.65rem;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(42, 74, 127, 0.12), rgba(99, 145, 255, 0.08));
        color: var(--pq-blue-800);
        font-size: 0.78rem;
        font-weight: 800;
    }

    .pq-board-wrap {
        position: relative;
        width: 100%;
        padding: 0.5rem;
        border-radius: 22px;
        background: linear-gradient(180deg, rgba(15, 59, 143, 0.04), rgba(42, 74, 127, 0.02));
        border: 1px solid rgba(42, 74, 127, 0.08);
        overflow: hidden;
    }

    .pq-board-silhouette {
        position: absolute;
        inset: 12px;
        opacity: 0.05;
        pointer-events: none;
        background-size: cover;
        background-position: center;
        border-radius: 18px;
        filter: blur(12px);
    }

    .pq-board-grid {
        position: relative;
        display: grid;
        gap: 0;
        background: 
            radial-gradient(circle at 35% 30%, rgba(42, 74, 127, 0.05) 0%, transparent 40%),
            linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
        border-radius: 20px;
        overflow: hidden;
        width: 100%;
        aspect-ratio: 1 / 1;
        box-shadow: 
            inset 0 2px 8px rgba(27, 58, 128, 0.06),
            inset 0 0 40px rgba(42, 74, 127, 0.04);
    }

    .pq-slot {
        position: relative;
        border: none;
        background:
            radial-gradient(circle at top left, rgba(255,255,255, 0.9), rgba(241,246,255, 0.85));
        min-width: 0;
        min-height: 0;
        overflow: visible;
        transition: all .2s ease;
    }

    .pq-slot.is-active {
        background: linear-gradient(180deg, rgba(42, 74, 127, 0.08) 0%, rgba(42, 74, 127, 0.06) 100%);
        box-shadow: inset 0 0 0 2px rgba(42, 74, 127, 0.25);
    }

    .pq-slot.is-targetable {
        cursor: pointer;
        box-shadow: inset 0 0 0 2px rgba(42, 74, 127, 0.18);
    }

    .pq-slot.is-incorrect {
        animation: pqShake .32s ease;
        background: linear-gradient(180deg, rgba(254, 215, 215, 0.9) 0%, rgba(254, 226, 226, 0.85) 100%);
        box-shadow: inset 0 0 0 2px rgba(220, 38, 38, 0.2);
    }

    .pq-slot.is-correct {
        background: linear-gradient(180deg, rgba(42, 74, 127, 0.04) 0%, rgba(16, 185, 129, 0.03) 100%);
    }

    .pq-slot.is-locked {
        box-shadow: inset 0 0 0 2px rgba(16, 185, 129, 0.25);
    }

    .pq-piece {
        width: 100%;
        height: 100%;
        position: relative;
        display: flex;
        align-items: stretch;
        justify-content: stretch;
        cursor: grab;
        border-radius: 0;
        transition: transform .2s ease, filter .2s ease, opacity .2s ease;
        user-select: none;
        -webkit-user-drag: element;
    }

    .pq-piece:active { cursor: grabbing; }

    .pq-piece.is-in-tray {
        filter: drop-shadow(0 8px 16px rgba(20, 56, 114, 0.2));
    }

    .pq-piece:hover.is-in-tray {
        transform: translateY(-5px) scale(1.03);
        z-index: 6;
        filter: drop-shadow(0 16px 28px rgba(20, 56, 114, 0.25));
    }

    .pq-piece.is-selected {
        transform: translateY(-6px) scale(1.05);
        z-index: 8;
        filter: drop-shadow(0 20px 35px rgba(20, 56, 114, 0.3));
    }

    .pq-piece.is-selected .pq-piece-badge {
        background: var(--pq-blue-800);
        color: #fff;
        border-color: rgba(15, 59, 143, 0.3);
    }

    .pq-piece.is-locked {
        cursor: default;
    }

    .pq-piece.is-locked .pq-piece-svg,
    .pq-piece.is-placed .pq-piece-svg {
        filter: drop-shadow(0 6px 12px rgba(31, 81, 168, 0.14));
    }

    .pq-piece-svg {
        width: 100%;
        height: 100%;
        overflow: visible;
        display: block;
    }

    .pq-piece-badge {
        position: absolute;
        right: 6px;
        top: 6px;
        min-width: 24px;
        height: 24px;
        border-radius: 999px;
        padding: 0 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255, 0.92);
        border: 1px solid rgba(187, 205, 231, 0.9);
        color: var(--pq-blue-800);
        font-size: 0.7rem;
        font-weight: 800;
        pointer-events: none;
        box-shadow: 0 4px 12px rgba(28, 65, 133, 0.12);
    }

    .pq-sidebar {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    .pq-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 0.85rem;
        box-shadow: var(--glass-shadow);
        backdrop-filter: blur(20px);
    }

    .pq-card-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.4rem;
        margin-bottom: 0.7rem;
    }

    .pq-card-title h3 {
        margin: 0;
        font-size: 0.88rem;
        font-weight: 800;
        color: var(--pq-text);
    }

    .pq-card-title .pq-sub {
        font-size: 0.7rem;
        color: var(--pq-muted);
        font-weight: 700;
    }

    .pq-progress-wrap {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .pq-progress-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: 0.78rem;
        color: var(--pq-muted);
    }

    .pq-progress-row strong {
        color: var(--pq-text);
        font-size: 0.9rem;
    }

    .pq-progress-bar {
        width: 100%;
        height: 10px;
        background: linear-gradient(180deg, rgba(226, 235, 250, 0.8), rgba(214, 228, 247, 0.6));
        border-radius: 999px;
        overflow: hidden;
        box-shadow: inset 0 1px 3px rgba(34, 73, 140, 0.1);
    }

    .pq-progress-fill {
        width: 0%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--pq-blue-700), var(--pq-blue-500));
        transition: width .3s ease;
        box-shadow: 0 0 12px rgba(42, 74, 127, 0.4);
    }

    .pq-stats-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.55rem;
    }

    .pq-mini-stat {
        border-radius: 14px;
        padding: 0.75rem;
        background: rgba(42, 74, 127, 0.06);
        border: 1px solid rgba(42, 74, 127, 0.1);
    }

    .pq-mini-stat span {
        display: block;
        font-size: 0.68rem;
        color: var(--pq-muted);
        font-weight: 700;
        margin-bottom: 0.2rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .pq-mini-stat strong {
        font-size: 0.95rem;
        color: var(--pq-text);
        font-weight: 800;
    }

    .pq-tray-shell {
        position: relative;
        border-radius: 20px;
        padding: 0.75rem;
        background: linear-gradient(180deg, rgba(248, 250, 255, 0.9), rgba(238, 244, 255, 0.85));
        border: 1px solid rgba(216, 230, 251, 0.6);
    }

    .pq-tray-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.55rem;
        flex-wrap: wrap;
        margin-bottom: 0.7rem;
    }

    .pq-inline-actions {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
    }

    .pq-chip-btn {
        border: 1px solid rgba(213, 227, 248, 0.7);
        background: rgba(255,255,255, 0.8);
        color: var(--pq-text);
        border-radius: 999px;
        padding: 0.4rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 700;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: all .2s ease;
    }

    .pq-chip-btn:hover {
        transform: translateY(-1px);
        border-color: rgba(42, 74, 127, 0.4);
        box-shadow: 0 6px 16px rgba(21, 48, 85, 0.1);
    }

    .pq-chip-btn.is-active {
        color: #fff;
        border-color: rgba(42, 74, 127, 0.3);
        background: linear-gradient(135deg, var(--pq-blue-700), var(--pq-blue-500));
    }

    .pq-tray {
        position: relative;
        min-height: 380px;
        border-radius: 18px;
        overflow: hidden;
        border: 1px dashed rgba(188, 209, 242, 0.5);
        background: 
            radial-gradient(circle at 20% 25%, rgba(42, 74, 127, 0.06) 0%, transparent 35%),
            radial-gradient(circle at 80% 30%, rgba(139, 92, 246, 0.04) 0%, transparent 28%),
            linear-gradient(180deg, #fcfdff 0%, #f4f8ff 100%);
        isolation: isolate;
    }

    .pq-tray::before {
        content: 'Pièces';
        position: absolute;
        top: 10px;
        left: 12px;
        padding: 0.28rem 0.6rem;
        border-radius: 999px;
        background: rgba(255,255,255, 0.9);
        border: 1px solid rgba(216, 230, 251, 0.8);
        color: var(--pq-blue-800);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        z-index: 1;
    }

    .pq-tray::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image:
            linear-gradient(rgba(42, 74, 127, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(42, 74, 127, 0.04) 1px, transparent 1px);
        background-size: 22px 22px;
        opacity: 0.4;
    }

    .pq-piece-cloud {
        position: absolute;
        aspect-ratio: 1 / 1;
        padding: 0.15rem;
        z-index: 2;
        transition: left .3s ease, top .3s ease, transform .2s ease, filter .2s ease;
        will-change: left, top, transform;
    }

    .pq-piece-cloud:hover {
        z-index: 6;
        filter: drop-shadow(0 14px 24px rgba(16, 55, 121, 0.2));
    }

    .pq-piece-cloud.is-selected {
        z-index: 10;
    }

    .pq-piece-cloud.is-selected .pq-piece {
        transform: translateY(-8px) scale(1.06);
    }

    .pq-piece-cloud.is-tidy {
        transform: rotate(0deg) !important;
    }

    .pq-piece-cloud .pq-piece {
        width: 100%;
        height: 100%;
    }

    .pq-tray-empty {
        display: none;
        text-align: center;
        padding: 0.85rem;
        border-radius: 14px;
        background: rgba(42, 74, 127, 0.06);
        color: var(--pq-muted);
        font-weight: 700;
        border: 1px dashed rgba(42, 74, 127, 0.2);
    }

    .pq-helper-note {
        margin-top: 0.65rem;
        padding: 0.7rem 0.8rem;
        border-radius: 12px;
        background: rgba(42, 74, 127, 0.06);
        border: 1px solid rgba(42, 74, 127, 0.1);
        color: var(--pq-muted);
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.4;
    }

    .pq-answer-box {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .pq-input {
        width: 100%;
        padding: 0.75rem 0.9rem;
        border-radius: 12px;
        border: 1px solid rgba(205, 220, 241, 0.8);
        background: rgba(255,255,255, 0.85);
        color: var(--pq-text);
        font-size: 0.88rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
        transition: all .2s ease;
    }

    .pq-input:focus {
        outline: none;
        border-color: rgba(42, 74, 127, 0.5);
        box-shadow: 0 0 0 4px rgba(42, 74, 127, 0.12);
    }

    .pq-input:disabled {
        background: rgba(244, 247, 252, 0.8);
        color: rgba(156, 174, 201, 0.8);
        cursor: not-allowed;
    }

    .pq-message {
        display: none;
        border-radius: 12px;
        padding: 0.7rem 0.85rem;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .pq-message.show { display: block; }
    .pq-message.success { background: rgba(16, 185, 129, 0.1); color: #047857; border: 1px solid rgba(16, 185, 129, 0.2); }
    .pq-message.error { background: rgba(220, 38, 38, 0.08); color: #b91c1c; border: 1px solid rgba(220, 38, 38, 0.15); }
    .pq-message.info { background: rgba(42, 74, 127, 0.08); color: #1d4ed8; border: 1px solid rgba(42, 74, 127, 0.15); }

    .pq-footer-link {
        width: 100%;
    }

    .pq-overlay,
    .pq-modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 200;
        padding: 1.5rem;
    }

    .pq-overlay.show,
    .pq-modal.show {
        display: flex;
    }

    .pq-overlay {
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(8px);
    }

    .pq-preview-box {
