{% extends 'base/base.html.twig' %}
{% block title %}World Tour - AI Travel Puzzle{% endblock %}

{% block body %}
<style>
    :root {
        --navy: #1B3A6B;
        --gold: #FFD700;
        --primary: #00B4D8;
        --success: #10B981;
        --bg: #F8FAFC;
        --text: #1E293B;
        --text-secondary: #64748B;
    }

    * { box-sizing: border-box; }

    body {
        font-family: 'Outfit', system-ui, sans-serif;
        background: linear-gradient(135deg, var(--bg) 0%, #E2E8F0 100%);
        min-height: 100vh;
        margin: 0;
        padding: 2rem 1rem;
        color: var(--text);
    }

    .world-tour {
        max-width: 800px;
        margin: 0 auto;
    }

    .header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .header h1 {
        font-size: 2.5rem;
        margin: 0 0 0.5rem;
        background: linear-gradient(135deg, var(--success), #059669);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .header p {
        color: var(--text-secondary);
        margin: 0;
    }

    .tour-progress {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(27,58,107,0.1);
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }

    .progress-bar {
        height: 16px;
        background: #E2E8F0;
        border-radius: 8px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--success), #34d399);
        border-radius: 8px;
        transition: width 0.5s ease;
    }

    .destinations {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .dest-card {
        background: white;
        border-radius: 16px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border: 2px solid #E2E8F0;
        transition: all 0.3s;
        cursor: pointer;
    }

    .dest-card.current {
        border-color: var(--gold);
        box-shadow: 0 0 20px rgba(255,215,0,0.2);
    }

    .dest-card.completed {
        border-color: var(--success);
        opacity: 0.7;
    }

    .dest-emoji {
        font-size: 2.5rem;
    }

    .dest-info {
        flex: 1;
    }

    .dest-name {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--navy);
    }

    .dest-landmark {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .dest-status {
        font-size: 1.5rem;
    }

    .start-btn {
        display: block;
        width: 100%;
        max-width: 400px;
        margin: 2rem auto 0;
        padding: 1rem 2rem;
        background: linear-gradient(135deg, var(--success), #059669);
        color: white;
        border: none;
        border-radius: 50px;
        font-size: 1.2rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        text-align: center;
        box-shadow: 0 10px 30px rgba(16,185,129,0.4);
        transition: transform 0.3s;
    }

    .start-btn:hover {
        transform: translateY(-3px);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--navy);
        text-decoration: none;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .back-link:hover {
        color: var(--gold);
    }
</style>

<div class="world-tour">
    <a href="{{ path('ai_puzzle_index') }}" class="back-link">← Retour au menu</a>
    
    <div class="header">
        <h1>🌍 World Tour</h1>
        <p>Enchaîne 3 pays pour devenir un champion du puzzle!</p>
    </div>

    <div class="tour-progress">
        <div class="progress-label">
            <span>Progression du voyage</span>
            <span>0 / 3</span>
        </div>
        <div class="progress-bar">
            <div class="progress-fill" style="width: 0%"></div>
        </div>
    </div>

    <div class="destinations">
        {% for dest in destinations %}
        <div class="dest-card">
            <div class="dest-emoji">{{ dest.emoji }}</div>
            <div class="dest-info">
                <div class="dest-name">{{ dest.country }}</div>
                <div class="dest-landmark">🏛️ {{ dest.landmark }}</div>
            </div>
            <div class="dest-status">⏳</div>
        </div>
        {% endfor %}
    </div>

    <a href="{{ path('ai_puzzle_play', {difficulty: 'medium'}) }}" class="start-btn">
        🚀 Commencer le Voyage
    </a>
</div>
{% endblock %}