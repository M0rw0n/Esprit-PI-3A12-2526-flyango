{% extends 'base/base.html.twig' %}
{% block title %}AI Travel Puzzle - Jeu de Voyage{% endblock %}

{% block body %}
<style>
    :root {
        --pq-navy: #1B3A6B;
        --pq-blue: #2a4a7f;
        --pq-cyan: #00B4D8;
        --pq-gold: #f59e0b;
        --pq-emerald: #10b981;
        --pq-surface: #ffffff;
        --pq-bg: #f0f5ff;
        --pq-text: #1e293b;
        --pq-text-muted: #64748b;
        --pq-border: #e2e8f0;
        --glass-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.5);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'Outfit', system-ui, sans-serif;
        background: 
            radial-gradient(ellipse at 20% 0%, rgba(42, 74, 127, 0.15) 0%, transparent 50%),
            radial-gradient(ellipse at 80% 100%, rgba(6, 182, 212, 0.1) 0%, transparent 50%),
            linear-gradient(180deg, #f0f5ff 0%, #e0f2fe 100%);
        min-height: 100vh;
        color: var(--pq-text);
    }

    .puzzle-home {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
    }

    .hero {
        text-align: center;
        margin-bottom: 3rem;
        position: relative;
    }

    .hero-bg-shapes {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .hero-shapes {
        position: absolute;
        font-size: 2.5rem;
        opacity: 0.15;
        animation: float 4s ease-in-out infinite;
    }

    .hero-shapes:nth-child(1) { top: 10%; left: 5%; animation-delay: 0s; }
    .hero-shapes:nth-child(2) { top: 20%; right: 8%; animation-delay: 0.5s; }
    .hero-shapes:nth-child(3) { bottom: 25%; left: 10%; animation-delay: 1s; }
    .hero-shapes:nth-child(4) { bottom: 15%; right: 5%; animation-delay: 1.5s; }
    .hero-shapes:nth-child(5) { top: 50%; left: 3%; animation-delay: 2s; }
    .hero-shapes:nth-child(6) { top: 45%; right: 3%; animation-delay: 2.5s; }

    @keyframes float {
        0%, 100% { transform: translateY(0) rotate(-5deg); }
        50% { transform: translateY(-15px) rotate(5deg); }
    }

    .hero-title-wrap {
        position: relative;
        display: inline-block;
    }

    .hero h1 {
        font-size: 4.5rem;
        font-weight: 900;
        margin: 0 0 0.85rem;
        background: linear-gradient(135deg, #1B3A6B, #2a4a7f);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        line-height: 1.2;
    }

    .hero-icon {
        display: inline-block;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: #475569;
        margin-top: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
    }

    .hero-cta {
        margin-top: 1.5rem;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--pq-navy);
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .difficulty-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
        margin-bottom: 2.5rem;
    }

    @media (max-width: 700px) {
        .difficulty-cards { grid-template-columns: 1fr; }
    }

    .diff-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 1.75rem 1.5rem;
        text-align: center;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        color: var(--pq-text);
        backdrop-filter: blur(20px);
        box-shadow: 0 4px 24px rgba(31, 58, 95, 0.08);
    }

    .diff-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 50px rgba(31, 58, 95, 0.15);
        border-color: rgba(42, 74, 127, 0.3);
    }

    .diff-icon { font-size: 2.8rem; margin-bottom: 0.75rem; display: block; }
    .diff-name { font-weight: 800; font-size: 1.15rem; color: var(--pq-navy); margin-bottom: 0.35rem; }
    .diff-info { font-size: 0.85rem; color: var(--pq-text-muted); font-weight: 500; }
    .diff-time { font-size: 0.8rem; color: var(--pq-blue); margin-top: 0.5rem; font-weight: 700; }

    .content-card {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 1.75rem;
        margin-bottom: 2rem;
        backdrop-filter: blur(20px);
        box-shadow: 0 4px 24px rgba(31, 58, 95, 0.08);
    }

    .modes-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    @media (max-width: 600px) {
        .modes-grid { grid-template-columns: 1fr; }
    }

    .mode-card {
        background: linear-gradient(135deg, rgba(42, 74, 127, 0.05), rgba(6, 182, 212, 0.03));
        border: 1px solid rgba(42, 74, 127, 0.1);
        border-radius: 18px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: var(--pq-text);
        transition: all 0.3s ease;
    }

    .mode-card:hover {
        background: linear-gradient(135deg, rgba(42, 74, 127, 0.1), rgba(6, 182, 212, 0.06));
        border-color: rgba(42, 74, 127, 0.3);
        transform: translateX(4px);
    }

    .mode-icon { font-size: 2.2rem; }
    .mode-title { font-weight: 800; font-size: 1rem; color: var(--pq-navy); }
    .mode-desc { font-size: 0.8rem; color: var(--pq-text-muted); margin-top: 0.15rem; }

    .destinations-scroll {
        display: flex;
        gap: 1.25rem;
        overflow-x: auto;
        padding: 0.5rem 0.25rem 1rem;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    .destinations-scroll::-webkit-scrollbar {
        height: 6px;
    }

    .destinations-scroll::-webkit-scrollbar-track {
        background: rgba(42, 74, 127, 0.1);
        border-radius: 3px;
    }

    .destinations-scroll::-webkit-scrollbar-thumb {
        background: rgba(42, 74, 127, 0.3);
        border-radius: 3px;
    }

    .dest-card {
        flex: 0 0 220px;
        background: var(--surface);
        border-radius: 20px;
        overflow: hidden;
        text-decoration: none;
        color: var(--pq-text);
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 16px rgba(31, 58, 95, 0.1);
    }

    .dest-card:hover {
        transform: translateY(-6px) scale(1.03);
        box-shadow: 0 16px 40px rgba(31, 58, 95, 0.18);
    }

    .dest-image {
        width: 100%;
        height: 140px;
        object-fit: cover;
        background: linear-gradient(135deg, #e0f2fe, #f0f5ff);
    }

    .dest-info {
        padding: 1rem;
    }

    .dest-emoji { font-size: 1.8rem; margin-bottom: 0.25rem; display: block; }
    .dest-name { font-weight: 800; font-size: 1rem; color: var(--pq-navy); margin-bottom: 0.15rem; }
    .dest-meta { font-size: 0.75rem; color: var(--pq-text-muted); }
    .dest-badge {
        display: inline-block;
        padding: 0.2rem 0.5rem;
        border-radius: 999px;
        font-size: 0.65rem;
        font-weight: 700;
        margin-top: 0.4rem;
    }

    .badge-easy { background: #d1fae5; color: #047857; }
    .badge-medium { background: #fef3c7; color: #b45309; }
    .badge-hard { background: #fee2e2; color: #b91c1c; }

    .cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #1B3A6B, #2a4a7f);
        color: #fff;
        padding: 0.85rem 1.5rem;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 24px rgba(42, 74, 127, 0.3);
    }

    .cta-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(42, 74, 127, 0.4);
    }

    .bottom-cta {
        text-align: center;
        margin-top: 2rem;
    }
</style>

<div class="puzzle-home">
    <div class="hero">
        <div class="hero-bg-shapes">
            <span class="hero-shapes">🧩</span>
            <span class="hero-shapes">✈️</span>
            <span class="hero-shapes">🗺️</span>
            <span class="hero-shapes">🔍</span>
            <span class="hero-shapes">🎒</span>
            <span class="hero-shapes">🧭</span>
        </div>
        <div class="hero-title-wrap">
            <h1><span class="hero-icon">🧩</span> Passport Quest</h1>
        </div>
        <p class="hero-subtitle">Explorez les plus belles destinations du monde en resolvant des puzzles interactifs.</p>
    </div>

    <div class="content-card">
        <div class="section-title">🎯 Choisir le niveau</div>
        <div class="difficulty-cards">
            <a href="{{ path('ai_puzzle_play', {destination: 'paris', difficulty: 'easy'}) }}" class="diff-card">
                <span class="diff-icon">😎</span>
                <div class="diff-name">Facile</div>
                <div class="diff-info">3x3 = 9 pieces</div>
                <div class="diff-time">⏱️ 3 min</div>
            </a>
            <a href="{{ path('ai_puzzle_play', {destination: 'paris', difficulty: 'medium'}) }}" class="diff-card">
                <span class="diff-icon">😵</span>
                <div class="diff-name">Moyen</div>
                <div class="diff-info">4x4 = 16 pieces</div>
                <div class="diff-time">⏱️ 5 min</div>
            </a>
            <a href="{{ path('ai_puzzle_play', {destination: 'paris', difficulty: 'hard'}) }}" class="diff-card">
                <span class="diff-icon">😈</span>
                <div class="diff-name">Difficile</div>
                <div class="diff-info">5x5 = 25 pieces</div>
                <div class="diff-time">⏱️ 8 min</div>
            </a>
        </div>

        <div class="section-title">🎮 Modes de jeu</div>
        <div class="modes-grid">
            <a href="{{ path('ai_puzzle_play', {destination: 'random', difficulty: 'medium'}) }}" class="mode-card">
                <span class="mode-icon">🎲</span>
                <div>
                    <div class="mode-title">Aleatoire</div>
                    <div class="mode-desc">Une destination surprise</div>
                </div>
            </a>
            <a href="{{ path('ai_puzzle_world_tour') }}" class="mode-card">
                <span class="mode-icon">🌍</span>
                <div>
                    <div class="mode-title">Tour du Monde</div>
                    <div class="mode-desc">Completez toutes les destinations</div>
                </div>
            </a>
        </div>
    </div>

    <div class="content-card">
        <div class="section-title">🌍 Destinations Populaires</div>
        <div class="destinations-scroll">
            <a href="{{ path('ai_puzzle_play', {destination: 'paris', difficulty: 'easy'}) }}" class="dest-card">
                <img src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=400&h=300&fit=crop" alt="Paris" class="dest-image">
                <div class="dest-info">
                    <span class="dest-emoji">🗼</span>
                    <div class="dest-name">Paris</div>
                    <div class="dest-meta">France</div>
                    <span class="dest-badge badge-easy">Facile</span>
                </div>
            </a>
            <a href="{{ path('ai_puzzle_play', {destination: 'tokyo', difficulty: 'medium'}) }}" class="dest-card">
                <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=400&h=300&fit=crop" alt="Tokyo" class="dest-image">
                <div class="dest-info">
                    <span class="dest-emoji">🗾</span>
                    <div class="dest-name">Tokyo</div>
                    <div class="dest-meta">Japon</div>
                    <span class="dest-badge badge-medium">Moyen</span>
                </div>
            </a>
            <a href="{{ path('ai_puzzle_play', {destination: 'newyork', difficulty: 'hard'}) }}" class="dest-card">
                <img src="https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?w=400&h=300&fit=crop" alt="New York" class="dest-image">
                <div class="dest-info">
                    <span class="dest-emoji">🗽</span>
                    <div class="dest-name">New York</div>
                    <div class="dest-meta">USA</div>
                    <span class="dest-badge badge-hard">Difficile</span>
                </div>
            </a>
            <a href="{{ path('ai_puzzle_play', {destination: 'rome', difficulty: 'medium'}) }}" class="dest-card">
                <img src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?w=400&h=300&fit=crop" alt="Rome" class="dest-image">
                <div class="dest-info">
                    <span class="dest-emoji">🏛️</span>
                    <div class="dest-name">Rome</div>
                    <div class="dest-meta">Italie</div>
                    <span class="dest-badge badge-medium">Moyen</span>
                </div>
            </a>
            <a href="{{ path('ai_puzzle_play', {destination: 'london', difficulty: 'medium'}) }}" class="dest-card">
                <img src="https://images.unsplash.com/photo-1513635269975-59663e9ac703?w=400&h=300&fit=crop" alt="London" class="dest-image">
                <div class="dest-info">
                    <span class="dest-emoji">🎡</span>
                    <div class="dest-name">Londres</div>
                    <div class="dest-meta">UK</div>
                    <span class="dest-badge badge-medium">Moyen</span>
                </div>
            </a>
            <a href="{{ path('ai_puzzle_play', {destination: 'dubai', difficulty: 'hard'}) }}" class="dest-card">
                <img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=400&h=300&fit=crop" alt="Dubai" class="dest-image">
                <div class="dest-info">
                    <span class="dest-emoji">🏙️</span>
                    <div class="dest-name">Dubaï</div>
                    <div class="dest-meta">EAU</div>
                    <span class="dest-badge badge-hard">Difficile</span>
                </div>
            </a>
        </div>
    </div>

    <div class="bottom-cta">
        <a href="{{ path('ai_puzzle_play', {destination: 'random', difficulty: 'medium'}) }}" class="cta-btn">
            🎲 Commencer une partie aleatoire
        </a>
    </div>
</div>
{% endblock %}