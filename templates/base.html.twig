<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Fly &amp; Go{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><text y=%221em%22 font-size=%2250%22>✈️</text></svg>">
        <script>document.documentElement.dataset.theme = localStorage.getItem('flyandgo-theme') || 'light';</script>
        <link rel="stylesheet" href="{{ asset('styles/flyandgo.css') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}" data-page-root>
        {% block app_chrome %}{% endblock %}

        <main class="{% block main_class %}page-content{% endblock %}">
            <div class="flash-stack" aria-live="polite" aria-atomic="true">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ label }}" data-auto-dismiss>{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
