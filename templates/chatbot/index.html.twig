    color: #1B3A6B;
    font-size: 0.9rem;
    line-height: 1.5;
    padding: 0.25rem 0.15rem;
}

#chatbotInput::placeholder {
    color: #94A3B8;
}

.chatbot-send {
    min-width: 44px;
    height: 44px;
    border: none;
    border-radius: 14px;
    background: linear-gradient(135deg, #1B3A6B, #00B4D8);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(27, 58, 107, 0.25);
    transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
}

.chatbot-send:hover {
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 18px 32px rgba(0, 180, 216, 0.35);
}

.chatbot-send:disabled {
    opacity: 0.65;
    cursor: not-allowed;
}

@media (max-width: 1024px) {
    .chatbot-app {
        grid-template-columns: 1fr;
