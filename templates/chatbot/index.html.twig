    box-shadow: 0 6px 16px rgba(15, 76, 129, 0.14);
}

.message.bot .message-avatar {
    background: linear-gradient(135deg, #1B3A6B, #00B4D8);
    color: #fff;
}

.message.user .message-avatar {
    background: linear-gradient(135deg, #FFB700, #E5A400);
    color: #0C1E3D;
}

.message-stack {
    max-width: min(78%, 700px);
}

.message-bubble {
    padding: 0.65rem 0.85rem;
    border-radius: 16px;
    line-height: 1.5;
    font-size: 0.85rem;
    box-shadow: 0 8px 20px rgba(15, 76, 129, 0.10);
    word-break: break-word;
}

.message.bot .message-bubble {
    background: #fff;
    color: #1B3A6B;
    border-top-left-radius: 8px;
    border: 1px solid #DDE5EF;
}

.message.user .message-bubble {
    background: linear-gradient(135deg, #1B3A6B, #00B4D8);
    color: #fff;
