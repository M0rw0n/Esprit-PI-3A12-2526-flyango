function searchLocation(query, resultsId) {
    const resultsDiv = document.getElementById(resultsId);
    if (!resultsDiv || query.length < 2) {
        if (resultsDiv) resultsDiv.style.display = 'none';
        return;
    }
    
    const q = query.toLowerCase();
    const matches = [];
    
    for (const [key, loc] of Object.entries(TunisiaLocations)) {
        if (loc.name.toLowerCase().includes(q) || key.includes(q) || loc.region.toLowerCase().includes(q)) {
            matches.push(loc);
        }
    }
    
    if (matches.length > 0) {
        resultsDiv.innerHTML = matches.slice(0, 6).map(loc => `
            <div class="location-result" onclick="selectLocation('${loc.name}', ${loc.lat}, ${loc.lng}, '${loc.region}', '${loc.type}', '${resultsId}')" 
                 style="padding:.75rem;cursor:pointer;border-bottom:1px solid #f1f2f6;display:flex;align-items:center;gap:.75rem"
                 onmouseover="this.style.background='#f8f9fa'" onmouseout="this.style.background='transparent'">
                <div style="width:35px;height:35px;border-radius:8px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center">
                    <i class="fa fa-map-marker-alt"></i>
                </div>
                <div>
                    <div style="font-weight:600;font-size:.85rem">${loc.name}</div>
                    <div style="font-size:.7rem;color:var(--muted)">${loc.region} • ${loc.type}</div>
                </div>
            </div>
        `).join('');
        resultsDiv.style.display = 'block';
    } else {
        resultsDiv.innerHTML = '<div style="padding:.75rem;color:var(--muted);font-size:.85rem">Aucun résultat</div>';
        resultsDiv.style.display = 'block';
    }
}

function selectLocation(name, lat, lng, region, type, resultsId) {
    document.getElementById('destination').value = name;
    document.getElementById('latResult').value = lat.toFixed(4);
    document.getElementById('lngResult').value = lng.toFixed(4);
    document.getElementById('destinationResults').style.display = 'none';
    
    document.getElementById('locationInfo').style.display = 'block';
    document.getElementById('locationName').textContent = name;
    document.getElementById('locationDetails').textContent = region + ' • ' + type + ' • GPS: ' + lat.toFixed(4) + ', ' + lng.toFixed(4);
    
    updateMapPreview(lat, lng, name);
}

function updateMapPreview(lat, lng, name) {
    const mapDiv = document.getElementById('mapPreview');
    mapDiv.innerHTML = '<iframe width="100%" height="100%" frameborder="0" style="border-radius:12px" src="https://www.openstreetmap.org/export/embed.html?bbox=' + (lng - 0.5) + '%2C' + (lat - 0.5) + '%2C' + (lng + 0.5) + '%2C' + (lat + 0.5) + '&layer=mapnik&marker=' + lat + '%2C' + lng + '"></iframe>';
}

function addStop() {
    stopCount++;
    const container = document.getElementById('stopsContainer');
    const stopHtml = `
        <div class="stop-item" style="display:flex;gap:.5rem;margin-bottom:.5rem;align-items:center;position:relative">
            <span style="background:var(--gold);color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700">${stopCount}</span>
            <input type="text" class="fg-input stop-input" placeholder="Étape ${stopCount}..." style="flex:1" oninput="searchLocation(this.value, this.parentElement.querySelector('.stopResults'))">
            <button type="button" class="btn btn-outline btn-sm" onclick="removeStop(this)"><i class="fa fa-times"></i></button>
            <div class="stopResults" style="position:absolute;top:100%;left:30px;background:#fff;border:1px solid var(--border);border-radius:8px;width:250px;max-height:150px;overflow-y:auto;display:none;z-index:50"></div>
        </div>
    `;
    container.insertAdjacentHTML('beforeend', stopHtml);
}

function removeStop(btn) {
    btn.parentElement.remove();
    updateStopNumbers();
}

function updateStopNumbers() {
    const items = document.querySelectorAll('.stop-item');
    items.forEach((item, index) => {
        item.querySelector('span').textContent = index + 1;
    });
    stopCount = items.length;
}

