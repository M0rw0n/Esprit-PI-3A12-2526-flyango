function initCalendar() {
    const circuitEvents = [
        {% for c in circuits %}
        {% if c.startDate and c.endDate %}
        {
            title: '{{ c.titre }}',
            start: '{{ c.startDate|date('Y-m-d') }}',
            end: '{{ c.endDate|date('Y-m-d') }}',
            url: '{{ path('circuit_show', {id: c.id}) }}',
            backgroundColor: '{{ c.difficulte == "Facile" ? "#10B981" : c.difficulte == "Difficile" ? "#EF4444" : "#F59E0B" }}',
            extendedProps: { type: 'circuit' }
        }{% if not loop.last %},{% endif %}
        {% endif %}
        {% endfor %}
    ];

    const reservationEvents = userReservationsData.map(function(res) {
        return {
            title: '📅 ' + res.circuit,
            start: res.date,
            allDay: true,
            backgroundColor: res.status === 'CONFIRME' ? '#1B3A6B' : '#F59E0B',
            extendedProps: { type: 'reservation', status: res.status }
        };
    });

    const allEvents = [...circuitEvents, ...reservationEvents];

    calendar = new FullCalendar.Calendar(document.getElementById('circuit-calendar'), {
        initialView: 'dayGridMonth',
        headerToolbar: { 
            left: 'prev,next today', 
            center: 'title', 
            right: 'dayGridMonth,listMonth' 
        },
        events: allEvents,
        eventClick: function(info) {
            if (info.event.extendedProps?.type === 'circuit') {
                window.location.href = info.event.url;
            } else if (info.event.extendedProps?.type === 'reservation') {
                showReservationModal(info.event.startStr, info.event.title);
            }
        },
        dateClick: function(info) {
            const dayReservations = userReservationsData.filter(function(r) { 
                return r.date === info.dateStr; 
            });
            
            if (dayReservations.length > 0) {
                showReservationModal(info.dateStr, dayReservations);
            } else {
                alert('Aucune réservation pour le ' + new Date(info.dateStr).toLocaleDateString('fr-FR'));
            }
        },
        height: 'auto',
        locale: 'fr',
        buttonText: { today: 'Aujourd\'hui', month: 'Mois', list: 'Liste' },
        eventDisplay: 'block'
    });
}

function showReservationModal(dateStr, reservations) {
    const modal = document.getElementById('reservationModal');
    const modalDate = document.getElementById('modalDate');
    const modalCircuit = document.getElementById('modalCircuit');
    
    if (!Array.isArray(reservations)) {
        reservations = userReservationsData.filter(function(r) { return r.date === dateStr; });
    }
    
    const date = new Date(dateStr);
    modalDate.textContent = date.toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    
    if (reservations.length > 0) {
        let html = '<div style="text-align:left">';
        reservations.forEach(function(res) {
            const statusColor = res.status === 'CONFIRME' ? '#10B981' : '#F59E0B';
            html += '<div style="padding:0.75rem;margin-bottom:0.5rem;background:#f8fafc;border-radius:8px;border-left:4px solid #1B3A6B">' +
                '<strong style="color:#1B3A6B">📅 ' + (res.circuit || 'Circuit') + '</strong>' +
                '<span style="display:block;margin-top:0.25rem;font-size:0.85rem;color:' + statusColor + '">' + 
                '<i class="fa fa-check-circle"></i> ' + (res.status || 'Confirmé') + '</span></div>';
        });
        html += '</div>';
        modalCircuit.innerHTML = html;
    } else {
        modalCircuit.innerHTML = '<p style="color:#64748b">Aucune réservation pour cette date</p>';
    }
    
    modal.style.display = 'flex';
    modal.classList.add('active');
}

function closeModal() {
    const modal = document.getElementById('reservationModal');
    modal.style.display = 'none';
    modal.classList.remove('active');
}

function showToast(message) {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.style.display = 'block';
    setTimeout(function() { toast.style.display = 'none'; }, 3000);
}

async function searchWeather(query) {
    const result = document.getElementById('customWeatherResult');
    
    if (!query || query.length < 2) { 
        result.style.display = 'none'; 
        return; 
    }
    
    result.style.display = 'inline-flex';
    result.innerHTML = '<i class="fa fa-spinner fa-spin"></i> <span style="margin-left:8px">Recherche...</span>';
    
    try {
        const res = await fetch('/api/weather?city=' + encodeURIComponent(query));
        const data = await res.json();
        
        if (data.success && data.weather) {
            const w = data.weather;
            const icons = {'01d':'☀️','01n':'🌙','02d':'⛅','03d':'☁️','09d':'🌧️','10d':'🌦️','11d':'⛈️','13d':'❄️','50d':'🌫️'};
            result.innerHTML = '<span style="margin-right:8px">' + (icons[w.icon] || '🌤️') + '</span>' +
                '<span style="font-weight:700">' + w.temperature + '°C</span>' +
                '<span style="margin-left:8px;opacity:0.9">' + w.city + '</span>';
        } else {
            result.innerHTML = '<i class="fa fa-exclamation-circle"></i> <span style="margin-left:8px">Non trouvé</span>';
            setTimeout(function() { result.style.display = 'none'; }, 2000);
        }
    } catch (e) {
        result.innerHTML = '<i class="fa fa-exclamation-triangle"></i> <span style="margin-left:8px">Erreur</span>';
    }
}

window.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('view') === 'calendar') {
        switchView('calendar');
    }
});

let aiVoiceRecognition = null;

function startAiVoiceSearch() {
    if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert('La reconnaissance vocale n\'est pas supportee par votre navigateur');
        return;
    }
    
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    aiVoiceRecognition = new SpeechRecognition();
    aiVoiceRecognition.lang = 'fr-FR';
    aiVoiceRecognition.interimResults = false;
    aiVoiceRecognition.maxAlternatives = 1;
    
    const btn = document.getElementById('aiVoiceBtn');
    const input = document.getElementById('searchInput');
    btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';
    
    aiVoiceRecognition.onstart = function() {
        console.log('AI Voice recognition started');
    };
    
    aiVoiceRecognition.onresult = function(event) {
        const transcript = event.results[0][0].transcript;
        input.value = transcript;
        setTimeout(function() {
            syncAndSubmit();
        }, 300);
    };
    
    aiVoiceRecognition.onerror = function(event) {
        console.error('Voice recognition error', event.error);
        btn.innerHTML = '<i class="fa fa-microphone"></i>';
        alert('Erreur de reconnaissance vocale: ' + event.error);
    };
    
    aiVoiceRecognition.onend = function() {
        btn.innerHTML = '<i class="fa fa-microphone"></i>';
    };
    
    aiVoiceRecognition.start();
}

function performAiSearchFromBar() {
    const query = document.getElementById('searchInput').value.trim();
    
    if (query.length < 2) {
        document.getElementById('searchInput').focus();
        return;
    }
    
    syncAndSubmit();
}

function performAiSearch(query) {
    const aiBrainBtn = document.getElementById('aiVoiceBtn');
    if (aiBrainBtn) aiBrainBtn.disabled = true;
    
    let resultsContainer = document.getElementById('semanticResults');
    if (!resultsContainer) {
        resultsContainer = document.createElement('div');
        resultsContainer.id = 'semanticResults';
        resultsContainer.style.cssText = 'margin:2rem 0;padding:1.5rem;background:linear-gradient(135deg,rgba(27,58,107,0.1),rgba(0,180,216,0.05));border-radius:16px;border:2px solid var(--navy)';
        
        const gridView = document.getElementById('grid-view');
        if (gridView) {
            gridView.parentNode.insertBefore(resultsContainer, gridView);
        }
    }
    
    const resultsDiv = document.getElementById('semanticResults');
    resultsDiv.innerHTML = '<div style="text-align:center;padding:2rem"><i class="fa fa-spinner fa-spin" style="font-size:2rem;color:var(--navy)"></i><p style="margin-top:1rem;color:var(--muted)">🤖 Analyse IA en cours...</p></div>';
    resultsDiv.style.display = 'block';
    
    fetch('/api/circuit/search?q=' + encodeURIComponent(query))
    .then(r => r.json())
    .then(data => {
        if (data.success && data.results && data.results.length > 0) {
            let matchedIds = data.results.map(r => r.circuit.id);
            
            document.querySelectorAll('#circuit-grid .circuit-card').forEach(card => {
                let idMatch = matchedIds.some(id => card.dataset.id == id);
                card.style.display = idMatch ? 'block' : 'none';
            });
            
            let html = '<div style="margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem"><i class="fa fa-sparkles" style="color:var(--gold);font-size:1.2rem"></i><span style="font-weight:700;font-size:1.1rem;color:var(--navy)">Résultats pour: "' + query + '"</span><span style="background:var(--navy);color:#fff;padding:2px 8px;border-radius:10px;font-size:0.75rem">' + data.results.length + '</span></div>';
            
            resultsDiv.innerHTML = html;
            resultsDiv.style.display = 'block';
        } else {
            document.querySelectorAll('#circuit-grid .circuit-card').forEach(card => {
                card.style.display = 'block';
            });
            
            let resultsDiv = document.getElementById('semanticResults');
            if (resultsDiv) resultsDiv.style.display = 'none';
        }
    })
    .catch(e => {
        document.querySelectorAll('#circuit-grid .circuit-card').forEach(card => {
            card.style.display = 'block';
        });
    })
    .finally(() => {
        if (aiBrainBtn) aiBrainBtn.disabled = false;
    });
}

function askDestination() {
    const dest = prompt('Entrez une destination (ville ou pays):');
    if (dest && dest.trim()) {
        document.getElementById('searchInput').value = dest.trim();
        document.getElementById('filterForm').submit();
    }
}

</script>
