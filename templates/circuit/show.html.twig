                                </div>
                                <input type="hidden" name="rating" id="ratingInput" value="5">
                            </div>
                        </div>
                        <div class="fg-group"><label class="fg-label">Commentaire</label><textarea name="comment" class="fg-input" rows="3" required placeholder="Partagez votre expérience..."></textarea></div>
