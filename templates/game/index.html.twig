{% extends 'base/base.html.twig' %}
{% block title %}Jeux & Défis — Fly&Go{% endblock %}
{% block body %}

<div style="max-width:1200px;margin:0 auto;padding:2rem">
    <h1 style="font-size:2rem;font-weight:900;color:var(--navy);margin-bottom:.5rem;text-align:center">
        <i class="fa fa-gamepad"></i> Jeux & Défis
    </h1>
    <p style="text-align:center;color:var(--muted);margin-bottom:2rem">
        Jouez, gagnez des points et des réductions sur vos prochaines réservations!
    </p>
    
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;max-width:900px;margin:0 auto">
        {# Quiz Card #}
        <a href="{{ path('games_quiz') }}" style="text-decoration:none">
            <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1);transition:transform .3s" onmouseover="this.style.transform='translateY(-5px)'">
                <div style="background:linear-gradient(135deg,var(--navy),#00B4D8);padding:2rem;text-align:center">
                    <i class="fa fa-question-circle" style="font-size:3rem;color:#fff"></i>
                </div>
                <div style="padding:1.5rem">
                    <h3 style="font-size:1.25rem;font-weight:800;color:var(--navy);margin-bottom:.5rem">Quiz Hébergements</h3>
                    <p style="font-size:.9rem;color:var(--muted);margin-bottom:1rem">Testez vos connaissances sur les hébergements tunisiens</p>
                    <span style="background:var(--cyan);color:#fff;padding:.25rem .75rem;border-radius:20px;font-size:.75rem;font-weight:600">
                        +50 pts
                    </span>
                </div>
            </div>
        </a>
        
        {# Spin Wheel Card #}
        <a href="{{ path('games_spin') }}" style="text-decoration:none">
            <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1);transition:transform .3s" onmouseover="this.style.transform='translateY(-5px)'">
                <div style="background:linear-gradient(135deg,var(--gold),#F59E0B);padding:2rem;text-align:center">
                    <i class="fa fa-circle-notch" style="font-size:3rem;color:#fff;animation:spin 2s linear infinite"></i>
                </div>
                <div style="padding:1.5rem">
                    <h3 style="font-size:1.25rem;font-weight:800;color:var(--navy);margin-bottom:.5rem">Roue Lucky</h3>
                    <p style="font-size:.9rem;color:var(--muted);margin-bottom:1rem">Tournez la roue pour gagner des réductions!</p>
                    <span style="background:#10B981;color:#fff;padding:.25rem .75rem;border-radius:20px;font-size:.75rem;font-weight:600">
                        até -20%
                    </span>
                </div>
            </div>
        </a>
        
        {# Memory Card #}
        <a href="{{ path('games_memory') }}" style="text-decoration:none">
            <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1);transition:transform .3s" onmouseover="this.style.transform='translateY(-5px)'">
                <div style="background:linear-gradient(135deg,#8B5CF6,#7C3AED);padding:2rem;text-align:center">
                    <i class="fa fa-clone" style="font-size:3rem;color:#fff"></i>
                </div>
                <div style="padding:1.5rem">
                    <h3 style="font-size:1.25rem;font-weight:800;color:var(--navy);margin-bottom:.5rem">Memory Héb.</h3>
                    <p style="font-size:.9rem;color:var(--muted);margin-bottom:1rem">Trouvez les paires d'hébergement</p>
                    <span style="background:var(--navy);color:#fff;padding:.25rem .75rem;border-radius:20px;font-size:.75rem;font-weight:600">
                        +30 pts
                    </span>
                </div>
            </div>
        </a>
        
        {# Hotel Match Card #}
        <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1)">
            <div style="background:linear-gradient(135deg,#EC4899,#DB2777);padding:2rem;text-align:center">
                <i class="fa fa-bed" style="font-size:3rem;color:#fff"></i>
            </div>
            <div style="padding:1.5rem">
                <h3 style="font-size:1.25rem;font-weight:800;color:var(--navy);margin-bottom:.5rem">Devinez l'Hôtel</h3>
                <p style="font-size:.9rem;color:var(--muted);margin-bottom:1rem">Identifiez l'hôtel par l'image</p>
                <span style="background:#EC4899;color:#fff;padding:.25rem .75rem;border-radius:20px;font-size:.75rem;font-weight:600">
                    Bientôt
                </span>
            </div>
        </div>
        
        {# Daily Challenge Card #}
        <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1)">
            <div style="background:linear-gradient(135deg,#EF4444,#DC2626);padding:2rem;text-align:center">
                <i class="fa fa-calendar-check" style="font-size:3rem;color:#fff"></i>
            </div>
            <div style="padding:1.5rem">
                <h3 style="font-size:1.25rem;font-weight:800;color:var(--navy);margin-bottom:.5rem">Défis du Jour</h3>
                <div style="font-size:.9rem;color:var(--muted);margin-bottom:.5rem">
                    <div style="display:flex;justify-content:space-between;padding:.5rem;border-bottom:1px solid var(--border)">
                        <span><i class="fa fa-compass"></i> Explorer 3 hébergements</span>
                        <span style="color:var(--gold);font-weight:700">+50 pts</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:.5rem;border-bottom:1px solid var(--border)">
                        <span><i class="fa fa-heart"></i> Ajouter aux favoris</span>
                        <span style="color:var(--gold);font-weight:700">+25 pts</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:.5rem;border-bottom:1px solid var(--border)">
                        <span><i class="fa fa-star"></i> Écrire un avis</span>
                        <span style="color:var(--gold);font-weight:700">+30 pts</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:.5rem">
                        <span><i class="fa fa-share"></i> Partager</span>
                        <span style="color:var(--gold);font-weight:700">+15 pts</span>
                    </div>
                </div>
            </div>
        </div>
        
        {# Price Guess Card #}
        <a href="{{ path('games_price') }}" style="text-decoration:none">
            <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1);transition:transform .3s" onmouseover="this.style.transform='translateY(-5px)'">
                <div style="background:linear-gradient(135deg,#F59E0B,#EF4444);padding:2rem;text-align:center">
                    <i class="fa fa-tags" style="font-size:3rem;color:#fff"></i>
                </div>
                <div style="padding:1.5rem">
                    <h3 style="font-size:1.25rem;font-weight:800;color:var(--navy);margin-bottom:.5rem">Défi Prix</h3>
                    <p style="font-size:.9rem;color:var(--muted);margin-bottom:1rem">Devinez le prix de l'hôtel</p>
                    <span style="background:#F59E0B;color:#fff;padding:.25rem .75rem;border-radius:20px;font-size:.75rem;font-weight:600">
                        +40 pts
                    </span>
                </div>
            </div>
        </a>
        
        {# Leaderboard Card #}
        <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1)">
            <div style="background:linear-gradient(135deg,#06B6D4,#0891B2);padding:2rem;text-align:center">
                <i class="fa fa-trophy" style="font-size:3rem;color:#fff"></i>
            </div>
            <div style="padding:1.5rem">
                <h3 style="font-size:1.25rem;font-weight:800;color:var(--navy);margin-bottom:.5rem">Classement</h3>
                <div style="font-size:.85rem">
                    <div style="display:flex;align-items:center;gap:.5rem;padding:.5rem;background:var(--bg);border-radius:8px;margin-bottom:.5rem">
                        <span style="background:var(--gold);color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700">1</span>
                        <span style="font-weight:600">Ahmed B.</span>
                        <span style="margin-left:auto;color:var(--gold);font-weight:700">1250 pts</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:.5rem;padding:.5rem;background:var(--bg);border-radius:8px;margin-bottom:.5rem">
                        <span style="background:#94A3B8;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700">2</span>
                        <span style="font-weight:600">Sarah M.</span>
                        <span style="margin-left:auto;color:var(--gold);font-weight:700">980 pts</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:.5rem;padding:.5rem;background:var(--bg);border-radius:8px">
                        <span style="background:#CD7F32;color:#fff;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700">3</span>
                        <span style="font-weight:600">Mohamed K.</span>
                        <span style="margin-left:auto;color:var(--gold);font-weight:700">850 pts</span>
                    </div>
                </div>
            </div>
        </div>
        
        {# Stats Card #}
        <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1)">
            <div style="background:linear-gradient(135deg,#059669,#10B981);padding:2rem;text-align:center">
                <i class="fa fa-user" style="font-size:3rem;color:#fff"></i>
            </div>
            <div style="padding:1.5rem">
                <h3 style="font-size:1.25rem;font-weight:800;color:var(--navy);margin-bottom:.5rem">Vos Stats</h3>
                <div style="font-size:.9rem;color:var(--muted)">
                    <div style="display:flex;justify-content:space-between;padding:.5rem;border-bottom:1px solid var(--border)">
                        <span>Points Total</span>
                        <span style="font-weight:700;color:var(--navy)">350</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:.5rem;border-bottom:1px solid var(--border)">
                        <span>Quiz complétés</span>
                        <span style="font-weight:700;color:var(--navy)">12</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:.5rem;border-bottom:1px solid var(--border)">
                        <span>Tours de roue</span>
                        <span style="font-weight:700;color:var(--navy)">8</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:.5rem">
                        <span>Niveau</span>
                        <span style="font-weight:700;color:var(--gold)">⭐⭐ Voyageur</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
</style>

{% endblock %}