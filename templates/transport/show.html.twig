                <span class="tag tag--navy"><i class="fas {{ offer.transportIcon }}"></i> {{ offer.transportType }}</span>
>>>>>>> testsisi
                <span><i class="fa fa-chair" style="color:var(--cyan)"></i> {{ offer.availableSeats }} places</span>
            </div>
        </div>
        <div class="price price--lg">
            <span class="price__val">{{ offer.price|number_format(3, ',', ' ') }}</span>
            <span class="price__cur" style="font-size:.9rem">TND</span>
            <span class="price__per">/pers.</span>
        </div>
    </div>

    <div class="detail-layout">
        <div>
            <div style="background:linear-gradient(135deg,var(--navy),var(--cyan));border-radius:var(--r);padding:40px;text-align:center;margin-bottom:2rem">
                {% if offer.imagePath %}<img src="{{ asset(offer.imagePath) }}" alt="{{ offer.companyName }}" style="width:120px;height:120px;object-fit:cover;border-radius:50%;margin:0 auto 20px;box-shadow:0 4px 20px rgba(0,0,0,0.2)">
                {% else %}<div style="width:100px;height:100px;background:rgba(255,255,255,0.2);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px"><i class="fas {{ offer.transportIcon }}" style="font-size:3rem;color:white"></i></div>{% endif %}
                <div style="display:flex;justify-content:center;align-items:center;gap:40px;margin-top:20px">
                    <div style="text-align:center">
                        <div style="font-size:1.8rem;font-weight:900;color:white">{{ offer.departureDatetime|date('H:i') }}</div>
                        <div style="font-size:.9rem;color:rgba(255,255,255,.8)">{{ offer.departureCity }}</div>
                        <div style="font-size:.8rem;color:rgba(255,255,255,.6)">{{ offer.departureStation }}</div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:5px">
                        <div style="width:120px;height:2px;background:rgba(255,255,255,.3)"></div>
                        <div style="font-size:.8rem;color:rgba(255,255,255,.7);background:var(--navy);padding:3px 10px;border-radius:10px">{{ offer.duration ?: '—' }}</div>
                        <div style="width:120px;height:2px;background:rgba(255,255,255,.3)"></div>
                    </div>
                    <div style="text-align:center">
                        <div style="font-size:1.8rem;font-weight:900;color:white">{{ offer.arrivalDatetime|date('H:i') }}</div>
                        <div style="font-size:.9rem;color:rgba(255,255,255,.8)">{{ offer.arrivalCity }}</div>
                        <div style="font-size:.8rem;color:rgba(255,255,255,.6)">{{ offer.arrivalStation }}</div>
                    </div>
                </div>
                <div style="margin-top:15px;font-size:.85rem;color:rgba(255,255,255,.7)">
                    <i class="fa fa-calendar"></i> {{ offer.departureDatetime|date('d/m/Y') }}
                </div>
            </div>

            {% if offer.amenities %}
            <div style="background:var(--bg);border:1px solid var(--border);border-radius:var(--r);padding:1.5rem;margin-bottom:2rem">
                <h3 style="font-size:1rem;font-weight:700;margin-bottom:1rem"><i class="fa fa-concierge-bell" style="color:var(--navy)"></i> Services inclus</h3>
                <div style="display:flex;flex-wrap:wrap;gap:10px">
                    {% for a in offer.amenities|split(',') %}
                    <span style="background:#e6f7ef;color:#059669;padding:6px 14px;border-radius:20px;font-size:.85rem"><i class="fa fa-check"></i> {{ a|trim }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>

        <div class="detail-sticky">
            <div class="detail-info">
                <div style="text-align:center;padding:1rem 0;border-bottom:1px solid var(--border);margin-bottom:1rem">
                    <div style="font-size:.85rem;color:var(--muted)">Prix par personne</div>
                    <div class="price price--md" style="justify-content:center">
                        <span class="price__val" style="font-size:2rem">{{ offer.price|number_format(3, ',', ' ') }}</span>
                        <span class="price__cur">TND</span>
                    </div>
                </div>

                {% if is_granted('ROLE_USER') %}
                <form action="{{ path('transport_book', {id: offer.id}) }}" method="POST">
                    <div class="fg-group">
                        <label class="fg-label">Passagers</label>
                        <select name="passengers" class="fg-input" required onchange="updateTransportTotal()">
                            {% for i in 1..min(offer.availableSeats, 9) %}
                            <option value="{{ i }}">{{ i }} passager{% if i > 1 %}s{% endif %}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="fg-group">
                        <label class="fg-label">Classe</label>
                        <select name="travel_class" class="fg-input">
                            <option value="ECONOMY">Économique</option>
                            <option value="BUSINESS">Affaires</option>
                        </select>
                    </div>
                    <div class="fg-group">
                        <label class="fg-label">Lieu de départ</label>
                        <input type="text" name="pickup_location" class="fg-input" placeholder="Adresse">
                    </div>
                    <div class="fg-group">
                        <label class="fg-label">Paiement</label>
                        <select name="payment_method" class="fg-input" id="paymentMethod">
                            <option value="stripe">💳 Stripe (Carte)</option>
                            <option value="paypal">🅿️ PayPal</option>
                        </select>
                    </div>
                    <div style="background:var(--bg);border-radius:var(--r-sm);padding:1rem;margin-bottom:1rem;text-align:center">
                        <div style="font-size:.85rem;color:var(--muted)">Total</div>
                        <div class="price price--md" style="justify-content:center">
                            <span class="price__val" style="font-size:1.8rem" id="totalPrice">{{ offer.price|number_format(0, ',', ' ') }}</span>
                            <span class="price__cur">TND</span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-accent btn-lg" style="width:100%">
                        <i class="fa fa-lock"></i> Réserver et payer
                    </button>
                </form>
                <script>
                const unitPrice = {{ offer.price }};
                function updateTransportTotal() {
                    const passengers = document.querySelector('select[name="passengers"]').value;
                    document.getElementById('totalPrice').textContent = (unitPrice * passengers).toLocaleString('fr-FR');
                }
                </script>
                {% else %}
                <div style="text-align:center;padding:1.5rem">
                    <p style="color:var(--muted);margin-bottom:1rem">Connectez-vous pour réserver</p>
                    <a href="{{ path('app_login') }}" class="btn btn-accent btn-lg" style="width:100%;display:block">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-outline" style="width:100%;display:block;margin-top:.5rem">Créer un compte</a>
                </div>
                {% endif %}

                <div style="margin-top:1rem;padding:1rem;background:#fef3c7;border-radius:var(--r-sm);font-size:.82rem;color:#92400e;text-align:center">
                    <i class="fa fa-shield-alt"></i> Réservation sécurisée - Annulation flexible
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
