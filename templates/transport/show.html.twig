{% extends 'base/base.html.twig' %}
{% block title %}{{ offer.companyName ?: 'Transport' }} — Fly&Go{% endblock %}
{% block body %}

<div style="max-width:1380px;margin:0 auto;padding:2rem">
    <div style="font-size:.82rem;color:var(--muted);margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem">
        <a href="{{ path('home') }}" style="color:var(--muted)">Accueil</a>
        <i class="fa fa-chevron-right fa-xs"></i>
        <a href="{{ path('transport_index') }}" style="color:var(--muted)">Transport</a>
        <i class="fa fa-chevron-right fa-xs"></i>
        <strong style="color:var(--text)">{{ offer.companyName }}</strong>
    </div>

    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:2rem;margin-bottom:1.5rem;flex-wrap:wrap">
        <div>
            <h1 style="font-size:1.8rem;font-weight:900;color:var(--text);margin-bottom:.35rem">{{ offer.companyName }}</h1>
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
<<<<<<< HEAD
                <span class="tag tag--navy"><i class="fas {{ offer.transportIcon }}"></i> {{ offer.transportType.value }}</span>
