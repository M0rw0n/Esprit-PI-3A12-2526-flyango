<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — Fly&Go</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
{% if google_client_id %}
<script src="https://accounts.google.com/gsi/client?client_id={{ google_client_id }}" async></script>
{% endif %}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <style>
        body { 
            background: 
                linear-gradient(135deg, rgba(27,58,107,0.85) 0%, rgba(27,58,107,0.75) 100%),
                url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1920&q=80') center/cover no-repeat fixed;
            min-height: 100vh; 
            font-family: 'Outfit', sans-serif; 
            position: relative;
        }
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(ellipse at 30% 70%, rgba(0,180,216,0.25) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 30%, rgba(255,183,0,0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(27,58,107,0.4) 0%, transparent 70%);
            pointer-events: none;
            animation: bgShift 20s ease-in-out infinite;
        }
        @keyframes bgShift {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3z' fill='%2300B4D8' fill-opacity='0.03' fill-rule='evenodd'/%3E%3C/svg%3E");
            pointer-events: none;
        }
        .auth-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; position: relative; z-index: 1; }
        .auth-card { background: rgba(255,255,255,0.97); backdrop-filter: blur(20px); border-radius: 24px; box-shadow: 0 25px 80px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.15); width: 100%; max-width: 460px; overflow: hidden; position: relative; animation: fadeInUp 0.6s ease; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        .auth-card__head { background: linear-gradient(135deg, #1B3A6B 0%, #1B3A6B 50%, #0d2847 100%); padding: 2.5rem 2rem 2rem; text-align: center; color: white; position: relative; overflow: hidden; }
        .auth-card__head::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(circle at 30% 50%, rgba(0,180,216,0.2) 0%, transparent 40%),
                radial-gradient(circle at 70% 50%, rgba(255,183,0,0.15) 0%, transparent 40%);
            animation: pulse 8s ease-in-out infinite;
        }
        .auth-card__head::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #00B4D8 0%, #FFB700 50%, #00B4D8 100%);
        }
        @keyframes pulse { 0%, 100% { transform: scale(1); opacity: 0.6; } 50% { transform: scale(1.05); opacity: 1; } }
        .auth-logo { margin-bottom: 1rem; position: relative; display: flex; justify-content: center; }
        .auth-logo img { height: 90px; width: 280px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3)); }
        .auth-card__head h1 { font-size: 1.1rem; font-weight: 600; margin: 0.5rem 0 0; opacity: 0.95; position: relative; }
        .auth-card__head p { font-size: 0.85rem; opacity: 0.75; margin: 0; position: relative; }
        .auth-card__body { padding: 2rem; }
        .auth-decor {
            position: absolute;
            top: 0;
            right: 0;
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, rgba(0,180,216,0.3), transparent);
            border-radius: 0 0 0 100%;
        }
        .auth-decor-2 {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, transparent, rgba(255,183,0,0.2));
            border-radius: 0 100% 0 0;
        }
        .err { background: #fee2e2; border: 1px solid #fca5a5; border-radius: 12px; padding: 0.875rem 1rem; color: #991b1b; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem; animation: shake 0.4s ease; }
        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
        .success-msg { background: #d1fae5; border: 1px solid #6ee7b7; border-radius: 12px; padding: 0.875rem 1rem; color: #065f46; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem; }
        .fg-group { margin-bottom: 1.25rem; }
        .fg-label { display: block; font-size: 0.82rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem; }
        .fg-input-wrap { position: relative; }
        .fg-input { width: 100%; padding: 0.875rem 1rem; border: 2px solid #e5e7eb; border-radius: 12px; font-size: 0.95rem; font-family: inherit; transition: all 0.3s ease; background: #f9fafb; box-sizing: border-box; }
        .fg-input:focus { outline: none; border-color: #00B4D8; background: white; box-shadow: 0 0 0 4px rgba(0,180,216,0.1); }
        .fg-input.error { border-color: #ef4444; background: #fef2f2; }
        .fg-input.valid { border-color: #10b981; background: #f0fdf4; }
        .password-wrap .fg-input { padding-right: 3rem; }
        .password-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9ca3af; font-size: 1.1rem; padding: 0.5rem; transition: color 0.3s; }
        .password-toggle:hover { color: #1a365d; }
        .remember-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
        .remember-label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #6b7280; cursor: pointer; }
        .remember-label input[type="checkbox"] { width: 18px; height: 18px; accent-color: #1a365d; cursor: pointer; }
        .forgot-link { font-size: 0.82rem; color: #1a365d; text-decoration: none; font-weight: 500; transition: color 0.3s; }
        .forgot-link:hover { color: #c9a232; text-decoration: underline; }
        .btn-navy { background: linear-gradient(135deg, #1B3A6B, #2a4a7f); color: white; border: none; padding: 1rem 1.5rem; border-radius: 12px; font-size: 1rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.3s ease; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
        .btn-navy:hover { background: linear-gradient(135deg, #2a4a7f, #1B3A6B); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(27,58,107,0.4); }
        .btn-navy:active { transform: translateY(0); }
        .btn-navy:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
        .auth-divider { display: flex; align-items: center; gap: 1rem; margin: 1.5rem 0; color: #6b7280; font-size: 0.82rem; }
        .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, #e5e7eb, transparent); }
        .btn-outline { background: transparent; color: #1B3A6B; border: 2px solid #1B3A6B; padding: 0.875rem 1.5rem; border-radius: 12px; font-size: 0.95rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.3s ease; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-decoration: none; box-sizing: border-box; }
        .btn-outline:hover { background: #FFB700; border-color: #FFB700; color: #1B3A6B; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(255,183,0,0.3); }
        .forgot-link { color: #00B4D8; font-weight: 500; }
        .forgot-link:hover { color: #FFB700; text-decoration: underline; }
        .back-link { text-align: center; margin-top: 1.5rem; }
        .back-link a { color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.3s; }
        .back-link a:hover { color: white; }
        .social-login { display: flex; gap: 1rem; margin-bottom: 0; }
        .social-btn { flex: 1; padding: 0.875rem; border: 2px solid #e5e7eb; border-radius: 12px; background: white; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.9rem; font-weight: 500; color: #374151; }
        .social-btn:hover { border-color: #1B3A6B; background: #f8fafc; transform: translateY(-2px); box-shadow: 0 4px 15px rgba(27,58,107,0.1); }
        .social-btn.google i { color: #ea4335; }
        .social-btn.facebook i { color: #1877f2; }
        .g-recaptcha { margin: 1rem 0; display: flex; justify-content: center; }
    </style>
</head>
<body>
<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-card__head">
            <div class="auth-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Fly&Go">
            </div>
            <h1>Connexion à votre espace</h1>
            <p>Bienvenue, entrez vos identifiants</p>
        </div>
        <div class="auth-card__body">
            {% if error %}
            <div class="err">
                <i class="fas fa-exclamation-circle"></i>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
            {% endif %}
            {% for msg in app.flashes('success') %}
            <div class="success-msg">
                <i class="fas fa-check-circle"></i>
                {{ msg }}
            </div>
            {% endfor %}

            <form action="{{ path('app_login') }}" method="POST" id="loginForm">
                <div class="fg-group">
                    <label class="fg-label">Adresse email</label>
                    <div class="fg-input-wrap">
                        <input type="email" name="_username" class="fg-input" id="emailInput" value="{{ last_username }}" required autocomplete="email" placeholder="votre@email.com">
                    </div>
                </div>
                
                <div class="fg-group">
                    <label class="fg-label">Mot de passe</label>
                    <div class="fg-input-wrap password-wrap">
                        <input type="password" name="_password" class="fg-input" id="passwordInput" required autocomplete="current-password" placeholder="••••••••">
                        <button type="button" class="password-toggle" onclick="togglePassword()" aria-label="Afficher/Masquer le mot de passe">
                            <i class="fas fa-eye" id="passwordIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="remember-row">
                    <label class="remember-label">
                        <input type="checkbox" name="_remember_me"> Se souvenir de moi
                    </label>
                    <a href="{{ path('app_forgot_password_request') }}" class="forgot-link">Mot de passe oublié ?</a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></div>
                <button type="submit" class="btn-navy" id="submitBtn">
                    <i class="fas fa-sign-in-alt"></i>
                    Se connecter
                </button>
            </form>

            <div class="auth-divider">ou continuer avec</div>

            <div class="social-login">
                <button type="button" class="social-btn google" id="googleBtn" onclick="loginWithGoogle()">
                    <i class="fab fa-google"></i>
                    Google
                </button>
                <button type="button" class="social-btn facebook" id="fbBtn" onclick="loginWithFacebook()">
                    <i class="fab fa-facebook-f"></i>
                    Facebook
                </button>
            </div>

            <div class="auth-divider">pas encore de compte ?</div>

            <a href="{{ path('app_register') }}" class="btn-outline">
                <i class="fas fa-user-plus"></i>
                Créer un compte gratuit
            </a>

            <div class="back-link">
                <a href="{{ path('home') }}">
                    <i class="fas fa-arrow-left"></i>
                    Retour au site
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function togglePassword() {
    const input = document.getElementById('passwordInput');
    const icon = document.getElementById('passwordIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}

document.getElementById('emailInput').addEventListener('blur', function() {
    const val = this.value.trim();
    if (val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
        this.classList.add('error');
        this.classList.remove('valid');
    } else if (val) {
        this.classList.remove('error');
        this.classList.add('valid');
    }
});

document.getElementById('loginForm').addEventListener('submit', function() {
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Connexion en cours...';
});
</script>

{% if google_client_id %}
<script>
function loginWithGoogle() {
    if (typeof google === 'undefined' || !google.accounts) {
        google.accounts.id.renderButton(document.getElementById('googleBtn'), {
            theme: 'outline',
            size: 'large',
            callback: handleGoogleResponse
        });
        return;
    }
    google.accounts.id.prompt();
}

function handleGoogleResponse(response) {
    if (response && response.credential) {
        const payload = JSON.parse(atob(response.credential.split('.')[1]));
        fetch('{{ path('api_auth_google') }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                google_id: payload.sub,
                email: payload.email,
                name: payload.name,
                avatar: payload.picture
            })
        }).then(r => r.json()).then(data => {
            if (data.success) window.location.href = data.redirect || '{{ path('user_dashboard') }}';
            else alert(data.error || 'Erreur Google');
        });
    }
}
</script>
{% endif %}

{% if facebook_app_id %}
<div id="fb-root"></div>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/fr_FR/sdk.js#{{ facebook_app_id }}"></script>
<script>
window.fbAsyncInit = function() {
    FB.init({
        appId: '{{ facebook_app_id }}',
        cookie: true,
        xfbml: true,
        version: 'v18.0'
    });
};

function loginWithFacebook() {
    FB.getLoginStatus(function(response) {
        if (response.status === 'connected') {
            fbApiLogin(response.authResponse);
        } else {
            FB.login(function(response) {
                if (response.authResponse) fbApiLogin(response.authResponse);
            }, {scope: 'email,public_profile'});
        }
    });
}

function fbApiLogin(authResponse) {
    FB.api('/me?fields=id,name,email,picture', function(userData) {
        fetch('{{ path('api_auth_facebook') }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                facebook_token: authResponse.accessToken,
                facebook_id: userData.id,
                email: userData.email || userData.id + '@facebook.local',
                name: userData.name,
                avatar: userData.picture?.data?.url
            })
        }).then(r => r.json()).then(data => {
            if (data.success) window.location.href = data.redirect || '{{ path('user_dashboard') }}';
            else alert(data.error || 'Erreur Facebook');
        });
    });
}
</script>
{% endif %}

{% if facebook_app_id %}
<div id="fb-root"></div>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/fr_FR/sdk.js#{{ facebook_app_id }}"></script>
<script>
function loginWithFacebook() {
    FB.init({
        appId: '{{ facebook_app_id }}',
        cookie: true,
        xfbml: true,
        version: 'v18.0'
    });

    FB.getLoginStatus(function(response) {
        if (response.status === 'connected') {
            fbApiLogin(response.authResponse);
        } else {
            FB.login(function(response) {
                if (response.authResponse) fbApiLogin(response.authResponse);
            }, {scope: 'email,public_profile'});
        }
    });
}

function fbApiLogin(authResponse) {
    FB.api('/me?fields=id,name,email,picture', function(userData) {
        fetch('{{ path('api_auth_facebook') }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                facebook_token: authResponse.accessToken,
                facebook_id: userData.id,
                email: userData.email || userData.id + '@facebook.local',
                name: userData.name,
                avatar: userData.picture?.data?.url
            })
        }).then(r => r.json()).then(data => {
            if (data.success) window.location.href = data.redirect || '{{ path('user_dashboard') }}';
            else alert(data.error || 'Erreur Facebook');
        });
    });
}
</script>
{% endif %}
</body>
</html>
