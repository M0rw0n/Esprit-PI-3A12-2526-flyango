<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription — Fly&Go</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/flyandgo.css') }}">
    <style>
        body { 
            background: 
                linear-gradient(135deg, rgba(27,58,107,0.85) 0%, rgba(27,58,107,0.75) 100%),
                url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1920&q=80') center/cover no-repeat fixed;
            min-height: 100vh; 
            font-family: 'Outfit', sans-serif; 
            position: relative;
        }
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(ellipse at 30% 70%, rgba(0,180,216,0.25) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 30%, rgba(255,183,0,0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(27,58,107,0.4) 0%, transparent 70%);
            pointer-events: none;
            animation: bgShift 20s ease-in-out infinite;
        }
        @keyframes bgShift {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3z' fill='%2300B4D8' fill-opacity='0.03' fill-rule='evenodd'/%3E%3C/svg%3E");
            pointer-events: none;
        }
        .auth-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; position: relative; z-index: 1; }
        .auth-card { background: rgba(255,255,255,0.97); backdrop-filter: blur(20px); border-radius: 24px; box-shadow: 0 25px 80px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.15); width: 100%; max-width: 520px; overflow: hidden; position: relative; animation: fadeInUp 0.6s ease; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        .auth-card__head { background: linear-gradient(135deg, #1B3A6B 0%, #1B3A6B 50%, #0d2847 100%); padding: 2rem 2rem 1.75rem; text-align: center; color: white; position: relative; overflow: hidden; }
        .auth-card__head::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(circle at 30% 50%, rgba(0,180,216,0.2) 0%, transparent 40%),
                radial-gradient(circle at 70% 50%, rgba(255,183,0,0.15) 0%, transparent 40%);
            animation: pulse 8s ease-in-out infinite;
        }
        .auth-card__head::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #00B4D8 0%, #FFB700 50%, #00B4D8 100%);
        }
        @keyframes pulse { 0%, 100% { transform: scale(1); opacity: 0.6; } 50% { transform: scale(1.05); opacity: 1; } }
        .auth-logo { margin-bottom: 1rem; position: relative; display: flex; justify-content: center; }
        .auth-logo img { height: 90px; width: auto; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3)); }
        .auth-card__head h1 { font-size: 1.1rem; font-weight: 600; margin: 0.5rem 0 0; opacity: 0.95; position: relative; }
        .auth-card__head p { font-size: 0.82rem; opacity: 0.75; margin: 0; position: relative; }
        .auth-card__body { padding: 1.75rem 2rem 2rem; position: relative; }
        .auth-decor {
            position: absolute;
            top: 0;
            right: 0;
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, rgba(0,180,216,0.3), transparent);
            border-radius: 0 0 0 100%;
        }
        .auth-decor-2 {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, transparent, rgba(255,183,0,0.2));
            border-radius: 0 100% 0 0;
        }
        .err { background: #fee2e2; border: 1px solid #fca5a5; border-radius: 12px; padding: 0.75rem 1rem; color: #991b1b; font-size: 0.82rem; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; animation: shake 0.4s ease; }
        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .fg-group { margin-bottom: 1rem; }
        .fg-label { display: block; font-size: 0.8rem; font-weight: 600; color: #374151; margin-bottom: 0.4rem; }
        .fg-input-wrap { position: relative; }
        .fg-input { width: 100%; padding: 0.8rem 1rem; border: 2px solid #e5e7eb; border-radius: 12px; font-size: 0.9rem; font-family: inherit; transition: all 0.3s ease; background: #f9fafb; box-sizing: border-box; }
        .fg-input:focus { outline: none; border-color: #00B4D8; background: white; box-shadow: 0 0 0 4px rgba(0,180,216,0.1); }
        .fg-input.error { border-color: #ef4444; background: #fef2f2; }
        .fg-input.valid { border-color: #10b981; background: #f0fdf4; }
        .password-wrap .fg-input { padding-right: 3rem; }
        .password-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9ca3af; font-size: 1rem; padding: 0.5rem; transition: color 0.3s; }
        .password-toggle:hover { color: #1a365d; }
        .strength-bar { display: flex; gap: 4px; margin-top: 0.5rem; }
        .strength-segment { height: 4px; flex: 1; border-radius: 2px; background: #e5e7eb; transition: background 0.3s; }
        .strength-text { font-size: 0.75rem; margin-top: 0.35rem; display: flex; justify-content: space-between; }
        .strength-label { font-weight: 600; }
        .strength-requirements { font-size: 0.72rem; color: #6b7280; margin-top: 0.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; }
        .requirement { display: flex; align-items: center; gap: 0.35rem; }
        .requirement i { font-size: 0.65rem; }
        .requirement.valid { color: #10b981; }
        .requirement.invalid { color: #9ca3af; }
        .terms-row { display: flex; align-items: flex-start; gap: 0.5rem; margin-bottom: 1.25rem; font-size: 0.82rem; color: #6b7280; }
        .terms-row input { margin-top: 0.2rem; accent-color: #1a365d; width: 16px; height: 16px; cursor: pointer; }
        .terms-row a { color: #1a365d; text-decoration: none; }
        .terms-row a:hover { text-decoration: underline; }
        .btn-navy { background: linear-gradient(135deg, #1B3A6B, #2a4a7f); color: white; border: none; padding: 0.9rem 1.5rem; border-radius: 12px; font-size: 0.95rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.3s ease; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
        .btn-navy:hover { background: linear-gradient(135deg, #2a4a7f, #1B3A6B); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(27,58,107,0.4); }
        .btn-navy:active { transform: translateY(0); }
        .btn-navy:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
        .auth-divider { display: flex; align-items: center; gap: 1rem; margin: 1.25rem 0; color: #6b7280; font-size: 0.8rem; }
        .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, #e5e7eb, transparent); }
        .btn-outline { background: transparent; color: #1B3A6B; border: 2px solid #1B3A6B; padding: 0.8rem 1.5rem; border-radius: 12px; font-size: 0.9rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.3s ease; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-decoration: none; box-sizing: border-box; }
        .btn-outline:hover { background: #FFB700; border-color: #FFB700; color: #1B3A6B; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(255,183,0,0.3); }
        .terms-row a { color: #00B4D8; text-decoration: none; }
        .terms-row a:hover { color: #FFB700; text-decoration: underline; }
        .back-link { text-align: center; margin-top: 1.25rem; }
        .back-link a { color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.3s; }
        .back-link a:hover { color: white; }
        @media (max-width: 500px) {
            .form-row { grid-template-columns: 1fr; }
            .strength-requirements { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-card__head">
            <div class="auth-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Fly&Go">
            </div>
            <h1>Créer votre compte</h1>
            <p>Rejoignez des milliers de voyageurs !</p>
        </div>
        <div class="auth-card__body">
            {% if errors|length > 0 %}
                {% for err in errors %}
                <div class="err">
                    <i class="fas fa-exclamation-circle"></i>
                    {{ err }}
                </div>
                {% endfor %}
            {% endif %}

            <form action="{{ path('app_register') }}" method="POST" id="registerForm" onsubmit="return validateForm()">
                <div class="form-row">
                    <div class="fg-group">
                        <label class="fg-label">Prénom *</label>
                        <input type="text" name="prenom" class="fg-input" id="prenomInput" required placeholder="Prénom" autocomplete="given-name">
                    </div>
                    <div class="fg-group">
                        <label class="fg-label">Nom *</label>
                        <input type="text" name="nom" class="fg-input" id="nomInput" required placeholder="Nom" autocomplete="family-name">
                    </div>
                </div>

                <div class="fg-group">
                    <label class="fg-label">Adresse email *</label>
                    <input type="email" name="email" class="fg-input" id="emailInput" required placeholder="votre@email.com" autocomplete="email">
                </div>

                <div class="fg-group">
                    <label class="fg-label">Téléphone</label>
                    <input type="tel" name="telephone" class="fg-input" placeholder="+216 XX XXX XXX" autocomplete="tel">
                </div>

                <div class="fg-group">
                    <label class="fg-label">Mot de passe *</label>
                    <div class="fg-input-wrap password-wrap">
                        <input type="password" name="password" class="fg-input" id="passwordInput" required placeholder="••••••••" oninput="checkPasswordStrength()" autocomplete="new-password">
                        <button type="button" class="password-toggle" onclick="togglePassword('passwordInput', 'passwordIcon')" aria-label="Afficher/Masquer">
                            <i class="fas fa-eye" id="passwordIcon"></i>
                        </button>
                    </div>
                    <div class="strength-bar" id="strengthBar">
                        <div class="strength-segment" id="seg1"></div>
                        <div class="strength-segment" id="seg2"></div>
                        <div class="strength-segment" id="seg3"></div>
                        <div class="strength-segment" id="seg4"></div>
                    </div>
                    <div class="strength-text">
                        <span class="strength-label" id="strengthLabel">Force du mot de passe</span>
                        <span id="strengthPercent">0%</span>
                    </div>
                    <div class="strength-requirements">
                        <div class="requirement invalid" id="reqLen"><i class="fas fa-circle"></i> 8+ caractères</div>
                        <div class="requirement invalid" id="reqMaj"><i class="fas fa-circle"></i> Majuscule</div>
                        <div class="requirement invalid" id="reqMin"><i class="fas fa-circle"></i> Minuscule</div>
                        <div class="requirement invalid" id="reqChiffre"><i class="fas fa-circle"></i> Chiffre</div>
                        <div class="requirement invalid" id="reqSpe"><i class="fas fa-circle"></i> Caractère spécial</div>
                    </div>
                </div>

                <div class="fg-group">
                    <label class="fg-label">Confirmer le mot de passe *</label>
                    <div class="fg-input-wrap password-wrap">
                        <input type="password" name="password_confirm" class="fg-input" id="confirmInput" required placeholder="••••••••" oninput="checkMatch()" autocomplete="new-password">
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmInput', 'confirmIcon')" aria-label="Afficher/Masquer">
                            <i class="fas fa-eye" id="confirmIcon"></i>
                        </button>
                    </div>
                    <div class="strength-text" id="matchStatus" style="display:none">
                        <span>Confirmation</span>
                        <span id="matchText"></span>
                    </div>
                </div>

                <div class="terms-row">
                    <input type="checkbox" id="termsCheck" required>
                    <label for="termsCheck">J'accepte les <a href="#">Conditions d'utilisation</a> et la <a href="#">Politique de confidentialité</a></label>
                </div>

                <button type="submit" class="btn-navy" id="submitBtn">
                    <i class="fas fa-user-plus"></i>
                    Créer mon compte
                </button>
            </form>

            <div class="auth-divider">déjà inscrit ?</div>

            <a href="{{ path('app_login') }}" class="btn-outline">
                <i class="fas fa-sign-in-alt"></i>
                Se connecter
            </a>

            <div class="back-link">
                <a href="{{ path('home') }}">
                    <i class="fas fa-arrow-left"></i>
                    Retour au site
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}

function checkPasswordStrength() {
    const pwd = document.getElementById('passwordInput').value;
    const reqs = {
        len: pwd.length >= 8,
        maj: /[A-Z]/.test(pwd),
        min: /[a-z]/.test(pwd),
        chiffre: /[0-9]/.test(pwd),
        spe: /[^A-Za-z0-9]/.test(pwd)
    };
    
    const validCount = Object.values(reqs).filter(Boolean).length;
    const percent = Math.round((validCount / 5) * 100);
    
    ['seg1','seg2','seg3','seg4'].forEach((id, i) => {
        const seg = document.getElementById(id);
        seg.style.background = i < Math.ceil(validCount / 1.25) ? 
            (percent < 40 ? '#ef4444' : percent < 70 ? '#f59e0b' : '#10b981') : '#e5e7eb';
    });
    
    const label = document.getElementById('strengthLabel');
    const percentSpan = document.getElementById('strengthPercent');
    if (percent === 0) { label.textContent = 'Force du mot de passe'; label.style.color = '#6b7280'; }
    else if (percent < 40) { label.textContent = 'Faible'; label.style.color = '#ef4444'; }
    else if (percent < 70) { label.textContent = 'Moyen'; label.style.color = '#f59e0b'; }
    else if (percent < 100) { label.textContent = 'Fort'; label.style.color = '#10b981'; }
    else { label.textContent = 'Excellent'; label.style.color = '#059669'; }
    percentSpan.textContent = percent + '%';
    percentSpan.style.color = label.style.color;
    
    ['reqLen','reqMaj','reqMin','reqChiffre','reqSpe'].forEach((id, i) => {
        const req = document.getElementById(id);
        const vals = ['len','maj','min','chiffre','spe'];
        req.className = 'requirement ' + (reqs[vals[i]] ? 'valid' : 'invalid');
        req.querySelector('i').className = reqs[vals[i]] ? 'fas fa-check-circle' : 'fas fa-circle';
    });
}

function checkMatch() {
    const pwd = document.getElementById('passwordInput').value;
    const confirm = document.getElementById('confirmInput').value;
    const status = document.getElementById('matchStatus');
    const text = document.getElementById('matchText');
    
    if (confirm.length > 0) {
        status.style.display = 'flex';
        if (pwd === confirm) {
            text.textContent = '✓ Correspond';
            text.style.color = '#10b981';
            document.getElementById('confirmInput').classList.remove('error');
            document.getElementById('confirmInput').classList.add('valid');
        } else {
            text.textContent = '✗ Ne correspond pas';
            text.style.color = '#ef4444';
            document.getElementById('confirmInput').classList.add('error');
            document.getElementById('confirmInput').classList.remove('valid');
        }
    } else {
        status.style.display = 'none';
    }
}

function validateForm() {
    const pwd = document.getElementById('passwordInput').value;
    const confirm = document.getElementById('confirmInput').value;
    const terms = document.getElementById('termsCheck').checked;
    
    if (pwd !== confirm) {
        alert('Les mots de passe ne correspondent pas.');
        return false;
    }
    
    if (pwd.length < 8) {
        alert('Le mot de passe doit contenir au moins 8 caractères.');
        return false;
    }
    
    if (!terms) {
        alert('Veuillez accepter les conditions.');
        return false;
    }
    
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Création en cours...';
    return true;
}

document.getElementById('emailInput').addEventListener('blur', function() {
    const val = this.value.trim();
    if (val && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
        this.classList.add('error');
        this.classList.remove('valid');
    } else if (val) {
        this.classList.remove('error');
        this.classList.add('valid');
    }
});
</script>
</body>
</html>
