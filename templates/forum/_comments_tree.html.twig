{% macro comment_item(item, user, depth) %}
{% set depth = depth|default(0) %}
{% set comment = item.comment %}
<div class="comment-wrapper" data-depth="{{ depth }}">
    <div class="comment" data-comment-id="{{ item.id }}" style="display:flex;gap:.5rem;padding:.7rem 0">
        <div class="comment-left" style="display:flex;flex-direction:column;align-items:center;gap:.2rem">
            <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--navy),var(--cyan));color:#fff;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;flex-shrink:0">{{ item.author|slice(0,1)|upper }}</div>
            {% if item.replies|length > 0 %}
            <div style="width:2px;flex:1;background:var(--border);min-height:10px"></div>
            {% endif %}
        </div>
        <div style="flex:1;min-width:0">
            <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.2rem;font-size:.75rem;color:var(--muted);flex-wrap:wrap">
                <a href="#" style="color:var(--text);text-decoration:none;font-weight:600">{{ item.author }}</a>
                <span>·</span>
                <span>{{ item.createdAt is defined and item.createdAt ? item.createdAt|date('d/m/Y H:i') : '' }}</span>
                {% if item.isPinned %}
                <span style="color:var(--gold);font-size:.7rem;font-weight:700"><i class="fa fa-thumbtack"></i> Épinglé</span>
                {% endif %}
            </div>
            <div style="font-size:.9rem;line-height:1.55;color:var(--text);word-wrap:break-word">
                {% if item.content %}
                    {{ item.content|nl2br }}
                {% else %}
                    <span style="color:var(--muted);font-style:italic">[supprimé]</span>
                {% endif %}
            </div>
            <div class="comment-actions" style="display:flex;align-items:center;gap:.15rem;margin-top:.3rem">
                <button class="vote-btn up {{ item.userVote == 1 ? 'active' : '' }}"
                        data-vote="1" data-comment="{{ item.id }}"
                        style="display:inline-flex;align-items:center;gap:.2rem;padding:.3rem .45rem;border:none;background:none;color:var(--muted);font-size:.73rem;font-weight:600;cursor:pointer;border-radius:4px;transition:all .15s"
                        onmouseover="this.style.background='var(--border)'" onmouseout="this.style.background='none'">
                    <i class="fa fa-arrow-up"></i>
                </button>
                <span class="score" style="padding:.3rem .2rem;font-size:.73rem;font-weight:700;color:var(--text)">{{ item.score }}</span>
                <button class="vote-btn down {{ item.userVote == -1 ? 'active' : '' }}"
                        data-vote="-1" data-comment="{{ item.id }}"
                        style="display:inline-flex;align-items:center;gap:.2rem;padding:.3rem .45rem;border:none;background:none;color:var(--muted);font-size:.73rem;font-weight:600;cursor:pointer;border-radius:4px;transition:all .15s"
                        onmouseover="this.style.background='var(--border)'" onmouseout="this.style.background='none'">
                    <i class="fa fa-arrow-down"></i>
                </button>
                {% if user %}
                <button class="reply-btn" data-comment="{{ item.id }}" data-author="{{ item.author }}"
                        style="display:inline-flex;align-items:center;gap:.25rem;padding:.3rem .55rem;border:none;background:none;color:var(--muted);font-size:.73rem;font-weight:600;cursor:pointer;border-radius:4px;transition:all .15s"
                        onmouseover="this.style.background='var(--border)';this.style.color='var(--text)'" onmouseout="this.style.background='none';this.style.color='var(--muted)'">
                    <i class="fa fa-reply"></i> Répondre
                </button>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                <button data-action="pin" data-comment="{{ item.id }}"
                        style="display:inline-flex;align-items:center;gap:.25rem;padding:.3rem .45rem;border:none;background:none;color:var(--gold-d, #d4a017);font-size:.73rem;font-weight:600;cursor:pointer;border-radius:4px"
                        title="{{ item.isPinned ? 'Désépingler' : 'Épingler' }}">
                    <i class="fa fa-thumbtack"></i>
                </button>
                <button data-action="delete" data-comment="{{ item.id }}"
                        style="display:inline-flex;align-items:center;gap:.25rem;padding:.3rem .45rem;border:none;background:none;color:#dc3545;font-size:.73rem;font-weight:600;cursor:pointer;border-radius:4px"
                        title="Supprimer">
                    <i class="fa fa-trash"></i>
                </button>
                {% endif %}
            </div>

            {# Reply Form #}
            {% if user %}
            <div class="reply-form" id="reply-form-{{ item.id }}" style="margin-top:.5rem;display:none">
                <form data-parent="{{ item.id }}">
                    <textarea style="width:100%;padding:.55rem;border:1.5px solid var(--border);border-radius:6px;font-size:.85rem;font-family:var(--font);resize:vertical;min-height:55px;outline:none" placeholder="Écrire une réponse..." rows="2"></textarea>
                    <div style="display:flex;justify-content:flex-end;gap:.4rem;margin-top:.4rem">
                        <button type="button" class="btn btn-outline btn-sm cancel-reply">Annuler</button>
                        <button type="submit" class="btn btn-navy btn-sm">Répondre</button>
                    </div>
                </form>
            </div>
            {% endif %}
        </div>
    </div>

    {# Nested Replies #}
    {% if item.replies|length > 0 %}
    <div class="nested-replies" id="replies-{{ item.id }}" style="margin-left:1.25rem;border-left:2px solid var(--border);padding-left:.5rem">
        {% for reply in item.replies %}
            {{ _self.comment_item(reply, user, depth + 1) }}
        {% endfor %}
    </div>
    <button class="more-replies toggle-replies" data-comment="{{ item.id }}" style="display:inline-flex;align-items:center;gap:.3rem;padding:.4rem 0;color:var(--navy);font-size:.82rem;font-weight:600;cursor:pointer;background:none;border:none;margin-left:1.5rem">
        ▼ Masquer les réponses
    </button>
    {% endif %}
</div>
{% endmacro %}

{# Main Entry Point #}
<div>
    {% if commentsTree|length > 0 %}
        {% for item in commentsTree %}
            {{ _self.comment_item(item, user, 0) }}
        {% endfor %}
    {% else %}
        <div class="cempty" style="text-align:center;padding:3rem 1rem;color:var(--muted)">
            <i class="fa fa-comments" style="font-size:2rem;margin-bottom:.75rem;display:block;opacity:.4"></i>
            <p>Aucun commentaire. Soyez le premier !</p>
        </div>
    {% endif %}
</div>
