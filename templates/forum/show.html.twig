{% block body %}

{# ── Breadcrumb / Page hero ── #}
<div class="fg-page-hero fg-page-hero--forum">
    <div class="fg-page-hero__overlay"></div>
    <div class="fg-page-hero__content">
        <p class="fg-page-hero__eyebrow">
            <a href="{{ path('forum_index') }}" style="color:rgba(255,255,255,.7)"><i class="fa fa-arrow-left"></i> Forum</a>
            &nbsp;›&nbsp; Discussion
        </p>
        <h1>{{ post.title|length > 60 ? post.title|slice(0,60) ~ '…' : post.title }}</h1>
        <p>par <strong>{{ post.author }}</strong> · {{ post.createdAt|date('d/m/Y') }}</p>
    </div>
</div>

<div class="fg-forum-show-layout">

    {# ════ MAIN POST ════ #}
    <div class="fg-forum-show__post">
        <div class="fg-forum-show__post-header">
            <div class="fg-forum-card--full__avatar fg-forum-card--full__avatar--lg">
                {{ post.author|slice(0,1)|upper }}
            </div>
            <div class="fg-forum-show__post-meta">
                <strong>{{ post.author }}</strong>
                <span><i class="fa fa-calendar"></i> {{ post.createdAt|date('d/m/Y') }}</span>
                <span class="fg-forum-card--full__status fg-forum-card--full__status--{{ post.status|lower }}">
                    {{ post.status == 'APPROVED' ? '✅ Approuvé' : (post.status == 'PENDING' ? '⏳ En attente' : '❌ Rejeté') }}
                </span>
            </div>
            <div class="fg-forum-show__post-actions">
                <button class="fg-reaction-btn fg-reaction-btn--lg" onclick="reactPost({{ post.id }}, 'LIKE')" title="J'aime">👍</button>
                <button class="fg-reaction-btn fg-reaction-btn--lg" onclick="reactPost({{ post.id }}, 'LOVE')" title="J'adore">❤️</button>
                <button class="fg-reaction-btn fg-reaction-btn--lg" onclick="reactPost({{ post.id }}, 'WOW')" title="Wow">😮</button>
                <button class="fg-btn fg-btn--danger fg-btn--sm" onclick="if(confirm('Supprimer ?')) deletePost({{ post.id }})">
                    <i class="fa fa-trash"></i> Supprimer
                </button>
            </div>
        </div>

        <div class="fg-forum-show__post-body">
            {{ post.content|nl2br }}
        </div>

        <div class="fg-forum-show__post-stats">
            <span><i class="fa fa-comments"></i> {{ post.comments|length }} commentaire(s)</span>
            <span><i class="fa fa-thumbs-up"></i> {{ post.reactions|length }} réaction(s)</span>
        </div>
    </div>

    {# ════ COMMENTS ════ #}
    <div class="fg-forum-show__comments">
        <h3 class="fg-forum-show__comments-title">
            <i class="fa fa-comments"></i>
            Commentaires ({{ post.comments|length }})
        </h3>

        {# Comment list #}
        <div id="commentsList">
            {% for comment in post.comments %}
            <div class="fg-forum-comment">
                <div class="fg-forum-card--full__avatar">
                    {{ comment.author|slice(0,1)|upper }}
                </div>
                <div class="fg-forum-comment__body">
                    <div class="fg-forum-comment__header">
                        <strong>{{ comment.author }}</strong>
                        <span>{{ comment.createdAt|date('d/m/Y') }}</span>
                    </div>
                    <p>{{ comment.content|nl2br }}</p>
                </div>
            </div>
            {% else %}
            <div class="fg-empty-state" id="noComments" style="padding:2rem">
                <i class="fa fa-comments"></i>
                <p>Aucun commentaire. Soyez le premier !</p>
            </div>
            {% endfor %}
        </div>

        {# Add comment form #}
        <div class="fg-forum-show__add-comment">
            <h4><i class="fa fa-pen"></i> Ajouter un commentaire</h4>
            <div class="fg-booking-form__field">
                <label>Votre nom / pseudo</label>
                <input type="text" id="commentAuthor" placeholder="Votre prénom" maxlength="100">
            </div>
            <div class="fg-booking-form__field">
                <label>Commentaire</label>
                <textarea id="commentContent" rows="4" placeholder="Partagez votre avis, votre expérience…"></textarea>
            </div>
            <div id="commentErrors"></div>
            <button class="fg-btn fg-btn--orange" id="submitCommentBtn" onclick="submitComment()">
                <i class="fa fa-paper-plane"></i> Publier le commentaire
            </button>
        </div>
    </div>

    {# ════ SIDEBAR ════ #}
    <aside class="fg-forum-show__sidebar">
        <div class="fg-forum-show__sidebar-card">
            <h4>À propos</h4>
            <ul>
                <li><i class="fa fa-user"></i> Auteur : <strong>{{ post.author }}</strong></li>
                <li><i class="fa fa-calendar"></i> Publié le : {{ post.createdAt|date('d/m/Y') }}</li>
                <li><i class="fa fa-comments"></i> Commentaires : <strong>{{ post.comments|length }}</strong></li>
                <li><i class="fa fa-thumbs-up"></i> Réactions : <strong>{{ post.reactions|length }}</strong></li>
            </ul>
        </div>

        <div class="fg-forum-show__sidebar-card">
            <h4>Navigation</h4>
            <a href="{{ path('forum_index') }}" class="fg-btn fg-btn--ghost" style="width:100%;justify-content:center;margin-bottom:.5rem">
                <i class="fa fa-list"></i> Toutes les discussions
            </a>
            <button class="fg-btn fg-btn--orange" style="width:100%;justify-content:center" onclick="openModal('newPostModal')">
                <i class="fa fa-plus"></i> Nouveau sujet
            </button>
        </div>
    </aside>
</div>

{# New post modal (same as index) #}
<div class="fg-modal-overlay" id="newPostModal">
    <div class="fg-modal fg-modal--lg">
        <div class="fg-modal__header">
            <h3><i class="fa fa-pen"></i> Nouveau sujet</h3>
            <button onclick="closeModal('newPostModal')"><i class="fa fa-times"></i></button>
        </div>
        <div class="fg-modal__body">
            <div class="fg-booking-form__field"><label>Votre nom</label><input type="text" id="postAuthor" placeholder="Prénom"></div>
            <div class="fg-booking-form__field"><label>Titre</label><input type="text" id="postTitle" placeholder="Titre de votre sujet…"></div>
            <div class="fg-booking-form__field"><label>Contenu</label><textarea id="postContent" rows="5" placeholder="Votre message…"></textarea></div>
            <div id="postErrors"></div>
        </div>
        <div class="fg-modal__footer">
            <button class="fg-btn fg-btn--ghost" onclick="closeModal('newPostModal')">Annuler</button>
            <button class="fg-btn fg-btn--orange" onclick="submitPost()"><i class="fa fa-paper-plane"></i> Publier</button>
        </div>
    </div>
</div>

{% endblock %}

