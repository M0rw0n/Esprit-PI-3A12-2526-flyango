async function translatePost(postId, targetLang) {
    console.log('translatePost called: postId=' + postId + ', targetLang=' + targetLang);
    const translatedEl = document.getElementById('translated-post');
    translatedEl.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Traduction en cours...';
    translatedEl.style.display = 'block';
    try {
        console.log('Calling API...');
        const res = await fetch('/api/forum/post/' + postId + '/translate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'target=' + targetLang
        });
        console.log('Response status: ' + res.status);
        const data = await res.json();
        console.log('Response data:', data);
        if (data.success) {
            const langNames = {'en': 'English', 'ar': 'العربية', 'fr': 'Français', 'de': 'Deutsch', 'es': 'Español'};
            translatedEl.innerHTML = '<strong>Traduction en ' + (langNames[targetLang] || targetLang) + ':</strong><br>' + 
                '<div style="margin-bottom:.5rem;font-weight:700">' + data.translated.title + '</div>' +
                data.translated.content.replace(/\n/g, '<br>') +
                '<div style="margin-top:.5rem;font-size:.7rem;color:var(--muted)"><a href="#" onclick="showPostTranslation(event);return false;">Masquer la traduction</a></div>';
        } else {
            translatedEl.innerHTML = 'Erreur: ' + (data.message || 'Traduit pas réussie');
        }
    } catch (e) {
        console.error('Error:', e);
        translatedEl.innerHTML = 'Erreur réseau: ' + e.message;
    }
}

function showPostTranslation() {
    const translatedEl = document.getElementById('translated-post');
    const titleEl = document.querySelector('.fb-post-title');
    const textEl = document.querySelector('.fb-post-text');
    
    if (translatedEl.style.display === 'block' && !arguments.length) {
        translatedEl.style.display = 'none';
        return;
    }
    
    const originalTitle = titleEl.dataset.original || titleEl.textContent;
    const originalText = textEl.dataset.original || textEl.innerText;
    
    if (!titleEl.dataset.original) {
        titleEl.dataset.original = originalTitle;
        textEl.dataset.original = originalText;
        titleEl.dataset.detectedLang = 'auto';
    }
    
    translatedEl.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Traduction...';
    translatedEl.style.display = 'block';
    
    fetch('/api/forum/detect-language', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'text=' + encodeURIComponent(originalText)
    })
    .then(r => r.json())
    .then(detectData => {
        const detectedLang = detectData.language || 'fr';
        const translateTo = (detectedLang === 'fr' ? 'en' : detectedLang === 'en' ? 'fr' : 'en');
        titleEl.dataset.detectedLang = translateTo;
        
        return fetch('/api/forum/post/{{ post.id }}/translate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'target=' + translateTo
        });
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            const langNames = {'en': 'English', 'ar': 'العربية', 'fr': 'Français'};
            translatedEl.innerHTML = '<strong>Traduction en ' + langNames[data.language] + ':</strong><br>' + 
                '<div style="margin-bottom:.5rem;font-weight:700">' + data.translated.title + '</div>' +
                data.translated.content.replace(/\n/g, '<br>') +
                '<div style="margin-top:.5rem;font-size:.7rem;color:var(--muted)"><a href="#" onclick="showPostTranslation(event)">Voir en autre langue</a></div>';
        } else {
            translatedEl.innerHTML = 'Erreur de traduction';
        }
    })
    .catch(() => {
        translatedEl.innerHTML = 'Erreur de traduction';
    });
}

