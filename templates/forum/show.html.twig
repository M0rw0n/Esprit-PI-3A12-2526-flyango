// ==================== FRIEND REQUEST & SHARE FUNCTIONS ====================

function showNotification(title, text) {
    var notif = document.createElement('div');
    notif.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);padding:12px 24px;background:#1B3A6B;color:white;border-radius:8px;z-index:9999;font-size:14px;animation:fadeIn 0.3s';
    notif.innerHTML = '<strong>' + title + '</strong><br><span style="font-size:12px">' + text + '</span>';
    document.body.appendChild(notif);
    setTimeout(function() { notif.remove(); }, 3500);
}

function handleAddFriend(postId, authorName) {
    console.log('handleAddFriend called:', postId, authorName);
    
    var btn = document.getElementById('add-friend-btn-' + postId);
    var textEl = document.getElementById('friend-btn-text-' + postId);
    
    if (!btn) {
        console.error('Button not found:', 'add-friend-btn-' + postId);
        return;
    }
    
    btn.disabled = true;
    btn.style.opacity = '0.7';
    
    // First, search for the user by name to get their ID
    fetch('/api/friend/search?name=' + encodeURIComponent(authorName), {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { 
        console.log('Search response status:', r.status);
        return r.json(); 
    })
    .then(function(data) {
        console.log('Search data:', data);
        
        if (!data.users || data.users.length === 0) {
            btn.disabled = false;
            btn.style.opacity = '1';
            showNotification('Erreur', 'Utilisateur "' + authorName + '" non trouvé');
            return null;
        }
        
        var user = data.users[0];
        console.log('Found user:', user);
        
        // Now send friend request
        return fetch('/api/friend/request/' + user.id, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
    })
    .then(function(r) { 
        if (!r) return null;
        console.log('Friend request response status:', r.status);
        return r.json(); 
    })
    .then(function(data) {
        console.log('Friend request data:', data);
        
        btn.disabled = false;
        btn.style.opacity = '1';
        
        if (data && data.success) {
            if (data.status === 'accepted') {
                textEl.textContent = '✓ Amis';
                btn.style.background = 'var(--success, #10B981)';
                showNotification('Ami ajouté !', authorName + ' est maintenant votre ami.');
            } else {
                textEl.textContent = '⏳ Envoyé';
                btn.style.background = 'var(--gold, #FFB700)';
                btn.style.color = '#000';
                showNotification('Demande envoyée', 'Votre demande a été envoyée à ' + authorName + '.');
            }
        } else {
            showNotification('Erreur', data?.error || 'Impossible d\'envoyer la demande');
        }
    })
    .catch(function(err) {
        console.error('Error:', err);
        btn.disabled = false;
        btn.style.opacity = '1';
        showNotification('Erreur', 'Problème de connexion');
    });
}

// Direct friend request using author ID
function sendFriendRequestDirect(authorId, postId) {
    console.log('sendFriendRequestDirect called:', authorId, postId);
    
    var btn = document.getElementById('add-friend-btn-' + postId);
    var textEl = document.getElementById('friend-btn-text-' + postId);
    
    if (!btn || !authorId) {
        console.error('Button or authorId not found');
        return;
    }
    
    btn.disabled = true;
    btn.style.opacity = '0.7';
    
    fetch('/api/friend/request/' + authorId, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { 
        console.log('Friend request response status:', r.status);
        return r.json(); 
    })
    .then(function(data) {
        console.log('Friend request data:', data);
        
        btn.disabled = false;
        btn.style.opacity = '1';
        
        if (data && data.success) {
            if (data.status === 'accepted') {
                textEl.textContent = '✓ Amis';
                btn.style.background = '#10B981';
                showNotification('Ami ajouté !', 'Vous êtes maintenant amis.');
            } else {
                textEl.textContent = '⏳ Envoyé';
                btn.style.background = '#FFB700';
                btn.style.color = '#000';
                showNotification('Demande envoyée', 'Votre demande a été envoyée.');
            }
        } else {
            showNotification('Erreur', data ? data.error : 'Impossible d\'envoyer la demande');
        }
    })
    .catch(function(err) {
        console.error('Error:', err);
        btn.disabled = false;
        btn.style.opacity = '1';
        showNotification('Erreur', 'Problème de connexion');
    });
}

// Search user by name then send friend request
function handleAddFriend(postId, authorName) {
    console.log('handleAddFriend called:', postId, authorName);
    
    var btn = document.getElementById('add-friend-btn-' + postId);
    var textEl = document.getElementById('friend-btn-text-' + postId);
    
    if (!btn) {
        console.error('Button not found');
        return;
    }
    
    btn.disabled = true;
    btn.style.opacity = '0.7';
    
    fetch('/api/friend/search?name=' + encodeURIComponent(authorName), {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { 
        console.log('Search response status:', r.status);
        return r.json(); 
    })
    .then(function(data) {
        console.log('Search data:', data);
        
        if (!data.users || data.users.length === 0) {
            btn.disabled = false;
            btn.style.opacity = '1';
            showNotification('Erreur', 'Utilisateur non trouvé');
            return null;
        }
        
        var user = data.users[0];
        console.log('Found user:', user);
        
        return fetch('/api/friend/request/' + user.id, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
    })
    .then(function(r) { 
        if (!r) return null;
        console.log('Friend request response status:', r.status);
        return r.json(); 
    })
    .then(function(data) {
        console.log('Friend request data:', data);
        
        btn.disabled = false;
        btn.style.opacity = '1';
        
        if (data && data.success) {
            if (data.status === 'accepted') {
                textEl.textContent = '✓ Amis';
                btn.style.background = '#10B981';
                showNotification('Ami ajouté !', authorName + ' est maintenant votre ami.');
            } else {
                textEl.textContent = '⏳ Envoyé';
                btn.style.background = '#FFB700';
                btn.style.color = '#000';
                showNotification('Demande envoyée', 'Votre demande a été envoyée à ' + authorName + '.');
            }
        } else {
            showNotification('Erreur', data ? data.error : 'Impossible d\'envoyer la demande');
        }
    })
    .catch(function(err) {
        console.error('Error:', err);
        btn.disabled = false;
        btn.style.opacity = '1';
        showNotification('Erreur', 'Problème de connexion');
    });
}

function showNotification(title, text) {
    var notif = document.createElement('div');
    notif.style.cssText = 'position:fixed;bottom:20px;right:20px;background:linear-gradient(135deg,#1B3A6B,#00B4D8);color:white;padding:1rem 1.5rem;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.3);z-index:3000;font-size:.9rem;max-width:300px;animation:slideUp .3s ease';
    notif.innerHTML = '<div style="font-weight:700;margin-bottom:.25rem">' + title + '</div><div style="opacity:.9">' + text + '</div>';
    document.body.appendChild(notif);
    
    setTimeout(function() { 
        notif.style.animation = 'fadeOut .3s ease forwards'; 
        setTimeout(function() { notif.remove(); }, 300); 
    }, 3000);
}

function showCopySuccess() {
    var msg = document.getElementById('copySuccessMsg');
    if (msg) {
        msg.style.display = 'block';
        setTimeout(function() {
            msg.style.display = 'none';
        }, 2500);
    }
    showNotification('Lien copié !', 'Le lien a été copié dans le presse-papiers.');
}

document.addEventListener('click', function(e) {
    var modal = document.getElementById('shareModal');
    if (e.target === modal) closeShareModal();
});
</script>
