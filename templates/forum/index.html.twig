{% block title %}Forum — Fly&Go{% endblock %}

{% block body %}

{# ── Page Hero ── #}
<div class="fg-page-hero fg-page-hero--forum">
    <div class="fg-page-hero__overlay"></div>
    <div class="fg-page-hero__content">
        <p class="fg-page-hero__eyebrow">💬 Communauté</p>
        <h1>Forum <em>Voyageurs</em></h1>
        <p>Partagez vos expériences, posez vos questions, inspirez les autres</p>
    </div>
</div>

<div class="fg-forum-layout">

    {# ── Toolbar ── #}
    <div class="fg-forum-toolbar">
        <div class="fg-forum-toolbar__left">
            <div class="fg-filters__search-wrap" style="max-width:400px">
                <i class="fa fa-search"></i>
                <input type="text" id="forumSearch" placeholder="Rechercher une discussion…" autocomplete="off">
                <div class="fg-spinner" id="forumSpinner"></div>
            </div>
            <span class="fg-activities-count" id="forumCount">{{ posts|length }} discussion(s)</span>
        </div>
        <div class="fg-forum-toolbar__right">
            <select id="forumSort" class="fg-filters__select" onchange="sortForum()">
                <option value="recent">Plus récents</option>
                <option value="popular">Plus populaires</option>
                <option value="alpha">A → Z</option>
            </select>
            <button class="fg-btn fg-btn--orange" onclick="openModal('newPostModal')">
                <i class="fa fa-plus"></i> Nouveau sujet
            </button>
        </div>
    </div>

    {# ── Forum Grid ── #}
    <div class="fg-forum-cards" id="forumGrid">
        {% for post in posts %}
        <div class="fg-forum-card--full fg-anim-in"
             id="post-{{ post.id }}"
             data-title="{{ post.title|lower }}"
             data-date="{{ post.createdAt|date('Y-m-d') }}"
             data-comments="{{ post.comments|length }}"
             style="animation-delay: {{ loop.index0 * 0.07 }}s">

            {# Status color bar #}
            <div class="fg-forum-card--full__bar fg-forum-card--full__bar--{{ post.status|lower }}"></div>

            <div class="fg-forum-card--full__content">
                <div class="fg-forum-card--full__left">
                    <div class="fg-forum-card--full__avatar">
                        {{ post.author|slice(0,1)|upper }}
                    </div>
                    <div class="fg-forum-card--full__meta">
                        <strong>{{ post.author }}</strong>
                        <span><i class="fa fa-clock"></i> {{ post.createdAt|date('d/m/Y') }}</span>
                    </div>
                </div>

                <div class="fg-forum-card--full__body">
                    <div class="fg-forum-card--full__title-row">
                        <h3 class="fg-forum-card--full__title">{{ post.title }}</h3>
                        <span class="fg-forum-card--full__status fg-forum-card--full__status--{{ post.status|lower }}">
                            {{ post.status == 'APPROVED' ? '✅ Approuvé' : (post.status == 'PENDING' ? '⏳ En attente' : '❌ Rejeté') }}
                        </span>
                    </div>
                    <p class="fg-forum-card--full__excerpt">
                        {{ post.content|slice(0, 180) }}{% if post.content|length > 180 %}…{% endif %}
                    </p>
                    <div class="fg-forum-card--full__footer">
                        <div class="fg-forum-card--full__stats">
                            <span><i class="fa fa-comments"></i> {{ post.comments|length }} commentaire(s)</span>
                            <span><i class="fa fa-thumbs-up"></i> {{ post.reactions|length }} réaction(s)</span>
                        </div>
                        <div class="fg-forum-card--full__actions">
                            {# Reactions #}
                            <button class="fg-reaction-btn" onclick="reactPost({{ post.id }}, 'LIKE')"
                                    title="J'aime">👍</button>
                            <button class="fg-reaction-btn" onclick="reactPost({{ post.id }}, 'LOVE')"
                                    title="J'adore">❤️</button>
                            <button class="fg-reaction-btn" onclick="reactPost({{ post.id }}, 'WOW')"
