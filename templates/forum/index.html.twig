{% extends 'base/base.html.twig' %}
{% block title %}Forum des voyageurs — Fly&Go{% endblock %}
{% block body %}

<section class="page-hero">
    <div class="hero-content">
        <h1 class="hero-title">Forum des voyageurs</h1>
        <p class="hero-subtitle">Partagez vos expériences et découvrez des conseils de la communauté</p>
    </div>
</section>

<div class="fg-filter-sticky" id="filterSticky">
    <div class="fg-filter-inner">
        <form method="GET" action="{{ path('forum_index') }}" id="filterForm" class="fg-filter-form">
            <div class="fg-filter-row">
                <div class="fg-filter-search">
                    <i class="fa fa-search"></i>
                    <input type="text" name="q" value="{{ q }}" placeholder="Titre, contenu..." data-auto-submit>
                </div>
                <div class="fg-filter-select-wrap">
                    <i class="fa fa-tag"></i>
                    <select name="categorie" data-auto-submit>
                        <option value="">Toutes catégories</option>
                        <option value="Hébergement" {{ categorie|default('') == 'Hébergement' ? 'selected' : '' }}>Hébergement</option>
                        <option value="Circuit" {{ categorie|default('') == 'Circuit' ? 'selected' : '' }}>Circuit</option>
                        <option value="Activité" {{ categorie|default('') == 'Activité' ? 'selected' : '' }}>Activité</option>
                        <option value="Conseil" {{ categorie|default('') == 'Conseil' ? 'selected' : '' }}>Conseil</option>
                        <option value="Destination" {{ categorie|default('') == 'Destination' ? 'selected' : '' }}>Destination</option>
                        <option value="Transport" {{ categorie|default('') == 'Transport' ? 'selected' : '' }}>Transport</option>
                    </select>
                </div>
                <a href="{{ path('forum_index') }}" class="btn btn-outline" title="Réinitialiser">
                    <i class="fa fa-times"></i>
                </a>
                <a href="{{ path('forum_new') }}" class="btn btn-gold">
                    <i class="fa fa-plus"></i> Nouveau sujet
                </a>
            </div>
        </form>
    </div>
</div>

<div class="container" id="resultsContainer">
    <div class="fg-results-header">
        <div class="fg-results-info">
            <h2 class="fg-results-count">{{ posts|length }} sujet{{ posts|length > 1 ? 's' : '' }} trouvé{{ posts|length > 1 ? 's' : '' }}</h2>
            <p class="fg-results-sub">Rejoignez la communauté Fly&Go et partagez vos expériences</p>
        </div>
        <div class="fg-results-badges">
            {% for cat in ['Hébergement', 'Circuit', 'Activité', 'Conseil', 'Destination'] %}
            <a href="{{ path('forum_index', {categorie: cat}) }}" class="fg-cat-pill {{ categorie == cat ? 'active' : '' }}">{{ cat }}</a>
            {% endfor %}
        </div>
    </div>

    {% if posts %}
    <div class="forum-cards">
        {% for p in posts %}
        <a href="{{ path('forum_show', {id: p.id}) }}" class="fpost">
            <div class="fpost__bar fpost__bar--{{ p.status == 'APPROVED' ? 'approved' : p.status == 'PENDING' ? 'pending' : 'rejected' }}"></div>
            <div class="fpost__content">
                <div class="fpost__left">
                    <div class="fpost__av">{{ p.author ? p.author|slice(0,1)|upper : 'U' }}</div>
                    <div class="fpost__meta">
                        <strong>{{ p.author ?: 'Utilisateur' }}</strong>
                        <span>{{ p.createdAt|date('d M') }}</span>
                    </div>
                </div>
                <div class="fpost__body">
                    <div class="fpost__titlerow">
                        <h3 class="fpost__title">{{ p.title }}</h3>
                        <span class="fst fst--{{ p.status == 'APPROVED' ? 'approved' : p.status == 'PENDING' ? 'pending' : 'rejected' }}">{{ p.status == 'APPROVED' ? 'Approuvé' : p.status == 'PENDING' ? 'En attente' : 'Rejeté' }}</span>
                    </div>
                    <p class="fpost__txt">{{ p.content|length > 150 ? p.content|slice(0,150)~'…' : p.content }}</p>
                    <div class="fpost__foot">
                        <div class="fpost__stats">
                            {% if p.categorie %}<span><i class="fa fa-tag"></i> {{ p.categorie }}</span>{% endif %}
                            <span><i class="fa fa-comment"></i> {{ p.comments|length }} commentaire{{ p.comments|length != 1 ? 's' : '' }}</span>
                            <span><i class="fa fa-eye"></i> {{ p.vues ?: 0 }} vues</span>
                        </div>
                        <span class="btn btn-outline btn-sm">Lire →</span>
                    </div>
                </div>
            </div>
        </a>
        {% endfor %}
    </div>
    {% else %}
    <div class="fg-empty">
        <div class="fg-empty__icon"><i class="fa fa-comments"></i></div>
        <h3>Aucun sujet trouvé</h3>
        <p>Soyez le premier à créer un sujet dans le forum !</p>
        <a href="{{ path('forum_new') }}" class="btn btn-navy">Créer un sujet</a>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block stylesheets %}
<style>
.fg-filter-sticky{position:sticky;top:68px;z-index:50;background:#fff;border-bottom:1px solid var(--border);box-shadow:var(--s1);padding:.75rem 0}
.fg-filter-inner{max-width:1380px;margin:0 auto;padding:0 2rem}
.fg-filter-form{width:100%}
.fg-filter-row{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
.fg-filter-search{flex:1;min-width:200px;position:relative;display:flex;align-items:center;background:var(--bg);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:.6rem 1rem .6rem 2.5rem;transition:all var(--t)}
.fg-filter-search:focus-within{border-color:var(--navy);box-shadow:0 0 0 3px rgba(27,58,107,.08);background:#fff}
.fg-filter-search i{position:absolute;left:.85rem;color:var(--muted)}
.fg-filter-search input{border:none;background:none;outline:none;width:100%;font-size:.9rem;font-family:var(--font)}
.fg-filter-select-wrap{flex:1;min-width:140px;position:relative;display:flex;align-items:center;background:var(--bg);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:.6rem 1rem .6rem 2.5rem;transition:all var(--t)}
.fg-filter-select-wrap:focus-within{border-color:var(--navy);box-shadow:0 0 0 3px rgba(27,58,107,.08);background:#fff}
.fg-filter-select-wrap i{position:absolute;left:.85rem;color:var(--muted);pointer-events:none}
.fg-filter-select-wrap select{border:none;background:none;outline:none;width:100%;font-size:.9rem;font-family:var(--font);color:var(--text);cursor:pointer;appearance:none;-webkit-appearance:none;-moz-appearance:none}
.fg-results-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.75rem;flex-wrap:wrap;gap:1rem}
.fg-results-count{font-size:1.25rem;font-weight:800;color:var(--text);margin-bottom:.25rem}
.fg-results-sub{font-size:.85rem;color:var(--muted)}
.fg-results-badges{display:flex;gap:.5rem;flex-wrap:wrap}
.fg-cat-pill{display:inline-flex;align-items:center;padding:.35rem .75rem;border-radius:100px;background:var(--bg);border:1px solid var(--border);font-size:.75rem;font-weight:600;color:var(--muted);transition:all var(--t);text-decoration:none}
.fg-cat-pill:hover{border-color:var(--navy);color:var(--navy)}
.fg-cat-pill.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.fg-empty{text-align:center;padding:4rem 2rem}
.fg-empty__icon{width:80px;height:80px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;font-size:2rem;color:var(--muted)}
.fg-empty h3{font-size:1.25rem;font-weight:700;margin-bottom:.5rem;color:var(--text)}
.fg-empty p{color:var(--muted);margin-bottom:1.5rem}
.forum-cards{display:flex;flex-direction:column;gap:1rem}
.fpost{display:flex;background:var(--card);border-radius:var(--r);box-shadow:var(--s1);border:1px solid var(--border);overflow:hidden;transition:all var(--t);text-decoration:none;color:inherit}
.fpost:hover{transform:translateY(-3px);box-shadow:var(--s3);border-color:rgba(27,58,107,.18)}
.fpost__bar{width:5px;flex-shrink:0}
.fpost__bar--approved{background:linear-gradient(to bottom,#10b981,#059669)}
.fpost__bar--pending{background:linear-gradient(to bottom,#f59e0b,#d97706)}
.fpost__bar--rejected{background:linear-gradient(to bottom,#ef4444,#dc2626)}
.fpost__content{display:flex;gap:1.25rem;padding:1.5rem;flex:1;align-items:flex-start}
.fpost__left{display:flex;flex-direction:column;align-items:center;gap:.4rem;min-width:70px}
.fpost__av{width:44px;height:44px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--navy),var(--cyan));color:#fff;font-weight:800;font-size:1rem;display:flex;align-items:center;justify-content:center}
.fpost__meta{text-align:center}
.fpost__meta strong{font-size:.75rem;font-weight:600}
.fpost__meta span{font-size:.68rem;color:var(--muted)}
.fpost__body{flex:1;min-width:0}
.fpost__titlerow{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:.5rem;flex-wrap:wrap}
.fpost__title{font-size:1.1rem;font-weight:700;color:var(--text);line-height:1.3}
.fst{font-size:.7rem;font-weight:700;padding:.25rem .65rem;border-radius:100px;white-space:nowrap}
.fst--approved{background:#d1fae5;color:#065f46}
.fst--pending{background:#fef3c7;color:#92400e}
.fst--rejected{background:#fee2e2;color:#991b1b}
.fpost__txt{font-size:.875rem;color:var(--muted);line-height:1.6;margin-bottom:1rem}
.fpost__foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.75rem}
.fpost__stats{display:flex;gap:1rem;font-size:.78rem;color:var(--muted);flex-wrap:wrap}
.fpost__stats span{display:flex;align-items:center;gap:.3rem}
@media (max-width:900px){
    .fg-filter-row{flex-direction:column;align-items:stretch}
    .fg-filter-search,.fg-filter-select-wrap{min-width:100%}
    .fpost__content{flex-direction:column}
    .fpost__left{flex-direction:row;min-width:auto}
}
</style>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    filterForm.querySelectorAll('[data-auto-submit]').forEach(el => {
        let timeout;
        el.addEventListener('input', () => {
            clearTimeout(timeout);
            timeout = setTimeout(() => filterForm.submit(), 600);
        });
        el.addEventListener('change', () => filterForm.submit());
    });
});
</script>
{% endblock %}
