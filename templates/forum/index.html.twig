                            <a href="{{ path('forum_show', {id: post.id}) }}"
                               class="fg-btn fg-btn--blue fg-btn--sm">
                                <i class="fa fa-comments"></i> Voir la discussion
                            </a>
                            <button class="fg-btn fg-btn--danger fg-btn--sm"
                                    onclick="deletePost({{ post.id }})">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="fg-empty-state" id="forumEmpty">
            <i class="fa fa-comments"></i>
            <h3>Aucun sujet pour l'instant</h3>
            <p>Soyez le premier à lancer une discussion !</p>
            <button class="fg-btn fg-btn--orange" onclick="openModal('newPostModal')">Créer un sujet</button>
        </div>
        {% endfor %}
    </div>

    {# No results #}
    <div class="fg-empty-state" id="noResults" style="display:none">
        <i class="fa fa-search"></i>
        <h3>Aucun résultat trouvé</h3>
        <p>Essayez un autre mot-clé</p>
