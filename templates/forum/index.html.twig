{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('filterForm');
    const searchInput = filterForm.querySelector('[name="q"]');
    if (searchInput) {
        let timeout;
        searchInput.addEventListener('input', () => {
            clearTimeout(timeout);
            timeout = setTimeout(() => filterForm.submit(), 600);
        });
    }
});

function showIndexTranslation(postId) {
    const translatedEl = document.getElementById('translated-post-' + postId);
    const postEl = document.querySelector('[data-id="' + postId + '"]');
    const linkEl = postEl.querySelector('a');
    const titleEl = linkEl.querySelector('h3');
    const textEl = linkEl.querySelector('p');
    
    if (translatedEl.style.display === 'block') {
        translatedEl.style.display = 'none';
        return;
    }
    
    const originalText = textEl.innerText;
    const firstLine = originalText.split('\n')[0];
    
    translatedEl.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Traduction...';
    translatedEl.style.display = 'block';
    
    fetch('/api/forum/detect-language', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'text=' + encodeURIComponent(firstLine.slice(0, 100))
    })
    .then(r => r.json())
    .then(detectData => {
        const detectedLang = detectData.language || 'fr';
        const translateTo = detectedLang === 'fr' ? 'en' : 'fr';
        
        return fetch('/api/forum/post/' + postId + '/translate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'target=' + translateTo
        });
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            const langNames = {'en': 'English', 'ar': 'العربية', 'fr': 'Français'};
            translatedEl.innerHTML = '<strong>Traduction en ' + langNames[data.language] + ':</strong><br>' + 
                '<div style="margin-bottom:.25rem;font-weight:700">' + data.translated.title + '</div>' +
                (data.translated.content.length > 200 ? data.translated.content.slice(0,200) + '...' : data.translated.content);
        } else {
            translatedEl.innerHTML = 'Erreur de traduction';
        }
    })
    .catch(() => {
        translatedEl.innerHTML = 'Erreur de traduction';
    });
}
</script>
