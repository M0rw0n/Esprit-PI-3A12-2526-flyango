{% extends 'base/base.html.twig' %}
{% block title %}Forum des voyageurs — Fly&Go{% endblock %}
{% block body %}

{# Hero Section #}
<section class="circuit-hero" style="background:linear-gradient(135deg,rgba(27,58,107,0.9),rgba(0,180,216,0.8)),url('https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1920&q=80');background-size:cover;background-position:center;padding:3rem 0">
    <div class="container">
        <div style="display:flex;flex-direction:column;align-items:center;text-align:center;color:#fff">
            <h1 style="font-size:2.5rem;font-weight:800;margin-bottom:.5rem">Forum des voyageurs</h1>
            <p style="font-size:1.1rem;opacity:.9;margin-bottom:1.5rem">{{ posts.totalItemCount|default(posts|length) }} discussions — Posez vos questions et partagez vos expériences</p>
            
            <form method="GET" action="{{ path('forum_index') }}" id="filterForm" style="background:#fff;padding:.5rem;border-radius:50px;display:flex;align-items:center;gap:.5rem;width:100%;max-width:700px;box-shadow:0 4px 20px rgba(0,0,0,.15)">
                <div style="flex:1;display:flex;align-items:center;padding:0 1rem;border-right:1px solid #eee">
                    <i class="fa fa-search" style="color:var(--navy);margin-right:.75rem"></i>
                    <input type="text" name="q" value="{{ q }}" placeholder="Rechercher dans le forum..." 
                           style="border:none;outline:none;width:100%;font-size:.95rem;padding:.5rem 0"
                           onkeyup="if(event.key==='Enter'){document.getElementById('filterForm').submit()}">
                </div>
                <select name="categorie" style="border:none;outline:none;padding:.5rem;font-size:.95rem;color:#555;cursor:pointer;min-width:130px"
                        onchange="document.getElementById('filterForm').submit()">
                    <option value="">Toutes catégories</option>
                    <option value="Hébergement" {{ categorie=='Hébergement'?'selected':'' }}>Hébergement</option>
                    <option value="Circuit" {{ categorie=='Circuit'?'selected':'' }}>Circuit</option>
                    <option value="Activité" {{ categorie=='Activité'?'selected':'' }}>Activité</option>
                    <option value="Conseil" {{ categorie=='Conseil'?'selected':'' }}>Conseil</option>
                    <option value="Destination" {{ categorie=='Destination'?'selected':'' }}>Destination</option>
                    <option value="Transport" {{ categorie=='Transport'?'selected':'' }}>Transport</option>
                </select>
                <select name="tri" style="border:none;outline:none;padding:.5rem;font-size:.95rem;color:#555;cursor:pointer;min-width:130px"
                        onchange="document.getElementById('filterForm').submit()">
                    <option value="recent" {{ tri|default('recent')=='recent'?'selected':'' }}>Plus récents</option>
                    <option value="popular" {{ tri=='popular'?'selected':'' }}>Plus populaires</option>
                    <option value="discussed" {{ tri=='discussed'?'selected':'' }}>Plus commentés</option>
                    <option value="oldest" {{ tri=='oldest'?'selected':'' }}>Plus anciens</option>
                </select>
                <button type="submit" style="background:linear-gradient(135deg,var(--navy),var(--cyan));color:#fff;border:none;padding:.75rem 1.5rem;border-radius:50px;font-weight:600;cursor:pointer">
                    <i class="fa fa-search"></i>
                </button>
                {% if q or categorie %}
                <a href="{{ path('forum_index') }}" style="color:var(--muted);padding:.5rem;font-size:.85rem">
                    <i class="fa fa-times"></i>
                </a>
                {% endif %}
            </form>
            
            <div style="display:flex;gap:2rem;margin-top:1.5rem;opacity:.85">
                <span><i class="fa fa-comments"></i> {{ posts.totalItemCount|default(posts|length) }} Discussions</span>
                <span><i class="fa fa-users"></i> Membres actifs</span>
                <span><i class="fa fa-handshake"></i> Conseils partagés</span>
            </div>
        </div>
    </div>
</section>

{# Quick Actions #}
<div style="background:#fff;border-bottom:1px solid var(--border);padding:.75rem 0">
    <div class="container">
        <div style="display:flex;align-items:center;justify-content:space-between">
            <a href="{{ path('forum_new') }}" style="background:linear-gradient(135deg,var(--navy),var(--cyan));color:#fff;padding:.6rem 1.25rem;border-radius:25px;text-decoration:none;font-size:.9rem;font-weight:600;display:flex;align-items:center;gap:.5rem">
                <i class="fa fa-plus"></i> Nouveau sujet
            </a>
            <div style="color:var(--muted);font-size:.85rem">
                {% if q %}<span style="margin-right:1rem">🔍 "{{ q }}"</span>{% endif %}
                {% if categorie %}<span>📁 {{ categorie }}</span>{% endif %}
            </div>
        </div>
    </div>
</div>

{# Main Content #}
