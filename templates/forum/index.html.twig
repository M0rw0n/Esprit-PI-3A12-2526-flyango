// ══════════════════════════════════════
//  FORUM PAGE — AJAX + Filters
// ══════════════════════════════════════

let allPosts = Array.from(document.querySelectorAll('.fg-forum-card--full'));
let forumSearchTimer = null;

/* ── Live Search ── */
$('#forumSearch').on('input', function () {
    clearTimeout(forumSearchTimer);
    const q = $(this).val().trim();
    $('#forumSpinner').show();

    forumSearchTimer = setTimeout(() => {
        $.ajax({
            url: '{{ path("forum_search") }}',
            type: 'GET',
            data: { q: q },
            dataType: 'json',
            success: res => {
                if (res.success) renderForumResults(res.posts);
            },
            complete: () => $('#forumSpinner').hide()
        });
    }, 350);
});

function renderForumResults(posts) {
    const grid = document.getElementById('forumGrid');
    const noRes = document.getElementById('noResults');
    grid.innerHTML = '';

    if (!posts.length) {
        noRes.style.display = 'block';
        updateForumCount(0);
        return;
    }

    noRes.style.display = 'none';
    posts.forEach((p, i) => {
        grid.innerHTML += `
        <div class="fg-forum-card--full fg-anim-in" id="post-${p.id}"
             data-title="${esc(p.title)}" data-comments="${p.commentsCount}"
             style="animation-delay:${i*0.07}s">
            <div class="fg-forum-card--full__bar fg-forum-card--full__bar--approved"></div>
            <div class="fg-forum-card--full__content">
                <div class="fg-forum-card--full__left">
                    <div class="fg-forum-card--full__avatar">${esc(p.author)[0].toUpperCase()}</div>
                    <div class="fg-forum-card--full__meta"><strong>${esc(p.author)}</strong><span><i class="fa fa-clock"></i> ${p.createdAt}</span></div>
                </div>
                <div class="fg-forum-card--full__body">
                    <div class="fg-forum-card--full__title-row">
                        <h3 class="fg-forum-card--full__title">${esc(p.title)}</h3>
                    </div>
                    <p class="fg-forum-card--full__excerpt">${esc(p.content.slice(0,180))}${p.content.length>180?'…':''}</p>
                    <div class="fg-forum-card--full__footer">
                        <div class="fg-forum-card--full__stats">
                            <span><i class="fa fa-comments"></i> ${p.commentsCount} commentaire(s)</span>
                        </div>
                        <div class="fg-forum-card--full__actions">
                            <button class="fg-reaction-btn" onclick="reactPost(${p.id},'LIKE')">👍</button>
                            <button class="fg-reaction-btn" onclick="reactPost(${p.id},'LOVE')">❤️</button>
                            <a href="/forum/${p.id}" class="fg-btn fg-btn--blue fg-btn--sm"><i class="fa fa-comments"></i> Voir</a>
                            <button class="fg-btn fg-btn--danger fg-btn--sm" onclick="deletePost(${p.id})"><i class="fa fa-trash"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>`;
    });

    allPosts = Array.from(document.querySelectorAll('.fg-forum-card--full'));
    updateForumCount(posts.length);
}

/* ── Sort ── */
function sortForum() {
    const mode = document.getElementById('forumSort').value;
    const grid = document.getElementById('forumGrid');
    const cards = Array.from(grid.querySelectorAll('.fg-forum-card--full'));

    cards.sort((a, b) => {
        if (mode === 'popular')return parseInt(b.dataset.comments||0) - parseInt(a.dataset.comments||0);
        if (mode === 'alpha')  return (a.dataset.title||'').localeCompare(b.dataset.title||'');
        return (b.dataset.date||'').localeCompare(a.dataset.date||''); // recent
    });
    cards.forEach(c => grid.appendChild(c));
}

/* ── Submit new post ── */
function submitPost() {
    const author  = document.getElementById('postAuthor').value.trim();
    const title   = document.getElementById('postTitle').value.trim();
    const content = document.getElementById('postContent').value.trim();
    const errDiv  = document.getElementById('postErrors');
    errDiv.innerHTML = '';

    if (!author || !title || !content) {
        errDiv.innerHTML = '<p class="fg-form-error">Veuillez remplir tous les champs.</p>';
        return;
    }

    document.getElementById('submitPostLabel').innerHTML = 'Publication…';
    document.getElementById('submitPostSpinner').style.display = 'inline-block';
    document.getElementById('submitPostBtn').disabled = true;

    $.ajax({
        url: '{{ path("forum_add") }}',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ author, title, content }),
        dataType: 'json',
        success: res => {
            if (res.success) {
                const p = res.post;
                const grid = document.getElementById('forumGrid');
                document.getElementById('forumEmpty')?.remove();

                const card = `
                <div class="fg-forum-card--full fg-anim-in" id="post-${p.id}" data-title="${esc(p.title)}" data-comments="0">
                    <div class="fg-forum-card--full__bar fg-forum-card--full__bar--pending"></div>
                    <div class="fg-forum-card--full__content">
                        <div class="fg-forum-card--full__left">
                            <div class="fg-forum-card--full__avatar">${esc(p.author)[0].toUpperCase()}</div>
                            <div class="fg-forum-card--full__meta"><strong>${esc(p.author)}</strong><span>${p.createdAt}</span></div>
                        </div>
                        <div class="fg-forum-card--full__body">
                            <h3 class="fg-forum-card--full__title">${esc(p.title)}</h3>
                            <p class="fg-forum-card--full__excerpt">${esc(p.content.slice(0,180))}</p>
                            <div class="fg-forum-card--full__footer">
                                <span><i class="fa fa-comments"></i> 0 commentaire</span>
                                <div class="fg-forum-card--full__actions">
                                    <a href="/forum/${p.id}" class="fg-btn fg-btn--blue fg-btn--sm">Voir</a>
                                    <button class="fg-btn fg-btn--danger fg-btn--sm" onclick="deletePost(${p.id})"><i class="fa fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;

                grid.insertAdjacentHTML('afterbegin', card);
                updateForumCount(parseInt(document.getElementById('forumCount').textContent) + 1);
                closeModal('newPostModal');
                document.getElementById('postAuthor').value = '';
                document.getElementById('postTitle').value = '';
                document.getElementById('postContent').value = '';
                showToast('Sujet publié avec succès ! 🎉');
            }
        },
        error: xhr => {
            const r = xhr.responseJSON;
            errDiv.innerHTML = `<p class="fg-form-error">${r?.message || 'Erreur lors de la publication.'}</p>`;
        },
