}

/* ── Delete post ── */
function deletePost(id) {
    if (!confirm('Supprimer cette discussion ?')) return;
    const card = document.getElementById('post-' + id);
    card.style.opacity = '.4';
    $.ajax({
        url: '/forum/delete/' + id,
        type: 'DELETE',
        dataType: 'json',
        success: res => {
            if (res.success) {
                card.style.transition = 'all .3s ease';
                card.style.opacity = '0';
                card.style.maxHeight = '0';
                setTimeout(() => { card.remove(); updateForumCount(-1, true); }, 300);
                showToast('Discussion supprimée.');
            }
        },
        error: () => { card.style.opacity = '1'; showToast('Erreur lors de la suppression.', 'error'); }
    });
}

/* ── Reactions ── */
function reactPost(id, type) {
    $.ajax({
        url: '/forum/' + id + '/react',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ type }),
        dataType: 'json',
        success: () => showToast('Réaction ajoutée !')
    });
}

function updateForumCount(n, relative = false) {
    const el = document.getElementById('forumCount');
    const cur = parseInt(el.textContent) || 0;
    el.textContent = (relative ? cur + n : n) + ' discussion(s)';
}

function esc(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function openModal(id) { document.getElementById(id).classList.add('open'); document.body.style.overflow='hidden'; }
function closeModal(id) { document.getElementById(id).classList.remove('open'); document.body.style.overflow=''; }
document.querySelectorAll('.fg-modal-overlay').forEach(o => o.addEventListener('click', e => { if(e.target===o) closeModal(o.id); }));

$('#postContent').on('keydown', e => { if (e.ctrlKey && e.key==='Enter') submitPost(); });
