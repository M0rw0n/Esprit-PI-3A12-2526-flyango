{% extends 'base/base.html.twig' %}
{% block title %}Mes réservations — Fly&Go{% endblock %}
{% block body %}
<div style="max-width:1280px;margin:0 auto;padding:2rem">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem"><div><h1 style="font-size:1.8rem;font-weight:900">Mes Réservations</h1><p style="color:var(--muted)">Hébergements, activités et circuits rattachés à votre compte.</p></div><a href="{{ path('user_dashboard') }}" class="btn btn-outline">Mon espace</a></div>
    <div class="acard-wrap" style="margin-bottom:1.5rem"><div class="acard-wrap__head"><span class="acard-wrap__title">Hébergements</span></div><div class="bookings-list">{% for r in hebergementReservations %}<div class="booking-card"><div class="booking-card__av">H</div><div class="booking-card__info"><div class="booking-card__name">{{ r.hebergement.nom }}</div><div class="booking-card__meta"><span>{{ r.dateDebut|date('d/m/Y') }} → {{ r.dateFin|date('d/m/Y') }}</span><span>{{ r.nombrePersonnes }} pers.</span><span>{{ r.statut }}</span></div></div><div class="booking-card__price"><strong>{{ r.montantTotal|number_format(3, ',', ' ') }}</strong><span>TND</span></div><form action="{{ path('user_hebergement_cancel', {id: r.id}) }}" method="POST"><button class="btn btn-red btn-sm"><i class="fa fa-times"></i></button></form></div>{% else %}<div class="empty" style="padding:2rem"><i class="fa fa-hotel"></i><p>Aucune réservation hébergement.</p></div>{% endfor %}</div></div>
    <div class="acard-wrap" style="margin-bottom:1.5rem"><div class="acard-wrap__head"><span class="acard-wrap__title">Activités</span></div><div class="bookings-list">{% for r in activityReservations %}<div class="booking-card"><div class="booking-card__av">A</div><div class="booking-card__info"><div class="booking-card__name">{{ r.activity.title }}</div><div class="booking-card__meta"><span>{{ r.bookingDate|date('d/m/Y') }}</span><span>{{ r.persons }} pers.</span><span>{{ r.status }}</span></div></div><div class="booking-card__price"><strong>{{ r.totalPrice|number_format(3, ',', ' ') }}</strong><span>TND</span></div><form action="{{ path('user_activity_cancel', {id: r.id}) }}" method="POST"><button class="btn btn-red btn-sm"><i class="fa fa-times"></i></button></form></div>{% else %}<div class="empty" style="padding:2rem"><i class="fa fa-hiking"></i><p>Aucune réservation activité.</p></div>{% endfor %}</div></div>
    <div class="acard-wrap"><div class="acard-wrap__head"><span class="acard-wrap__title">Circuits</span></div><div class="bookings-list">{% for r in circuitReservations %}<div class="booking-card"><div class="booking-card__av">C</div><div class="booking-card__info"><div class="booking-card__name">{{ r.circuit.titre }}</div><div class="booking-card__meta"><span>{{ r.dateReservation|date('d/m/Y') }}</span><span>{{ r.nbPersonnes }} pers.</span><span>{{ r.statut }}</span></div></div><div class="booking-card__price"><strong>{{ r.montantTotal|number_format(3, ',', ' ') }}</strong><span>TND</span></div><form action="{{ path('user_circuit_cancel', {id: r.id}) }}" method="POST"><button class="btn btn-red btn-sm"><i class="fa fa-times"></i></button></form></div>{% else %}<div class="empty" style="padding:2rem"><i class="fa fa-route"></i><p>Aucune réservation circuit.</p></div>{% endfor %}</div></div>
</div>
{% endblock %}
