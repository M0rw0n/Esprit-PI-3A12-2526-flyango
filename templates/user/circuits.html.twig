{% extends 'base/base.html.twig' %}
{% block title %}Mes circuits — Fly&Go{% endblock %}
{% block body %}
<div style="max-width:1280px;margin:0 auto;padding:2rem">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem"><div><h1 style="font-size:1.8rem;font-weight:900">Mes Circuits Personnalisés</h1><p style="color:var(--muted)">Circuits sur mesure générés par l’IA depuis votre compte.</p></div><a href="{{ path('circuit_ai_create') }}" class="btn btn-gold">Nouveau circuit IA</a></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:1.5rem">
        {% for c in circuits %}
        <div class="ccard">
            <div class="ccard__body">
                <div style="display:flex;gap:.45rem;flex-wrap:wrap;margin-bottom:.6rem"><span class="tag tag--navy">Personnalisé</span><span class="tag" style="background:#eef2ff;color:#4338ca">IA</span></div>
                <h3 class="ccard__name">{{ c.titre }}</h3>
                <p class="ccard__loc"><i class="fa fa-map-marker-alt"></i> {{ c.depart }} → {{ c.destination }}</p>
                <div class="ccard__meta"><span><i class="fa fa-clock"></i> {{ c.duree }}</span><span><i class="fa fa-star"></i> {{ c.avis|length ? c.getMoyenneNotes() : 'N/A' }}</span></div>
                <p style="font-size:.82rem;color:var(--muted);margin:.75rem 0">{{ c.description|slice(0, 140) ~ '...' }}</p>
                <div class="ccard__foot"><a href="{{ path('circuit_show', {id: c.id}) }}" class="btn btn-outline btn-sm">Ouvrir</a><form action="{{ path('user_circuit_delete', {id: c.id}) }}" method="POST" onsubmit="return confirm('Supprimer ce circuit ?')"><button class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button></form></div>
            </div>
        </div>
        {% else %}
        <div class="empty" style="grid-column:1/-1;padding:4rem"><i class="fa fa-route"></i><p>Vous n’avez pas encore créé de circuit personnalisé.</p><a href="{{ path('circuit_ai_create') }}" class="btn btn-navy">Créer maintenant</a></div>
        {% endfor %}
    </div>
</div>
{% endblock %}
