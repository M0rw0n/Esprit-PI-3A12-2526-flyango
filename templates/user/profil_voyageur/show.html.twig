{% extends 'base/base.html.twig' %}

{% block title %}Mon Profil Voyageur — Fly&Go{% endblock %}

{% block body %}
<div style="max-width:700px;margin:0 auto;padding:2rem">
    <div class="section-header" style="margin-bottom:2rem">
        <a href="{{ path('user_dashboard') }}" class="btn btn-outline btn-sm" style="margin-bottom:1rem">
            <i class="fa fa-arrow-left"></i> Retour
        </a>
        <h1 style="font-size:1.8rem;font-weight:900;margin:0;display:flex;align-items:center;gap:.5rem">
            <i class="fa fa-suitcase-rolling" style="color:var(--cyan)"></i>
            Mon Profil Voyageur
        </h1>
    </div>

    {# Avatar & User Info #}
    <div class="profile-header-card">
        <div class="profile-avatar">
            <i class="{{ profil.typeVoyageIcon }}"></i>
        </div>
        <div class="profile-user-info">
            <h2>{{ profil.user.fullName }}</h2>
            <p>{{ profil.user.email }}</p>
            <span class="profile-badge">
                <i class="{{ profil.typeVoyageIcon }}"></i>
                {{ typeLabels[profil.typeVoyage] ?? profil.typeVoyage }}
            </span>
        </div>
    </div>

    {# Profile Details #}
    <div class="profile-details-card">
        <div class="profile-detail-row">
            <div class="profile-detail-icon">
                <i class="fa fa-map-marker-alt"></i>
            </div>
            <div class="profile-detail-content">
                <label>Destination preferee</label>
                <strong>{{ profil.destinationPreferee }}</strong>
            </div>
        </div>

        <div class="profile-detail-row">
            <div class="profile-detail-icon">
                <i class="fa fa-tag"></i>
            </div>
            <div class="profile-detail-content">
                <label>Type de voyage</label>
                <strong>{{ typeLabels[profil.typeVoyage] ?? profil.typeVoyage }}</strong>
            </div>
        </div>

        <div class="profile-detail-row">
            <div class="profile-detail-icon">
                <i class="fa fa-coins"></i>
            </div>
            <div class="profile-detail-content">
                <label>Budget moyen</label>
                <strong class="text-success">{{ profil.budget|number_format(2, ',', ' ') }} TND</strong>
            </div>
        </div>

        <div class="profile-detail-row profile-detail-row--muted">
            <div class="profile-detail-icon">
                <i class="fa fa-clock"></i>
            </div>
            <div class="profile-detail-content">
                <label>Derniere modification</label>
                <span>{{ profil.updatedAt|date('d/m/Y a H:i') }}</span>
            </div>
        </div>
    </div>

    {# Actions #}
    <div class="profile-actions">
        <a href="{{ path('user_profil_voyageur') }}" class="btn btn-navy btn-lg">
            <i class="fa fa-edit"></i> Modifier mon profil
        </a>
    </div>
</div>

<style>
.section-header { margin-bottom: 1.5rem; }
.profile-header-card {
    background: linear-gradient(135deg, var(--navy), var(--navy-dd));
    border-radius: var(--r);
    padding: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--s2);
}
.profile-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: #fff;
    flex-shrink: 0;
}
.profile-user-info { color: #fff; }
.profile-user-info h2 { margin: 0 0 0.25rem; font-weight: 800; }
.profile-user-info p { margin: 0 0 0.75rem; opacity: 0.8; font-size: 0.95rem; }
.profile-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255,255,255,0.2);
    padding: 0.4rem 0.8rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
}
.profile-details-card {
    background: var(--card);
    border-radius: var(--r);
    border: 1px solid var(--border);
    box-shadow: var(--s1);
    overflow: hidden;
    margin-bottom: 1.5rem;
}
.profile-detail-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
}
.profile-detail-row:last-child { border-bottom: none; }
.profile-detail-row:hover { background: var(--bg); }
.profile-detail-row--muted { background: var(--bg); }
.profile-detail-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--navy);
    flex-shrink: 0;
}
.profile-detail-row:hover .profile-detail-icon { background: #fff; }
.profile-detail-content { flex: 1; }
.profile-detail-content label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 0.25rem;
}
.profile-detail-content strong, .profile-detail-content span {
    font-size: 1.1rem;
    font-weight: 700;
}
.profile-detail-row--muted .profile-detail-content span {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--muted);
}
.profile-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
}
</style>
{% endblock %}
