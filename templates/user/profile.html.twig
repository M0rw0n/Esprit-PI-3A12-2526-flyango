{% block javascripts %}
<script>
function validateProfileForm() {
    const prenom = document.getElementById('prenom').value.trim();
    const nom = document.getElementById('nom').value.trim();
    const email = document.getElementById('email').value.trim();
    const namePattern = /^[A-Za-zÀ-ÿ\s\-]+$/;
    
    if (prenom.length < 2) {
        alert('Le prénom doit contenir au moins 2 caractères.');
        return false;
    }
    
    if (!namePattern.test(prenom)) {
        alert('Le prénom ne doit contenir que des lettres (pas de chiffres).');
        return false;
    }
    
    if (nom.length < 2) {
        alert('Le nom doit contenir au moins 2 caractères.');
        return false;
    }
    
    if (!namePattern.test(nom)) {
        alert('Le nom ne doit contenir que des lettres (pas de chiffres).');
        return false;
    }
    
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        alert('Veuillez entrer une adresse email valide.');
        return false;
    }
    
    return true;
}

document.addEventListener('DOMContentLoaded', function() {
    const inputs = document.querySelectorAll('input[pattern]');
    inputs.forEach(input => {
        input.addEventListener('blur', function() {
            if (this.value && !new RegExp('^' + this.pattern + '$').test(this.value)) {
                this.style.borderColor = '#ef4444';
            } else if (this.value) {
                this.style.borderColor = '#10b981';
            }
        });
    });
});
</script>
