<div class="history-card" data-type="{{ item.type }}" data-id="{{ item.id }}" data-entity="{{ item.entity }}" data-entity-id="{{ item.entityId }}" data-deletable="{{ item.entity starts with 'favorite_' ? 'true' : 'false' }}">
    <label class="card-checkbox">
        <input type="checkbox" onchange="toggleCardSelection(this)" {{ item.entity starts with 'favorite_' ? '' : 'disabled' }}>
    </label>
    <div class="card-icon {{ item.type }}">
        {% if item.type starts with 'hebergement' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 7v14M21 7v14M6 11h4M6 15h4M14 11h4M14 15h4M6 7V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v3"/></svg>
        {% elseif item.type starts with 'activity' or item.type == 'booking' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        {% elseif item.type starts with 'circuit' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17h18M3 11h18M3 5h18"/><circle cx="7" cy="17" r="2"/><circle cx="12" cy="11" r="2"/><circle cx="17" cy="5" r="2"/></svg>
        {% elseif item.type starts with 'favorite' %}
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        {% elseif item.type starts with 'review' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
        {% endif %}
    </div>
    <div class="card-content">
        <a href="{{ item.link }}" class="card-title">{{ item.title }}</a>
        <div class="card-meta">
            <span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 6v6l4 2"/>
                </svg>
                {{ item.date|date('H:i') }}
            </span>
            {% if item.status is defined and item.status %}
                {% if item.status == 'confirmed' or item.status == 'confirmee' %}
                    <span class="status-badge confirmed">Confirmée</span>
                {% elseif item.status == 'pending' or item.status == 'en_attente' %}
                    <span class="status-badge pending">En attente</span>
                {% elseif item.status == 'cancelled' or item.status == 'annulee' %}
                    <span class="status-badge cancelled">Annulée</span>
                {% elseif item.status == 'favorite' %}
                    <span class="status-badge favorite">Favori</span>
                {% elseif item.status == 'published' %}
                    <span class="status-badge published">Publié</span>
                {% else %}
                    <span>{{ item.status|title }}</span>
                {% endif %}
            {% endif %}
        </div>
    </div>
    {% if item.amount is defined and item.amount %}
        <span class="card-amount">{{ item.amount|number_format(3) }} TND</span>
    {% endif %}
    <div class="card-actions">
        <a href="{{ item.link }}" class="icon-action-btn" title="Ouvrir">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
        </a>
        {% if item.entity starts with 'favorite_' %}
        <button class="icon-action-btn delete-btn" title="Supprimer" onclick="deleteSingleItem('{{ item.entity }}', {{ item.entityId }}, this)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
        </button>
        {% endif %}
    </div>
</div>
