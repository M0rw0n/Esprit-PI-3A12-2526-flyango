{% extends 'base/base.html.twig' %}
{% block title %}Mes avis — Fly&Go{% endblock %}
{% block body %}
<div style="max-width:1280px;margin:0 auto;padding:2rem">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem"><div><h1 style="font-size:1.8rem;font-weight:900">Mes Avis</h1><p style="color:var(--muted)">Tous vos avis publiés par module.</p></div><a href="{{ path('user_dashboard') }}" class="btn btn-outline">Mon espace</a></div>
    <div class="admin-grid">
        <div class="acard-wrap"><div class="acard-wrap__head"><span class="acard-wrap__title">Hébergements</span></div><div class="bookings-list">{% for a in hebergementAvis %}<div class="booking-card"><div class="booking-card__av">★</div><div class="booking-card__info"><div class="booking-card__name">{{ a.hebergement.nom }}</div><div class="booking-card__meta"><span>{{ a.note }}/5</span><span>{{ a.createdAt|date('d/m/Y') }}</span></div><div style="font-size:.82rem;color:var(--muted)">{{ a.commentaire }}</div></div><form action="{{ path('user_hebergement_avis_delete', {id: a.id}) }}" method="POST"><button class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button></form></div>{% else %}<div class="empty" style="padding:2rem"><i class="fa fa-star"></i><p>Aucun avis hébergement.</p></div>{% endfor %}</div></div>
        <div class="acard-wrap"><div class="acard-wrap__head"><span class="acard-wrap__title">Activités</span></div><div class="bookings-list">{% for a in activityAvis %}<div class="booking-card"><div class="booking-card__av">★</div><div class="booking-card__info"><div class="booking-card__name">{{ a.activity.title }}</div><div class="booking-card__meta"><span>{{ a.rating }}/5</span><span>{{ a.createdAt|date('d/m/Y') }}</span></div><div style="font-size:.82rem;color:var(--muted)">{{ a.comment }}</div></div><form action="{{ path('user_activity_avis_delete', {id: a.id}) }}" method="POST"><button class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button></form></div>{% else %}<div class="empty" style="padding:2rem"><i class="fa fa-star"></i><p>Aucun avis activité.</p></div>{% endfor %}</div></div>
    </div>
    <div class="acard-wrap" style="margin-top:1.5rem"><div class="acard-wrap__head"><span class="acard-wrap__title">Circuits</span></div><div class="bookings-list">{% for a in circuitAvis %}<div class="booking-card"><div class="booking-card__av">★</div><div class="booking-card__info"><div class="booking-card__name">{{ a.circuit.titre }}</div><div class="booking-card__meta"><span>{{ a.rating }}/5</span><span>{{ a.createdAt|date('d/m/Y') }}</span></div><div style="font-size:.82rem;color:var(--muted)">{{ a.comment }}</div></div><form action="{{ path('user_circuit_avis_delete', {id: a.id}) }}" method="POST"><button class="btn btn-red btn-sm"><i class="fa fa-trash"></i></button></form></div>{% else %}<div class="empty" style="padding:2rem"><i class="fa fa-star"></i><p>Aucun avis circuit.</p></div>{% endfor %}</div></div>
</div>
{% endblock %}
