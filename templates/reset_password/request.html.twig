<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mot de passe oublié — Fly&Go</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <style>
        body { 
            background: 
                linear-gradient(135deg, rgba(27,58,107,0.85) 0%, rgba(27,58,107,0.75) 100%),
                url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1920&q=80') center/cover no-repeat fixed;
            min-height: 100vh; 
            font-family: 'Outfit', sans-serif; 
            position: relative;
        }
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(ellipse at 30% 70%, rgba(0,180,216,0.25) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 30%, rgba(255,183,0,0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(27,58,107,0.4) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; position: relative; z-index: 1; }
        .auth-card { background: rgba(255,255,255,0.97); backdrop-filter: blur(20px); border-radius: 24px; box-shadow: 0 25px 80px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.15); width: 100%; max-width: 460px; overflow: hidden; position: relative; animation: fadeInUp 0.6s ease; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        .auth-card__head { background: linear-gradient(135deg, #1B3A6B 0%, #1B3A6B 50%, #0d2847 100%); padding: 2.5rem 2rem 2rem; text-align: center; color: white; position: relative; overflow: hidden; }
        .auth-card__head::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #00B4D8 0%, #FFB700 50%, #00B4D8 100%);
        }
        .auth-logo { margin-bottom: 1rem; position: relative; display: flex; justify-content: center; }
        .auth-logo img { height: 70px; width: 220px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3)); }
        .auth-card__head h1 { font-size: 1.4rem; font-weight: 600; margin: 0.5rem 0 0; }
        .auth-card__head p { font-size: 0.85rem; opacity: 0.8; margin: 0.5rem 0 0; }
        .auth-card__body { padding: 2rem; }
        .err { background: #fee2e2; border: 1px solid #fca5a5; border-radius: 12px; padding: 0.875rem 1rem; color: #991b1b; font-size: 0.875rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
        .success-msg { background: #d1fae5; border: 1px solid #6ee7b7; border-radius: 12px; padding: 0.875rem 1rem; color: #065f46; font-size: 0.875rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
        .fg-group { margin-bottom: 1.25rem; }
        .fg-label { display: block; font-size: 0.82rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem; }
        .fg-input { width: 100%; padding: 0.875rem 1rem; border: 2px solid #e5e7eb; border-radius: 12px; font-size: 0.95rem; font-family: inherit; transition: all 0.3s ease; background: #f9fafb; box-sizing: border-box; }
        .fg-input:focus { outline: none; border-color: #00B4D8; background: white; box-shadow: 0 0 0 4px rgba(0,180,216,0.1); }
        .btn-navy { background: linear-gradient(135deg, #1B3A6B, #2a4a7f); color: white; border: none; padding: 1rem 1.5rem; border-radius: 12px; font-size: 1rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.3s ease; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
        .btn-navy:hover { background: linear-gradient(135deg, #2a4a7f, #1B3A6B); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(27,58,107,0.4); }
        .auth-links { text-align: center; margin-top: 1.5rem; }
        .auth-links a { color: #1B3A6B; text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.5rem; }
        .auth-links a:hover { color: #FFB700; }
    </style>
</head>
<body>
<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-card__head">
            <div class="auth-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Fly&Go">
            </div>
            <h1>Mot de passe oublié</h1>
            <p>Entrez votre email pour recevoir un lien de réinitialisation</p>
        </div>
        <div class="auth-card__body">
            {% for message in app.flashes('error') %}
            <div class="err">
                <i class="fas fa-exclamation-circle"></i>
                {{ message }}
            </div>
            {% endfor %}
            {% for message in app.flashes('success') %}
            <div class="success-msg">
                <i class="fas fa-check-circle"></i>
                {{ message }}
            </div>
            {% endfor %}
            {% for message in app.flashes('info') %}
            <div class="success-msg">
                <i class="fas fa-info-circle"></i>
                {{ message }}
            </div>
            {% endfor %}

            <form method="post" action="{{ path('app_forgot_password_request') }}">
                <div class="fg-group">
                    <label class="fg-label">Adresse email</label>
                    <input type="email" id="email" name="email" required autofocus
                           class="fg-input" placeholder="vous@exemple.com">
                </div>

                <button type="submit" class="btn-navy">
                    <i class="fas fa-paper-plane"></i>
                    Envoyer le lien de réinitialisation
                </button>
            </form>

            <div class="auth-links">
                <a href="{{ path('app_login') }}">
                    <i class="fas fa-arrow-left"></i>
                    Retour à la connexion
                </a>
            </div>
        </div>
    </div>
</div>
</body>
</html>