{% block body %}
<div style="max-width:1380px;margin:0 auto;padding:2rem">
    <div style="font-size:.82rem;color:var(--muted);margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem">
        <a href="{{ path('home') }}" style="color:var(--muted)">Accueil</a>
