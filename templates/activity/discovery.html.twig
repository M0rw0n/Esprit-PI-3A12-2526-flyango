{% extends 'base/base.html.twig' %}

{% block title %}Découverte Réelle — Fly&Go{% endblock %}

{% block body %}
<style>
    .discovery-hero {
        background: linear-gradient(135deg, var(--navy) 0%, #2d5a9e 100%);
        padding: 4rem 2rem;
        color: #fff;
        border-radius: 0 0 40px 40px;
        margin-bottom: 3rem;
        text-align: center;
    }
    .search-box {
        background: #fff;
        padding: 1.5rem;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        display: inline-flex;
        gap: 1rem;
        margin-top: 2rem;
        width: 100%;
        max-width: 800px;
    }
    .discovery-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--border);
        transition: all 0.3s ease;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    .discovery-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.1);
    }
    .card-img {
        height: 200px;
        width: 100%;
        object-fit: cover;
    }
    .card-content {
        padding: 1.5rem;
    }
    .category-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
        display: inline-block;
    }
    .badge-restaurant { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .badge-culture { background: rgba(16, 185, 129, 0.1); color: #10b981; }
    .badge-sport { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
    
    .rating-stars { color: #f59e0b; font-size: 0.9rem; }
    .price-level { color: var(--muted); font-weight: 600; margin-left: 0.5rem; }
    
    .section-title {
        font-weight: 800;
        color: var(--navy);
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .city-info-banner {
        background: var(--bg);
        padding: 1.5rem 2rem;
        border-radius: 16px;
        margin-bottom: 3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-left: 6px solid var(--gold);
    }
</style>

<div class="discovery-hero">
    <h1 style="font-weight: 900; font-size: 3rem; margin-bottom: 1rem;">🔍 Découverte Réelle</h1>
    <p style="font-size: 1.2rem; opacity: 0.9;">Explorez les meilleurs lieux, cultures et sports en temps réel</p>
    
    <form class="search-box" action="{{ path('activity_discovery') }}" method="GET">
        <div style="flex: 2; position: relative;">
            <i class="fa fa-map-marker-alt" style="position: absolute; left: 1.25rem; top: 1.1rem; color: var(--muted);"></i>
            <input type="text" name="lieu" value="{{ lieu }}" class="fg-input" style="padding-left: 3rem;" placeholder="Ville (ex: Sfax, Tunis...)">
        </div>
        <div style="flex: 1;">
            <select name="type" class="fg-input">
                <option value="all" {{ type == 'all' ? 'selected' : '' }}>Toutes catégories</option>
                <option value="restaurants" {{ type == 'restaurants' ? 'selected' : '' }}>🍽️ Restaurants</option>
                <option value="culture" {{ type == 'culture' ? 'selected' : '' }}>🏛️ Culture</option>
                <option value="sports" {{ type == 'sports' ? 'selected' : '' }}>⚽ Sports</option>
            </select>
        </div>
        <button type="submit" class="btn btn-navy" style="padding: 0 2rem;">Explorer</button>
    </form>
</div>

<div style="max-width: 1300px; margin: 0 auto; padding: 0 2rem 5rem;">
    {% if results.city_info and results.city_info.name is defined %}
    <div class="city-info-banner">
        <div>
            <h2 style="margin: 0; font-weight: 800; color: var(--navy);">{{ results.city_info.name|default(lieu) }}</h2>
            <p style="margin: 0.25rem 0 0; color: var(--muted); font-size: 0.9rem;">
                {% if results.city_info.description is defined and results.city_info.description %}
                    {{ results.city_info.description|slice(0, 200) }}...
                {% else %}
                    {{ lieu }}, Tunisie - Découvez cette ville
                {% endif %}
            </p>
        </div>
        {% if results.city_info.image_url is defined and results.city_info.image_url %}
        <div style="width: 120px; height: 80px; border-radius: 12px; overflow: hidden;">
            <img src="{{ results.city_info.image_url }}" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        {% endif %}
    </div>
    {% endif %}

    {# ATTRACTIONS SECTION #}
    {% if results.attractions %}
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
        <h3 class="section-title" style="margin-bottom: 0;"><i class="fa fa-landmark" style="color: #10b981;"></i>🏛️ Culture & Patrimoine</h3>
        <span style="background: var(--bg); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; color: var(--navy);">{{ results.attractions|length }} lieux trouvés</span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
        {% for place in results.attractions %}
        <div class="discovery-card">
            <img src="{{ place.image_url|default('https://images.unsplash.com/photo-1564501049412-61c2a3083791?w=500') }}" class="card-img" style="height: 200px;">
            <div class="card-content">
                <span class="category-badge badge-culture">Attraction</span>
                <h4 style="margin: 0 0 0.5rem; font-weight: 700; color: var(--navy);">
                    {% if place.title is defined %}{{ place.title }}{% elseif place.name is defined %}{{ place.name }}{% else %}Lieu{% endif %}
                </h4>
                <p style="font-size: 0.85rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                    {{ place.snippet|default('')|striptags }}
                </p>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

{# RESTAURANTS SECTION #}
    {% if results.restaurants %}
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
        <h3 class="section-title" style="margin-bottom: 0;"><i class="fa fa-utensils" style="color: #ef4444;"></i>🍽️ Restaurants & Gastronomie</h3>
        <span style="background: var(--bg); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; color: var(--navy);">{{ results.restaurants|length }} lieux trouvés</span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
        {% for biz in results.restaurants %}
        <div class="discovery-card">
            <img src="{{ biz.image_url|default('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=500') }}" class="card-img">
            <div class="card-content">
                <span class="category-badge badge-restaurant">Restaurant</span>
                <h4 style="margin: 0 0 0.5rem; font-weight: 700; color: var(--navy);">
                    {% if biz.title is defined %}{{ biz.title }}{% elseif biz.name is defined %}{{ biz.name }}{% else %}Restaurant{% endif %}
                </h4>
                <p style="font-size: 0.85rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    {{ biz.snippet|default('')|striptags }}
                </p>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# HOTELS SECTION #}
    {% if results.hotels %}
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
        <h3 class="section-title" style="margin-bottom: 0;"><i class="fa fa-hotel" style="color: #8b5cf6;"></i>🏨 Hébergement</h3>
        <span style="background: var(--bg); padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; color: var(--navy);">{{ results.hotels|length }} hôtels</span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">
        {% for hotel in results.hotels %}
        <div class="discovery-card">
            <img src="{{ hotel.image_url|default('https://images.unsplash.com/photo-1566073771259-6a8506099945?w=500') }}" class="card-img" style="height: 180px;">
            <div class="card-content">
                <span class="category-badge" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">Hôtel</span>
                <h4 style="margin: 0 0 1rem; font-weight: 700; color: var(--navy);">
                    {% if hotel.title is defined %}{{ hotel.title }}{% elseif hotel.name is defined %}{{ hotel.name }}{% else %}Hôtel{% endif %}
                </h4>
                <p style="font-size: 0.8rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    {{ hotel.snippet|default('')|striptags }}
                </p>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
    
    {% if not results.restaurants and not results.attractions and not results.hotels %}
    <div style="text-align: center; padding: 5rem 0;">
        <i class="fa fa-search" style="font-size: 4rem; color: var(--border); margin-bottom: 1.5rem;"></i>
        <h3 style="color: var(--muted);">Aucun résultat trouvé pour "{{ lieu }}"</h3>
        <p>Essayez une autre ville ou vérifiez l'orthographe.</p>
    </div>
    {% endif %}
</div>
{% endblock %}
