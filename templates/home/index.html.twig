{% block title %}Fly&Go — Explorez la Tunisie et le Monde{% endblock %}

{% block body %}

{# ══════════ HERO ══════════ #}
<section class="fg-hero">
    <div class="fg-hero__bg">
        <div class="fg-hero__slide fg-hero__slide--1 active"></div>
        <div class="fg-hero__slide fg-hero__slide--2"></div>
        <div class="fg-hero__slide fg-hero__slide--3"></div>
    </div>
    <div class="fg-hero__overlay"></div>
    <div class="fg-hero__particles"></div>

    <div class="fg-hero__content">
        <div class="fg-hero__eyebrow">
            <span>✈</span> Agence de voyage certifiée — Tunisie &amp; Monde
        </div>
        <h1 class="fg-hero__title">
            Explorez la Tunisie<br>avec <em>Fly&amp;Go</em>
        </h1>
        <p class="fg-hero__subtitle">
            Des expériences authentiques, des destinations paradisiaques,<br>
            des souvenirs qui durent toute une vie.
        </p>

        <div class="fg-hero__search">
            <div class="fg-hero__search-field">
                <i class="fa fa-map-marker-alt"></i>
                <input type="text" id="heroSearchDest" placeholder="Destination (Djerba, Sahara…)">
            </div>
            <div class="fg-hero__search-field">
                <i class="fa fa-calendar"></i>
                <input type="date" id="heroSearchDate" min="{{ 'now'|date('Y-m-d') }}">
            </div>
            <div class="fg-hero__search-field">
                <i class="fa fa-users"></i>
                <select id="heroSearchPersons">
                    <option value="1">1 personne</option>
                    <option value="2" selected>2 personnes</option>
                    <option value="3">3 personnes</option>
                    <option value="4">4+ personnes</option>
                </select>
            </div>
            <a href="{{ path('activity_index') }}" class="fg-btn fg-btn--orange fg-btn--lg" id="heroSearchBtn">
                <i class="fa fa-search"></i> Rechercher
            </a>
        </div>

        <div class="fg-hero__stats">
            <div class="fg-hero__stat">
                <strong><span data-target="500" data-suffix="+">0+</span></strong>
                <span>Activités disponibles</span>
            </div>
            <div class="fg-hero__stat-sep"></div>
            <div class="fg-hero__stat">
                <strong><span data-target="50000" data-suffix="+">0+</span></strong>
                <span>Voyageurs satisfaits</span>
            </div>
            <div class="fg-hero__stat-sep"></div>
            <div class="fg-hero__stat">
                <strong>4.9★</strong>
                <span>Note moyenne</span>
            </div>
            <div class="fg-hero__stat-sep"></div>
            <div class="fg-hero__stat">
                <strong><span data-target="7" data-suffix=" dest.">0 dest.</span></strong>
                <span>En Tunisie</span>
            </div>
        </div>
    </div>

    <div class="fg-hero__dots">
        <button class="fg-hero__dot active" onclick="goSlide(0)"></button>
        <button class="fg-hero__dot" onclick="goSlide(1)"></button>
        <button class="fg-hero__dot" onclick="goSlide(2)"></button>
    </div>
    <a href="#activities-section" class="fg-hero__scroll"><i class="fa fa-chevron-down"></i></a>
</section>

{# ══════════ CATEGORIES ══════════ #}
<section class="fg-band">
    <div class="fg-band__inner">
        <div class="fg-band__item active"><i class="fa fa-star"></i><span>Tout voir</span></div>
        <div class="fg-band__item"><i class="fa fa-mountain"></i><span>Aventure</span></div>
        <div class="fg-band__item"><i class="fa fa-umbrella-beach"></i><span>Plages</span></div>
        <div class="fg-band__item"><i class="fa fa-landmark"></i><span>Culture</span></div>
        <div class="fg-band__item"><i class="fa fa-spa"></i><span>Bien-être</span></div>
        <div class="fg-band__item"><i class="fa fa-utensils"></i><span>Gastronomie</span></div>
        <div class="fg-band__item"><i class="fa fa-camera"></i><span>Photo</span></div>
        <div class="fg-band__item"><i class="fa fa-horse"></i><span>Équitation</span></div>
    </div>
</section>

{# ══════════ ACTIVITIES ══════════ #}
<section class="fg-section" id="activities-section">
    <div class="fg-section__inner">
        <div class="fg-section__header">
            <div>
                <p class="fg-section__eyebrow">Nos Activités</p>
                <h2 class="fg-section__title">Expériences <em>Recommandées</em></h2>
            </div>
            <a href="{{ path('activity_index') }}" class="fg-btn fg-btn--ghost">
                Voir tout <i class="fa fa-arrow-right"></i>
            </a>
        </div>

        <div class="fg-cards-grid">
            {% for activity in activities %}
            <div class="fg-card fg-card--activity" data-id="{{ activity.id }}" data-price="{{ activity.price }}">
                <div class="fg-card__image">
                    {% if activity.image %}
                        <img src="{{ asset(activity.image) }}" alt="{{ activity.title }}"
                             onerror="this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=500&q=80'">
                    {% else %}
                        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=500&q=80" alt="{{ activity.title }}">
                    {% endif %}
                    {% if loop.index <= 2 %}
                        <span class="fg-card__badge">🔥 Populaire</span>
                    {% elseif activity.price < 50 %}
                        <span class="fg-card__badge fg-card__badge--deal">💰 Bon plan</span>
                    {% endif %}
                    <button class="fg-card__wishlist"
                            onclick="toggleWishlistItem({{ activity.id }}, '{{ activity.title|e('js') }}', {{ activity.price }}, '{{ activity.image|e('js') }}')">
                        <i class="fa fa-heart"></i>
                    </button>
                    {% if activity.date %}
                    <span class="fg-card__date-badge"><i class="fa fa-calendar"></i> {{ activity.date|date('d/m/Y') }}</span>
                    {% endif %}
                </div>
                <div class="fg-card__body">
                    {% if activity.place %}
                        <span class="fg-card__location"><i class="fa fa-map-marker-alt"></i> {{ activity.place.name }}</span>
                    {% endif %}
                    <h3 class="fg-card__title">{{ activity.title }}</h3>
                    <p class="fg-card__desc">{{ activity.description|length > 85 ? activity.description|slice(0,85) ~ '…' : activity.description }}</p>
                    <div class="fg-card__meta">
                        {% if activity.duration %}<span><i class="fa fa-clock"></i> {{ activity.duration }}</span>{% endif %}
                        {% if activity.capacity %}<span><i class="fa fa-users"></i> {{ activity.capacity }} places</span>{% endif %}
                    </div>
                    <div class="fg-card__rating">
                        <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                        <i class="fa fa-star"></i><i class="fa fa-star-half-alt"></i>
                        <span>(4.5)</span>
                    </div>
                    <div class="fg-card__footer">
                        <div class="fg-card__price">
                            <span class="fg-card__price-amount">{{ activity.price }} DT</span>
                            <span class="fg-card__price-label">/pers.</span>
                        </div>
                        <div class="fg-card__actions">
                            <a href="{{ path('activity_show', {id: activity.id}) }}" class="fg-btn fg-btn--blue fg-btn--sm">Détails</a>
                            <a href="{{ path('activity_show', {id: activity.id}) }}" class="fg-btn fg-btn--orange fg-btn--sm">
                                Réserver <i class="fa fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
