{% for type, messages in app.flashes %}
    {% for msg in messages %}
    <div style="position:fixed;top:80px;right:1.5rem;z-index:2000;max-width:420px">
        <div class="toast toast--{{ type == 'success' ? 'success' : (type == 'error' ? 'error' : 'info') }}" style="display:flex;pointer-events:auto">
            {{ type == 'success' ? '✅' : (type == 'error' ? '❌' : 'ℹ️') }} {{ msg }}
        </div>
    </div>
    {% endfor %}
{% endfor %}

